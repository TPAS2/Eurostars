# Copy to .env (or set these in your hosting provider's environment settings).

# --- Required ---
# The ONLY account that gets the admin panel. Nobody can register with this email.
ADMIN_EMAIL=you@yourcompany.co.uk
# Used once, on first start, to create the admin account (min 10 characters).
ADMIN_PASSWORD=change-me-to-something-long

# --- AI monthly statements (optional) ---
# Without a key, statements still generate with a standard written summary.
ANTHROPIC_API_KEY=

# --- Server ---
PORT=3000
NODE_ENV=production
APP_NAME=LetWise
# Set to true when running behind a reverse proxy / load balancer (Render, Railway, nginx...).
TRUST_PROXY=false
# Set to false to close public sign-ups.
ALLOW_REGISTRATION=true

# --- Storage (defaults live under ./data) ---
# DATABASE_FILE=./data/letwise.db
# UPLOAD_DIR=./data/uploads

# --- Backups ---
# BACKUP_DIR=./data/backups
# A second copy of every backup, e.g. a mounted network drive or cloud-synced folder.
# BACKUP_COPY_DIR=/mnt/offsite/letwise
BACKUP_INTERVAL_HOURS=24
BACKUP_KEEP=14
AUTO_BACKUPS=true

# Generate last month's landlord statements automatically.
AUTO_MONTHLY_STATEMENTS=true
