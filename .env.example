# Copy to .env (or set these in your hosting provider's environment settings).

# --- Required ---
# The ONLY account that gets the admin panel.
ADMIN_USERNAME=TPAS2
# The admin's "Your name" when signing in (capitals count).
ADMIN_LOGIN_NAME=Theo
# Used on first start to create the admin account (min 6 characters; 10+ recommended).
ADMIN_PASSWORD=change-me
# Forgot the admin password? Set a new ADMIN_PASSWORD plus ADMIN_PASSWORD_RESET=true,
# restart once, then remove ADMIN_PASSWORD_RESET.
ADMIN_PASSWORD_RESET=false
# Optional contact email for the admin account (sign-in is by username only).
ADMIN_EMAIL=

# --- AI monthly statements (optional) ---
# Without a key, statements still generate with a standard written summary.
ANTHROPIC_API_KEY=

# --- Email (Rent run: statements to landlords and the CSV report) ---
# The sending address, e.g. statements@youragency.co.uk. Emails show your agency's name
# as the sender, and replies go to the agency's email address.
EMAIL_FROM=
# Either Resend (https://resend.com; verify your domain there)...
RESEND_API_KEY=
# ...or any SMTP server (Microsoft 365, Google Workspace, Mailgun, SendGrid...).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# --- Server ---
PORT=3000
NODE_ENV=production
APP_NAME=Nexus
# Set to true when running behind a reverse proxy / load balancer (Render, Railway, nginx...).
TRUST_PROXY=false
# Public sign-up is off: only the admin adds accounts. Set to true to let anyone sign up.
ALLOW_REGISTRATION=false

# Sign people out after this many minutes without using the site (0 = never).
# Anything typed is saved or kept on the device first.
IDLE_TIMEOUT_MINUTES=60

# --- Storage (defaults live under ./data) ---
# DATABASE_FILE=./data/nexus.db
# UPLOAD_DIR=./data/uploads

# --- Backups ---
# Encrypts every backup (AES-256). Keep it safe: without it, backups can't be restored.
BACKUP_PASSWORD=
# BACKUP_DIR=./data/backups
# A second copy of every backup, e.g. a mounted network drive or cloud-synced folder.
# BACKUP_COPY_DIR=/mnt/offsite/nexus
BACKUP_INTERVAL_HOURS=24
BACKUP_KEEP=14
AUTO_BACKUPS=true

# Generate last month's landlord statements automatically.
AUTO_MONTHLY_STATEMENTS=true
