<%- include('partials/header') %>
<header class="page-head">
  <div>
    <a class="crumb" href="<%= def.key === 'tenancies' ? (row ? `/app/tenancies/${row.id}` : '/app/tenants') : `/app/${def.key}` %>">← <%= def.key === 'tenancies' ? (row ? 'Tenancy' : 'Tenants') : def.plural %></a>
    <h1><%= title %></h1>
  </div>
</header>
<section class="card">
  <% if (Object.keys(errors).length) { %><div class="notice err">Please fix the highlighted fields.</div><% } %>
  <form method="post" action="/app/<%= def.key %><%= row ? '/' + row.id : '' %>" class="form-grid"<%- (def.files || def.key === 'properties') && !row ? ' enctype="multipart/form-data"' : '' %>
        <%- row ? 'data-autosave' : `data-draft="new-${def.key}" autocomplete="off"` %>>
    <%- include('partials/csrf') %>
    <% def.fields.forEach(f => { %>
      <%- include('partials/field', { f, value: values[f.name], error: errors[f.name], opts: options[f.name] }) %>
      <% if (typeof tenantCouncil !== 'undefined' && tenantCouncil && f.name === 'phone') { %>
      <div class="field">
        <label for="f-tenant_council_id">Council</label>
        <select id="f-tenant_council_id" name="tenant_council_id">
          <option value="">— None —</option>
          <% tenantCouncil.options.forEach(o => { %><option value="<%= o.id %>" <%= Number(tenantCouncil.council_id) === o.id ? 'selected' : '' %>><%= o.label %></option><% }) %>
        </select>
        <div class="help">The council for <%= tenantCouncil.address_line1 %>, the property they rent. Changing it updates the property.</div>
        <% if (errors.tenant_council_id) { %><div class="field-err"><%= errors.tenant_council_id %></div><% } %>
      </div>
      <% } %>
    <% }) %>
    <% if (def.key === 'properties' && !row) { %>
    <div class="wide new-certs">
      <h3 class="form-subhead">Certificates</h3>
      <p class="muted small">Optional. Fill in any you have and upload the certificate (PDF or photo, up to 25 MB); more can be added on the property's page.</p>
      <% if (errors.cert_upload) { %><div class="field-err"><%= errors.cert_upload %></div><% } %>
      <% ['Gas Safety (CP12)', 'EICR', 'EPC', 'Insurance'].forEach((type, i) => { %>
      <div class="cert-row">
        <strong><%= type %></strong>
        <div class="field"><label for="c-<%= i %>-i">Issued</label><input id="c-<%= i %>-i" type="date" name="cert_<%= i %>_issued" value="<%= values[`cert_${i}_issued`] || '' %>"><% if (errors[`cert_${i}_issued`]) { %><div class="field-err"><%= errors[`cert_${i}_issued`] %></div><% } %></div>
        <div class="field"><label for="c-<%= i %>-e">Expires</label><input id="c-<%= i %>-e" type="date" name="cert_<%= i %>_expiry" value="<%= values[`cert_${i}_expiry`] || '' %>"><% if (errors[`cert_${i}_expiry`]) { %><div class="field-err"><%= errors[`cert_${i}_expiry`] %></div><% } %></div>
        <div class="field"><label for="c-<%= i %>-f">Certificate file</label><input id="c-<%= i %>-f" type="file" name="cert_<%= i %>_file" accept="application/pdf,image/*,.heic,.heif,.doc,.docx"></div>
      </div>
      <% }) %>
    </div>
    <% } %>
    <% if (def.files && !row) { %>
    <div class="field wide">
      <label for="f-files">Photos and files</label>
      <input id="f-files" type="file" name="files" multiple>
      <div class="help">Optional. Photos, PDFs, iPhone photos, or Word, Excel and PowerPoint files, up to 25 MB each. You can add more later on the job's page.</div>
    </div>
    <% } %>
    <div class="form-actions wide">
      <% if (row) { %>
        <a class="btn primary" href="/app/<%= def.key %>/<%= row.id %>">Done</a>
        <noscript><button class="btn" type="submit">Save changes</button></noscript>
      <% } else { %>
        <button class="btn primary" type="submit">Create <%= def.singular.toLowerCase() %></button>
        <a class="btn" href="/app/<%= def.key %>">Cancel</a>
      <% } %>
      <span class="save-status" aria-live="polite"></span>
    </div>
  </form>
</section>
<%- include('partials/footer') %>
