<%- include('partials/header') %>
<header class="page-head">
  <div>
    <a class="crumb" href="<%= def.key === 'tenancies' ? (row ? `/app/tenancies/${row.id}` : '/app/tenants') : `/app/${def.key}` %>">← <%= def.key === 'tenancies' ? (row ? 'Tenancy' : 'Tenants') : def.plural %></a>
    <h1><%= title %></h1>
  </div>
</header>
<section class="card">
  <% if (Object.keys(errors).length) { %><div class="notice err">Please fix the highlighted fields.</div><% } %>
  <form method="post" action="/app/<%= def.key %><%= row ? '/' + row.id : '' %>" class="form-grid form-<%= def.key %>"<%- (def.files || def.key === 'properties') && !row ? ' enctype="multipart/form-data"' : '' %>
        <%- row ? 'data-autosave' : `data-draft="new-${def.key}" autocomplete="off"` %>>
    <%- include('partials/csrf') %>
    <% def.fields.forEach(f => { %>
      <%- include('partials/field', { f, value: values[f.name], error: errors[f.name], opts: options[f.name] }) %>
      <% if (typeof tenantCouncil !== 'undefined' && tenantCouncil && f.name === 'phone') { %>
      <div class="field">
        <label for="f-tenant_council_id">Council</label>
        <select id="f-tenant_council_id" name="tenant_council_id">
          <option value="">— None —</option>
          <% tenantCouncil.options.forEach(o => { %><option value="<%= o.id %>" <%= Number(tenantCouncil.council_id) === o.id ? 'selected' : '' %>><%= o.label %></option><% }) %>
        </select>
        <div class="help">The council for <%= tenantCouncil.address_line1 %>, the property they rent. Changing it updates the property.</div>
        <% if (errors.tenant_council_id) { %><div class="field-err"><%= errors.tenant_council_id %></div><% } %>
      </div>
      <% } %>
    <% }) %>
    <% if (def.key === 'properties' && !row) { %>
    <div class="wide new-certs">
      <h3 class="form-subhead">Certificates</h3>
      <p class="muted small">Optional. Fill in any you have and upload the certificate (PDF or photo, up to 25 MB); more can be added on the property's page.</p>
      <% if (errors.cert_upload) { %><div class="field-err"><%= errors.cert_upload %></div><% } %>
      <% ['Gas Safety (CP12)', 'EICR', 'EPC', 'Insurance'].forEach((type, i) => { %>
      <div class="cert-row">
        <strong><%= type %></strong>
        <div class="field"><label for="c-<%= i %>-i">Issued</label><input id="c-<%= i %>-i" type="date" name="cert_<%= i %>_issued" value="<%= values[`cert_${i}_issued`] || '' %>"><% if (errors[`cert_${i}_issued`]) { %><div class="field-err"><%= errors[`cert_${i}_issued`] %></div><% } %></div>
        <div class="field"><label for="c-<%= i %>-e">Expires</label><input id="c-<%= i %>-e" type="date" name="cert_<%= i %>_expiry" value="<%= values[`cert_${i}_expiry`] || '' %>"><% if (errors[`cert_${i}_expiry`]) { %><div class="field-err"><%= errors[`cert_${i}_expiry`] %></div><% } %></div>
        <div class="field"><label for="c-<%= i %>-f">Certificate file</label><input id="c-<%= i %>-f" type="file" name="cert_<%= i %>_file" accept="application/pdf,image/*,.heic,.heif,.doc,.docx"></div>
      </div>
      <% }) %>
    </div>
    <% } %>
    <% if (def.key === 'inspections' && !row) { %>
    <div class="wide sign-box new-sign" data-signature-optional>
      <h3>Signed by Tenant</h3>
      <input type="hidden" name="signature">
      <label class="small">Tenant’s name <input name="signature_name" maxlength="100" autocomplete="off"></label>
      <canvas class="sign-pad" width="600" height="200" aria-label="Tenant signs here"></canvas>
      <p class="muted small sign-hint" data-signature-hint>The tenant signs in the box with a finger, pen or mouse. Optional: they can sign later on the inspection’s page.</p>
      <div class="sign-actions"><button class="btn small" type="button" data-signature-clear>Clear</button></div>
    </div>
    <% } %>
    <% if (def.key === 'maintenance' && !row) { %>
    <div class="wide sign-grid new-signs">
      <div class="sign-box new-sign" data-signature-optional>
        <h3>Signed by Tenant / SU</h3>
        <input type="hidden" name="signature_tenant">
        <fieldset class="sign-satisfied">
          <legend class="small">Works carried out to the satisfaction of the tenant?</legend>
          <label class="check small"><input type="radio" name="satisfied" value="Yes"> Yes</label>
          <label class="check small"><input type="radio" name="satisfied" value="No"> No</label>
        </fieldset>
        <label class="small">Name <input name="signature_tenant_name" maxlength="100" autocomplete="off"></label>
        <canvas class="sign-pad" width="600" height="200" aria-label="Tenant signs here"></canvas>
        <p class="muted small sign-hint" data-signature-hint>Optional: they can sign later on the job’s page.</p>
        <div class="sign-actions"><button class="btn small" type="button" data-signature-clear>Clear</button></div>
      </div>
      <div class="sign-box new-sign" data-signature-optional>
        <h3>Signed by Maintenance / Contractor</h3>
        <input type="hidden" name="signature_contractor">
        <label class="small">Name <input name="signature_contractor_name" maxlength="100" autocomplete="off"></label>
        <canvas class="sign-pad" width="600" height="200" aria-label="Maintenance or contractor signs here"></canvas>
        <p class="muted small sign-hint" data-signature-hint>Optional: they can sign later on the job’s page.</p>
        <div class="sign-actions"><button class="btn small" type="button" data-signature-clear>Clear</button></div>
      </div>
    </div>
    <% } %>
    <% if (def.files && !row) { %>
    <div class="field wide">
      <label for="f-files">Photos and files</label>
      <input id="f-files" type="file" name="files" multiple>
      <div class="help">Optional. Photos, PDFs, iPhone photos, or Word, Excel and PowerPoint files, up to 25 MB each. You can add more later on the job's page.</div>
    </div>
    <% } %>
    <div class="form-actions wide">
      <% if (row) { %>
        <a class="btn primary" href="/app/<%= def.key %>/<%= row.id %>">Done</a>
        <noscript><button class="btn" type="submit">Save changes</button></noscript>
      <% } else { %>
        <button class="btn primary" type="submit">Create <%= def.singular.toLowerCase() %></button>
        <a class="btn" href="/app/<%= def.key %>">Cancel</a>
      <% } %>
      <span class="save-status" aria-live="polite"></span>
    </div>
  </form>
</section>
<% if (typeof editCerts !== 'undefined' && editCerts) { %>
<section class="card" id="edit-certs">
  <h2>Certificates</h2>
  <p class="muted small">Change the dates or upload the certificate (PDF or photo, up to 25 MB), then press Save on that row. For a renewal, use <strong>+ Renewal</strong> so the old one is kept in the history.</p>
  <% if (editCerts.flash) { %><div class="notice ok"><%= editCerts.flash %></div><% } %>
  <% if (editCerts.error) { %><div class="notice err"><%= editCerts.error %></div><% } %>
  <% editCerts.list.forEach((c, i) => { const cur = c.current; %>
  <form method="post" action="/app/properties/<%= row.id %>/certs/<%= i %>" enctype="multipart/form-data" class="cert-row cert-edit-row">
    <%- include('partials/csrf') %>
    <div>
      <strong><%= c.title %></strong>
      <span class="badge cert-badge-<%= c.status.key %>"><%= c.status.label %></span>
      <% if (cur && cur.files.length) { %><div class="small"><% cur.files.forEach(f => { %><a href="/app/compliance/<%= cur.id %>/files/<%= f.id %>" target="_blank" rel="noopener">📄 <%= f.filename %></a> <% }) %></div><% } %>
    </div>
    <div class="field"><label for="ec-<%= i %>-i">Issued</label><input id="ec-<%= i %>-i" type="date" name="issued" value="<%= cur && cur.issued_date || '' %>"></div>
    <div class="field"><label for="ec-<%= i %>-e">Expires</label><input id="ec-<%= i %>-e" type="date" name="expiry" value="<%= cur && cur.expiry_date || '' %>" required></div>
    <div class="field"><label for="ec-<%= i %>-f"><%= cur && cur.files.length ? 'Add another file' : 'Certificate file' %></label><input id="ec-<%= i %>-f" type="file" name="file" accept="application/pdf,image/*,.heic,.heif,.doc,.docx"></div>
    <div class="cert-edit-actions">
      <button class="btn small primary" type="submit">Save</button>
      <% if (cur) { %><a class="btn small" href="/app/compliance/new?property_id=<%= row.id %>&item_type=<%= encodeURIComponent(c.type) %>">+ Renewal</a><% } %>
    </div>
  </form>
  <% }) %>
</section>
<% } %>
<% if (def.fields.some((f) => f.segment)) { %>
<link rel="stylesheet" href="/static/segments.css?v=<%= assetV %>">
<script src="/static/segments.js?v=<%= assetV %>" defer></script>
<% } %>
<%- include('partials/footer') %>
