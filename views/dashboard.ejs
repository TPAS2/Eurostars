<%- include('partials/header') %>
<div id="dashboard-bg" class="dashboard-bg" aria-hidden="true"></div>
<header class="page-head">
  <div>
    <h1 class="co-title"><span class="co-name"><%= user.agency_name %></span><span class="co-sep" aria-hidden="true">/</span><span>Dashboard</span></h1>
    <p class="muted">Welcome back, <%= user.name %>. Here's where things stand today, <%= fmt.ukDate(today) %>.</p>
  </div>
  <div class="actions">
    <link rel="stylesheet" href="/static/dashboard.css">
    <div id="theme-switch" class="theme-switch" data-csrf="<%= csrfToken %>"></div>
    <script src="/static/dashboard.js" defer></script>
    <a class="btn" href="/app/landlords/new">+ Landlord</a>
    <a class="btn" href="/app/properties/new">+ Property</a>
    <a class="btn primary" href="/app/transactions/new?txn_type=rent_received">Record rent received</a>
  </div>
</header>
<% if (flash) { %><div class="notice ok"><%= flash %></div><% } %>

<section class="card notifications <%= notifications.length ? 'has-items' : '' %>" id="notifications">
  <div class="card-head">
    <% const urgent = notifications.filter(n => n.urgent).length; %>
    <h2>Notifications <% if (notifications.length) { %><span class="count <%= urgent ? 'alert-count' : '' %>"><%= notifications.length %></span><% } %></h2>
    <span class="muted small">Certificates and insurance expiring within two months</span>
  </div>
  <% if (!notifications.length) { %>
    <p class="muted">Nothing needs attention. Everything is in date for at least the next two months.</p>
  <% } else { %>
  <ul class="notice-list">
    <% notifications.forEach(n => { %>
    <li class="<%= n.expired ? 'is-expired' : n.urgent ? 'is-expiring' : 'is-upcoming' %>">
      <span class="notice-dot" aria-hidden="true"></span>
      <div class="notice-text">
        <strong><%= n.name %></strong> for <a href="/app/properties/<%= n.property_id %>#certificates"><%= n.address_line1 %></a>
        <span class="notice-when"><%= n.when %> (<%= fmt.ukDate(n.expiry_date) %>)</span>
      </div>
      <a class="btn small" href="/app/compliance/new?property_id=<%= n.property_id %>&item_type=<%= encodeURIComponent(n.item_type) %>">Add new</a>
    </li>
    <% }) %>
  </ul>
  <% } %>
</section>

<% const pb = propertyBox; const groups = [
  ['Empty – needs maintenance', pb.needsWork, 'bad', (x) => `${x.jobs} open job${x.jobs === 1 ? '' : 's'}`, (x) => `/app/properties/${x.id}`],
  ['Empty – ready to rent', pb.ready, 'ok', () => '', (x) => `/app/properties/${x.id}`],
  [`Reserved · ${stats.monthLabel}`, pb.booked, 'info', (x) => `${x.tenant} · ${fmt.ukDate(x.date)}`, (x) => `/app/tenancies/${x.id}`],
  [`New acquisitions · ${stats.monthLabel}`, pb.acquired, 'info', (x) => fmt.ukDate(x.date), (x) => `/app/properties/${x.id}`],
  [`Handed back · ${stats.monthLabel}`, pb.handedBack, 'warn', (x) => fmt.ukDate(x.date), (x) => `/app/properties/${x.id}`],
]; %>
<section class="card property-overview" id="property-overview">
  <div class="card-head">
    <h2>Properties <span class="count"><%= pb.empty.length %> empty</span></h2>
    <span class="muted small">Empty properties, bookings, new and handed back this month</span>
  </div>
  <div class="po-tiles">
    <% groups.forEach(([label, list, tone]) => { %><div class="po-tile po-<%= tone %>"><span class="po-n"><%= list.length %></span><span class="po-label"><%= label %></span></div><% }) %>
  </div>
  <% groups.forEach(([label, list, tone, detail, href]) => { if (!list.length) return; %>
  <details class="po-group">
    <summary><%= label %> <span class="count"><%= list.length %></span></summary>
    <ul class="po-list"><% list.forEach(x => { %><li><a href="<%= href(x) %>"><%= x.address_line1 %></a><% const d = detail(x); if (d) { %> <span class="muted small">· <%= d %></span><% } %></li><% }) %></ul>
  </details>
  <% }) %>
</section>

<section class="tiles">
  <a class="tile" href="/app/properties"><span class="label">Properties</span><span class="value"><%= stats.properties %></span><span class="sub"><%= stats.let %> let · <%= stats.vacant %> vacant</span></a>
  <a class="tile" href="/app/landlords"><span class="label">Landlords</span><span class="value"><%= stats.landlords %></span><span class="sub"><%= stats.tenants %> tenants</span></a>
  <a class="tile" href="/app/tenants"><span class="label">Active tenancies</span><span class="value"><%= stats.activeTenancies %></span><span class="sub">&nbsp;</span></a>
  <a class="tile <%= stats.openJobs > 0 ? 'warn' : '' %>" href="/app/maintenance?month=all"><span class="label">Open maintenance</span><span class="value"><%= stats.openJobs %></span><span class="sub">&nbsp;</span></a>
  <a class="tile" href="/app/council-reconciliation"><span class="label">Total invoiced to councils</span><span class="value"><%= fmt.money(stats.councilInvoiced) %></span><span class="sub"><%= stats.monthLabel %></span></a>
  <a class="tile" href="/app/rent-run"><span class="label">Total paid to landlords</span><span class="value"><%= fmt.money(stats.paidToLandlords) %></span><span class="sub"><%= stats.statementsReady ? `${stats.landlordsPaid} landlord${stats.landlordsPaid === 1 ? '' : 's'} · ${stats.monthLabel}` : `Rents not calculated yet · ${stats.monthLabel}` %></span></a>
  <a class="tile <%= stats.grossProfit > 0 ? 'ok' : stats.grossProfit < 0 ? 'alert' : '' %>" href="/app/council-reconciliation"><span class="label">Gross profit</span><span class="value"><%= fmt.money(stats.grossProfit) %></span><span class="sub">Invoiced to councils − paid to landlords</span></a>
  <a class="tile <%= stats.overdueInvoices > 0 ? 'alert' : stats.unpaidInvoices > 0 ? 'warn' : '' %>" href="/app/invoices?status=unpaid"><span class="label">Unpaid invoices</span><span class="value"><%= fmt.money(stats.unpaidInvoicesTotal) %></span><span class="sub"><%= stats.unpaidInvoices %> contractor invoice<%= stats.unpaidInvoices === 1 ? '' : 's' %></span></a>
</section>


<%- include('partials/footer') %>
