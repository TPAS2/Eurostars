<%- include('partials/header') %>
<div id="dashboard-bg" class="dashboard-bg" aria-hidden="true"></div>
<header class="page-head">
  <div>
    <h1 class="co-title"><span class="co-name"><%= user.agency_name %></span><span class="co-sep" aria-hidden="true">/</span><span>Dashboard</span><span class="co-date"><%= fmt.ukDate(today) %></span></h1>
    <p class="muted">Welcome back, <%= user.name %>.</p>
  </div>
  <div class="actions">
    <link rel="stylesheet" href="/static/dashboard.css?v=<%= assetV %>">
    <script src="/static/dashboard.js?v=<%= assetV %>" defer></script>
    <a class="btn" href="/app/landlords/new">+ Landlord</a>
    <a class="btn" href="/app/properties/new">+ Property</a>
    <a class="btn primary" href="/app/transactions/new?txn_type=rent_received">Record rent received</a>
  </div>
</header>
<% if (flash) { %><div class="notice ok"><%= flash %></div><% } %>

<section class="card notifications <%= notifications.length ? 'has-items' : '' %>" id="notifications">
  <div class="card-head">
    <% const urgent = notifications.filter(n => n.urgent).length; %>
    <h2>Notifications <% if (notifications.length) { %><span class="count <%= urgent ? 'alert-count' : '' %>"><%= notifications.length %></span><% } %></h2>
    <span class="muted small">Certificates and insurance expiring within two months</span>
  </div>
  <% if (!notifications.length) { %>
    <p class="muted">Nothing needs attention. Everything is in date for at least the next two months.</p>
  <% } else { %>
  <ul class="notice-list">
    <% notifications.forEach(n => { %>
    <li class="<%= n.expired ? 'is-expired' : n.urgent ? 'is-expiring' : 'is-upcoming' %>">
      <span class="notice-dot" aria-hidden="true"></span>
      <div class="notice-text">
        <strong><%= n.name %></strong> for <a href="/app/properties/<%= n.property_id %>#certificates"><%= n.address_line1 %></a>
        <span class="notice-when"><%= n.when %> (<%= fmt.ukDate(n.expiry_date) %>)</span>
      </div>
      <a class="btn small" href="/app/compliance/new?property_id=<%= n.property_id %>&item_type=<%= encodeURIComponent(n.item_type) %>">Add new</a>
    </li>
    <% }) %>
  </ul>
  <% } %>
</section>

<% const pb = propertyBox; const groups = [
  ['Properties that need maintenance', pb.needsWork, 'bad', (x) => `${x.jobs} open job${x.jobs === 1 ? '' : 's'}`, (x) => `/app/properties/${x.id}`],
  ['Empty – ready to rent', pb.ready, 'ok', () => '', (x) => `/app/properties/${x.id}`],
  [`Reserved · ${stats.monthLabel}`, pb.booked, 'info', (x) => `${x.tenant} · ${fmt.ukDate(x.date)}`, (x) => `/app/tenancies/${x.id}`],
  [`New acquisitions · ${stats.monthLabel}`, pb.acquired, 'info', (x) => fmt.ukDate(x.date), (x) => `/app/properties/${x.id}`],
  [`Handed back · ${stats.monthLabel}`, pb.handedBack, 'warn', (x) => fmt.ukDate(x.date), (x) => `/app/properties/${x.id}`],
]; %>
<section class="card property-overview" id="property-overview">
  <div class="card-head">
    <h2>Properties <span class="count"><%= pb.empty.length %> empty</span></h2>
    <span class="muted small">Maintenance, empty properties, reservations, new and handed back this month</span>
  </div>
  <div class="po-tiles">
    <% groups.forEach(([label, list, tone]) => { %><div class="po-tile po-<%= tone %>"><span class="po-n"><%= list.length %></span><span class="po-label"><%= label %></span></div><% }) %>
  </div>
  <% groups.forEach(([label, list, tone, detail, href]) => { if (!list.length) return; %>
  <details class="po-group">
    <summary><%= label %> <span class="count"><%= list.length %></span></summary>
    <ul class="po-list"><% list.forEach(x => { %><li><a href="<%= href(x) %>"><%= x.address_line1 %></a><% const d = detail(x); if (d) { %> <span class="muted small">· <%= d %></span><% } %></li><% }) %></ul>
  </details>
  <% }) %>
</section>

<%
  // The eight figures at a glance, in one box: the portfolio first, then this month's money.
  const kpi = (icon, href, label, value, sub, tone = '') => ({ icon, href, label, value, sub, tone });
  const kpis = [
    kpi('properties', '/app/properties', 'Properties', stats.properties, `${stats.let} let · ${stats.vacant} vacant`),
    kpi('landlords', '/app/landlords', 'Landlords', stats.landlords, `${stats.tenants} tenant${stats.tenants === 1 ? '' : 's'}`),
    kpi('tenancies', '/app/tenants', 'Active tenancies', stats.activeTenancies, 'Living in a property now'),
    kpi('maintenance', '/app/maintenance?month=all', 'Open maintenance', stats.openJobs, stats.openJobs ? `Job${stats.openJobs === 1 ? '' : 's'} still to do` : 'All done', stats.openJobs > 0 ? 'warn' : ''),
    kpi('councils', '/app/council-reconciliation', 'Total invoiced to councils', fmt.money(stats.councilInvoiced), stats.monthLabel),
    kpi('rentrun', '/app/rent-run', 'Total paid to landlords', fmt.money(stats.paidToLandlords), stats.statementsReady ? `${stats.landlordsPaid} landlord${stats.landlordsPaid === 1 ? '' : 's'} · ${stats.monthLabel}` : `Rents not calculated yet · ${stats.monthLabel}`),
    kpi('profit', '/app/council-reconciliation', 'Gross profit', fmt.money(stats.grossProfit), 'Invoiced to councils − paid to landlords', stats.grossProfit > 0 ? 'ok' : stats.grossProfit < 0 ? 'alert' : ''),
    kpi('invoices', '/app/invoices?status=unpaid', 'Unpaid invoices', fmt.money(stats.unpaidInvoicesTotal), `${stats.unpaidInvoices} contractor invoice${stats.unpaidInvoices === 1 ? '' : 's'}`, stats.overdueInvoices > 0 ? 'alert' : stats.unpaidInvoices > 0 ? 'warn' : ''),
  ];
%>
<section class="kpi-strip" aria-label="At a glance">
  <% kpis.forEach((k, n) => { %>
  <a class="kpi <%= k.tone ? 'kpi-' + k.tone : '' %> <%= n === 4 ? 'kpi-money-start' : '' %>" href="<%= k.href %>">
    <span class="kpi-icon"><%- include('partials/icon', { name: k.icon }) %></span>
    <span class="label"><%= k.label %></span>
    <span class="value"><%= k.value %></span>
    <span class="sub"><%= k.sub %></span>
  </a>
  <% }) %>
</section>


<%- include('partials/footer') %>
