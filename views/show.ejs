<%- include('partials/header') %>
<header class="page-head">
  <div>
    <a class="crumb" href="/app/<%= def.key %>">← <%= def.plural %></a>
    <h1<%= photo && photo.v ? ' class=with-thumb' : '' %>><% if (photo && photo.v) { %><img class="title-thumb" src="/app/councils/<%= row.id %>/photo?v=<%= photo.v %>" alt=""><% } %><%= title %><% if (def.key === 'landlords' && row.code) { %> <span class="code-chip" title="Landlord code"><%= row.code %></span><% } %></h1>
  </div>
  <div class="actions">
    <% if (def.key === 'properties') { %><a class="btn primary" href="/app/properties/<%= row.id %>/add-tenant">+ Add tenant</a><% } %>
    <% if (def.key === 'landlords') { %><a class="btn primary" href="/app/properties/new?landlord_id=<%= row.id %>">+ Add property</a><% } %>
    <% if (def.key === 'councils') { %><a class="btn primary" href="/app/properties/new?council_id=<%= row.id %>">+ Add property in this council</a><% } %>
    <% if (def.key === 'maintenance') { %><a class="btn primary" href="/app/invoices/new?maintenance_job_id=<%= row.id %>">+ Upload invoice</a><% } %>
    <% if (def.key === 'tenancies') { %><a class="btn primary" href="/app/transactions/new?txn_type=rent_received&tenancy_id=<%= row.id %>">Record rent received</a><% } %>
    <a class="btn" href="/app/<%= def.key %>/<%= row.id %>/edit">Edit</a>
    <form method="post" action="/app/<%= def.key %>/<%= row.id %>/delete" data-confirm="Delete this <%= def.singular.toLowerCase() %>? Linked records may also be removed.">
      <%- include('partials/csrf') %>
      <button class="btn danger" type="submit">Delete</button>
    </form>
  </div>
</header>

<% if (error) { %><div class="notice err"><%= error %></div><% } %>
<% if (flash) { %><div class="notice ok"><%= flash %></div><% } %>
<section class="card">
  <% if (extra) { %><div class="callout <%= extra.alert ? 'alert' : '' %>"><span><%= extra.label %></span><strong><%= extra.value %></strong></div><% } %>
  <% if (photo) { %>
  <div class="with-photo">
    <div class="council-photo">
      <% if (photo.v) { %>
        <img src="/app/councils/<%= row.id %>/photo?v=<%= photo.v %>" alt="Picture of <%= row.name %>">
      <% } else { %>
        <div class="photo-empty" aria-hidden="true"><%= String(row.name || '?').trim().charAt(0).toUpperCase() %></div>
      <% } %>
      <form method="post" action="/app/councils/<%= row.id %>/photo" enctype="multipart/form-data" class="photo-upload">
        <%- include('partials/csrf') %>
        <label class="btn small">
          <%= photo.v ? 'Change picture' : 'Add picture' %>
          <input type="file" name="photo" accept="image/png,image/jpeg,image/webp,image/gif" data-autosubmit hidden>
        </label>
        <noscript><button class="btn small" type="submit">Upload</button></noscript>
      </form>
      <% if (photo.v) { %>
      <form method="post" action="/app/councils/<%= row.id %>/photo/delete" data-confirm="Remove this council's picture?">
        <%- include('partials/csrf') %>
        <button class="btn small link" type="submit">Remove</button>
      </form>
      <% } %>
    </div>
  <% } %>
  <dl class="details">
    <% def.fields.forEach(f => { const d = display(def, f.name, row, maps); %>
      <div class="<%= f.type === 'textarea' && !f.inline ? 'wide' : '' %><%= f.startRow ? ' row-start' : '' %>">
        <dt><%= f.label %></dt>
        <dd><% if (!d.text) { %><span class="muted">—</span><% } else if (d.href) { %><a href="<%= d.href %>"><%= d.text %></a><% } else if (d.badge) { %><span class="badge s-<%= String(row[f.name]).replace(/\W+/g, '-') %>"><%= d.text %></span><% } else { %><span class="pre"><%= d.text %></span><% } %></dd>
      </div>
    <% }) %>
  </dl>
  <% if (photo) { %></div><% } %>
</section>

<% if (tenantBoxes) { %>
  <% if (!tenantBoxes.length && def.key === 'tenants') { %>
  <section class="card"><p class="muted">No tenancy yet. Add one from a property with <strong>+ Add tenant</strong>.</p></section>
  <% } %>
  <% tenantBoxes.forEach(t => { const back = `/app/${def.key}/${row.id}`; %>
  <section class="card tenant-box" id="tenancy-<%= t.id %>">
    <div class="card-head">
      <h2><%= def.key === 'tenants' ? (t.status === 'active' ? 'Current tenancy' : 'Latest tenancy') : 'Council, property & agreement' %></h2>
      <% if (def.key === 'tenants') { %><a class="btn small" href="/app/tenancies/<%= t.id %>">Open tenancy</a><% } %>
    </div>
    <div class="tenant-box-grid">
      <div>
        <h3>Council</h3>
        <% if (t.council_id) { %>
          <p class="with-thumb-line"><% if (t.council_photo_v) { %><img class="thumb" src="/app/councils/<%= t.council_id %>/photo?v=<%= t.council_photo_v %>" alt=""><% } %><a href="/app/councils/<%= t.council_id %>"><strong><%= t.council_name %></strong></a></p>
          <dl class="mini">
            <% if (t.council_tax_account) { %><dt>Council tax account</dt><dd><%= t.council_tax_account %></dd><% } %>
            <% if (t.council_tax_payer) { %><dt>Council tax paid by</dt><dd><%= t.council_tax_payer %></dd><% } %>
            <% if (t.council_tax_phone) { %><dt>Council tax phone</dt><dd><%= t.council_tax_phone %></dd><% } %>
            <% if (t.council_tax_email) { %><dt>Council tax email</dt><dd><%= t.council_tax_email %></dd><% } %>
          </dl>
        <% } else { %><p class="muted">No council set for this property. <a href="/app/properties/<%= t.property_id %>/edit">Set council</a></p><% } %>
      </div>
      <div>
        <h3>Property</h3>
        <p><a href="/app/properties/<%= t.property_id %>"><strong><%= t.address_line1 %></strong></a></p>
        <dl class="mini">
          <% if (t.town || t.postcode) { %><dt>Address</dt><dd><%= [t.town, t.postcode].filter(Boolean).join(', ') %></dd><% } %>
          <% if (t.property_type) { %><dt>Type</dt><dd><%= t.property_type %><%= t.bedrooms ? ` · ${t.bedrooms} bed` : '' %></dd><% } %>
          <dt>Landlord</dt><dd><% if (t.landlord_id) { %><a href="/app/landlords/<%= t.landlord_id %>"><%= t.landlord_name %></a><% } else { %><span class="muted">—</span><% } %></dd>
        </dl>
      </div>
      <div>
        <h3>Tenancy agreement</h3>
        <dl class="mini">
          <dt>Status</dt><dd><span class="badge s-<%= t.status %>"><%= t.status %></span></dd>
          <dt>Booked</dt><dd><%= fmt.ukDate(t.booking_date) %></dd>
          <dt>Term</dt><dd><%= fmt.ukDate(t.start_date) %> – <%= t.end_date ? fmt.ukDate(t.end_date) : 'ongoing' %></dd>
          <dt>Rent</dt><dd><%= fmt.money(t.rent_pence) %> <%= t.rent_frequency === 'weekly' ? 'a week' : 'a month' %></dd>
          <% if (t.deposit_pence) { %><dt>Deposit</dt><dd><%= fmt.money(t.deposit_pence) %><%= t.deposit_scheme ? ` · ${t.deposit_scheme}` : '' %></dd><% } %>
        </dl>
        <div class="agreement">
          <% if (t.agreement_name) { %>
            <p class="small"><a href="/app/tenancies/<%= t.id %>/agreement" target="_blank" rel="noopener"><strong>📄 <%= t.agreement_name %></strong></a><br><span class="muted">Uploaded <%= fmt.ukDateTime(t.agreement_uploaded) %> · <%= Math.max(1, Math.round(t.agreement_size / 1024)) %> KB</span></p>
          <% } else { %><p class="muted small">No signed agreement uploaded yet.</p><% } %>
          <div class="agreement-actions">
            <form method="post" action="/app/tenancies/<%= t.id %>/agreement" enctype="multipart/form-data">
              <%- include('partials/csrf') %>
              <input type="hidden" name="back" value="<%= back %>">
              <label class="btn small"><%= t.agreement_name ? 'Replace agreement' : 'Upload agreement' %><input type="file" name="agreement" accept="application/pdf,image/png,image/jpeg" data-autosubmit hidden></label>
              <noscript><button class="btn small" type="submit">Upload</button></noscript>
            </form>
            <% if (t.agreement_name) { %>
            <a class="btn small" href="/app/tenancies/<%= t.id %>/agreement?download=1">Download</a>
            <form method="post" action="/app/tenancies/<%= t.id %>/agreement/delete" data-confirm="Remove the uploaded tenancy agreement?">
              <%- include('partials/csrf') %><input type="hidden" name="back" value="<%= back %>">
              <button class="btn small link" type="submit">Remove</button>
            </form>
            <% } %>
          </div>
        </div>
      </div>
    </div>
  </section>
  <% }) %>
<% } %>

<% if (certs) { %>
<section class="card" id="certificates">
  <div class="card-head"><h2>Certificates &amp; insurance</h2></div>
  <div class="cert-grid">
    <% certs.forEach(c => { %>
    <div class="cert cert-<%= c.status.key %>">
      <div class="cert-head">
        <h3><%= c.title %></h3>
        <span class="badge cert-badge-<%= c.status.key %>"><%= c.status.label %></span>
      </div>
      <% if (c.current) { %>
        <dl class="cert-facts">
          <div><dt>Expires</dt><dd><strong><%= fmt.ukDate(c.current.expiry_date) %></strong></dd></div>
          <div><dt>Issued</dt><dd><%= c.current.issued_date ? fmt.ukDate(c.current.issued_date) : '—' %></dd></div>
          <div><dt>Added</dt><dd><%= fmt.ukDate(c.current.created_at) %></dd></div>
          <% if (c.current.provider) { %><div><dt>Provider</dt><dd><%= c.current.provider %></dd></div><% } %>
          <% if (c.current.reference) { %><div><dt>No.</dt><dd><%= c.current.reference %></dd></div><% } %>
        </dl>
        <a class="small" href="/app/compliance/<%= c.current.id %>">View / edit</a>
      <% } else { %>
        <p class="muted small">No <%= c.title.toLowerCase() %> recorded for this property.</p>
      <% } %>
      <a class="btn small <%= c.current ? '' : 'primary' %>" href="/app/compliance/new?property_id=<%= row.id %>&item_type=<%= encodeURIComponent(c.type) %>">+ Add <%= c.current ? 'new' : '' %> <%= c.title.split(' (')[0].toLowerCase() %></a>
      <% if (c.previous.length) { %>
      <details class="cert-history">
        <summary>Previous (<%= c.previous.length %>)</summary>
        <div class="table-scroll"><table>
          <thead><tr><th>Issued</th><th>Expired</th><th>Provider</th><th>No.</th></tr></thead>
          <tbody>
          <% c.previous.forEach(p => { %>
            <tr data-href="/app/compliance/<%= p.id %>"><td><a href="/app/compliance/<%= p.id %>"><%= p.issued_date ? fmt.ukDate(p.issued_date) : '—' %></a></td><td><%= fmt.ukDate(p.expiry_date) %></td><td><%= p.provider || '' %></td><td><%= p.reference || '' %></td></tr>
          <% }) %>
          </tbody>
        </table></div>
      </details>
      <% } %>
    </div>
    <% }) %>
  </div>
</section>
<% } %>

<% if (invoices) { const q = def.key === 'maintenance' ? 'maintenance_job_id' : 'property_id'; %>
<section class="card">
  <div class="card-head">
    <h2>Invoices <span class="count"><%= invoices.length %></span></h2>
    <a class="btn small" href="/app/invoices/new?<%= q %>=<%= row.id %>">+ Upload invoice</a>
  </div>
  <% if (!invoices.length) { %><p class="muted">No invoices yet.</p><% } else { %>
    <%- include('invoices/table', { invoices, showProperty: false, backTo: `/app/${def.key}/${row.id}` }) %>
  <% } %>
</section>
<% } %>

<% related.forEach(r => { %>
<section class="card">
  <div class="card-head"><h2><%= r.title %> <span class="count"><%= r.rows.length %></span></h2></div>
  <% if (!r.rows.length) { %><p class="muted"><%= r.empty %></p><% } else { %>
  <div class="table-wrap"><table>
    <thead><tr><% r.headers.forEach(h => { %><th><%= h %></th><% }) %></tr></thead>
    <tbody>
    <% r.rows.forEach(cells => { %><tr><% cells.forEach(c => { %><td class="<%= c.num ? 'num' : '' %>"><% if (c.href) { %><a href="<%= c.href %>"><%= c.text %></a><% } else { %><%= c.text %><% } %></td><% }) %></tr><% }) %>
    </tbody>
  </table></div>
  <% } %>
</section>
<% }) %>

<% children.forEach(c => { %>
<section class="card">
  <div class="card-head">
    <h2><%= c.title ? c.title : def.key === 'landlords' && c.def.key === 'properties' ? 'Properties owned' : def.key === 'councils' && c.def.key === 'properties' ? 'Properties in this council' : c.def.plural %> <span class="count"><%= c.rows.length %></span></h2>
    <% if (def.key === 'properties' && c.def.key === 'tenancies') { %>
      <a class="btn small" href="/app/properties/<%= row.id %>/add-tenant">+ Add tenant</a>
    <% } else { %>
      <a class="btn small" href="/app/<%= c.def.key %>/new?<%= c.fk %>=<%= row.id %>">+ Add <%= c.def.singular.toLowerCase() %></a>
    <% } %>
  </div>
  <% if (!c.rows.length) { %><p class="muted">None yet.</p><% } else { %>
    <%- include('partials/table', { def: c.def, rows: c.rows, maps: c.maps, hideField: c.fk }) %>
  <% } %>
</section>
<% }) %>
<%- include('partials/footer') %>
