<%- include('partials/header') %>
<header class="page-head">
  <div>
    <% if (def.key === 'tenancies') { %><a class="crumb" href="/app/tenants/<%= row.tenant_id %>">← <%= maps.tenants.get(row.tenant_id) || 'Tenant' %></a><% } else { %><a class="crumb" href="/app/<%= def.key %>">← <%= def.plural %></a><% } %>
    <h1<%= photo && photo.v ? ' class=with-thumb' : '' %>><% if (photo && photo.v) { %><img class="title-thumb" src="/app/councils/<%= row.id %>/photo?v=<%= photo.v %>" alt=""><% } %><%= title %><% if (def.key === 'landlords' && row.code) { %> <span class="code-chip" title="Landlord code"><%= row.code %></span><% } %></h1>
  </div>
  <div class="actions">
    <% if (def.key === 'properties') { %><a class="btn primary" href="/app/properties/<%= row.id %>/add-tenant">+ Add tenant</a><% } %>
    <% if (def.key === 'landlords') { %><a class="btn primary" href="/app/properties/new?landlord_id=<%= row.id %>">+ Add property</a><% } %>
    <% if (def.key === 'councils') { %><a class="btn" href="/app/councils/<%= row.id %>/database">Database</a><a class="btn primary" href="/app/properties/new?council_id=<%= row.id %>">+ Add property in this council</a><% } %>
    <% if (def.key === 'maintenance') { %><a class="btn primary" href="/app/invoices/new?maintenance_job_id=<%= row.id %>">+ Upload invoice</a><% } %>
    <% if (def.key === 'tenancies') { %><a class="btn primary" href="/app/transactions/new?txn_type=rent_received&tenancy_id=<%= row.id %>">Record rent received</a><% } %>
    <a class="btn" href="/app/<%= def.key %>/<%= row.id %>/edit">Edit</a>
    <form method="post" action="/app/<%= def.key %>/<%= row.id %>/delete" data-confirm="Delete this <%= def.singular.toLowerCase() %>? Linked records may also be removed.">
      <%- include('partials/csrf') %>
      <button class="btn danger" type="submit">Delete</button>
    </form>
  </div>
</header>

<% if (error) { %><div class="notice err"><%= error %></div><% } %>
<% if (flash) { %><div class="notice ok"><%= flash %></div><% } %>
<% if (typeof bankChanges !== 'undefined' && bankChanges.length) { %>
<div class="notice err bank-alert" id="bank-changes">
  <strong>Bank details changed — check with the landlord before paying them.</strong>
  <ul class="tight">
    <% bankChanges.forEach(c => { %><li><%= fmt.ukDateTime(c.changed_at) %> by <%= c.changed_by_name || 'someone' %>: account <%= c.oldAccount %> → <%= c.newAccount %>, sort code <%= c.oldSort %> → <%= c.newSort %><% if ((c.old_name || '') !== (c.new_name || '')) { %>, account name “<%= c.old_name || '' %>” → “<%= c.new_name || '' %>”<% } %></li><% }) %>
  </ul>
  <p class="small">Fraudsters change bank details to redirect rent. Phone the landlord on a number you already have (not one from the email or letter asking for the change) and confirm the new details.</p>
  <form method="post" action="/app/landlords/<%= row.id %>/bank-checked" class="inline" data-confirm="Have you confirmed the new bank details with the landlord directly?">
    <%- include('partials/csrf') %>
    <button class="btn small" type="submit">I've checked them with the landlord</button>
  </form>
</div>
<% } %>
<% if (typeof contractorStats !== 'undefined' && contractorStats) { const cs = contractorStats; const plural = (n) => `${n} invoice${n === 1 ? '' : 's'}`; %>
<section class="tiles centered-tiles contractor-tiles">
  <div class="tile">
    <span class="label">Paid in
      <form method="get" data-autogo class="tile-month">
        <select name="month" aria-label="Month">
          <% cs.months.forEach(m => { %><option value="<%= m.value %>" <%= m.value === cs.month ? 'selected' : '' %>><%= m.label %></option><% }) %>
        </select>
        <noscript><button class="btn small" type="submit">Show</button></noscript>
      </form>
    </span>
    <span class="value"><%= fmt.money(cs.paidMonth) %></span><span class="sub"><%= plural(cs.paidMonthN) %></span>
  </div>
  <div class="tile ok"><span class="label">Paid all time</span><span class="value"><%= fmt.money(cs.paidAll) %></span><span class="sub"><%= plural(cs.paidAllN) %></span></div>
  <div class="tile <%= cs.unpaidN ? 'warn' : '' %>"><span class="label">Unpaid</span><span class="value"><%= fmt.money(cs.unpaid) %></span><span class="sub"><%= plural(cs.unpaidN) %></span></div>
  <div class="tile"><span class="label">Last paid</span><span class="value sm"><%= cs.last ? fmt.ukDate(cs.last) : '—' %></span><span class="sub"><%= plural(cs.invoicesN) %> in total</span></div>
</section>
<% } %>
<section class="card">
  <% if (extra) { %><div class="callout <%= extra.alert ? 'alert' : '' %>"><span><%= extra.label %></span><strong><%= extra.value %></strong></div><% } %>
  <% if (photo) { %>
  <div class="with-photo">
    <div class="council-photo">
      <% if (photo.v) { %>
        <img src="/app/councils/<%= row.id %>/photo?v=<%= photo.v %>" alt="Picture of <%= row.name %>">
      <% } else { %>
        <div class="photo-empty" aria-hidden="true"><%= String(row.name || '?').trim().charAt(0).toUpperCase() %></div>
      <% } %>
      <form method="post" action="/app/councils/<%= row.id %>/photo" enctype="multipart/form-data" class="photo-upload">
        <%- include('partials/csrf') %>
        <label class="btn small">
          <%= photo.v ? 'Change picture' : 'Add picture' %>
          <input type="file" name="photo" accept="image/png,image/jpeg,image/webp,image/gif" data-autosubmit hidden>
        </label>
        <noscript><button class="btn small" type="submit">Upload</button></noscript>
      </form>
      <% if (photo.v) { %>
      <form method="post" action="/app/councils/<%= row.id %>/photo/delete" data-confirm="Remove this council's picture?">
        <%- include('partials/csrf') %>
        <button class="btn small link" type="submit">Remove</button>
      </form>
      <% } %>
    </div>
  <% } %>
  <dl class="details">
    <% def.fields.forEach(f => { const d = display(def, f.name, row, maps); %>
      <div class="<%= f.type === 'textarea' && !f.inline ? 'wide' : '' %><%= f.startRow ? ' row-start' : '' %>">
        <dt><%= f.label %></dt>
        <dd><% if (!d.text) { %><span class="muted">—</span><% } else if (d.href) { %><a href="<%= d.href %>"><%= d.text %></a><% } else if (d.badge) { %><span class="badge s-<%= String(row[f.name]).replace(/\W+/g, '-') %>"><%= d.text %></span><% } else { %><span class="pre"><%= d.text %></span><% } %></dd>
      </div>
      <% if (def.key === 'tenants' && f.name === 'phone') { const tc = tenantBoxes && tenantBoxes[0]; %>
      <div>
        <dt>Council</dt>
        <dd><% if (tc && tc.council_id) { %><a href="/app/councils/<%= tc.council_id %>"><%= tc.council_name %></a><% } else { %><span class="muted">—</span><% } %></dd>
      </div>
      <% } %>
    <% }) %>
  </dl>
  <% if (photo) { %></div><% } %>
</section>

<% if (tenantBoxes) { %>
  <% if (!tenantBoxes.length && def.key === 'tenants') { %>
  <section class="card"><p class="muted">No tenancy yet. Add one from a property with <strong>+ Add tenant</strong>.</p></section>
  <% } %>
  <% tenantBoxes.forEach(t => { const back = `/app/${def.key}/${row.id}`; %>
  <section class="card tenant-box" id="tenancy-<%= t.id %>">
    <div class="card-head">
      <h2><%= def.key === 'tenants' ? (t.status === 'active' ? 'Current tenancy' : 'Latest tenancy') : 'Council, property & agreement' %></h2>
      <% if (def.key === 'tenants') { %><a class="btn small" href="/app/tenancies/<%= t.id %>">Open tenancy</a><% } %>
    </div>
    <div class="tenant-box-grid">
      <% if (def.key !== 'tenants') { %>
      <div>
        <h3>Council</h3>
        <% if (t.council_id) { %>
          <p class="with-thumb-line"><% if (t.council_photo_v) { %><img class="thumb" src="/app/councils/<%= t.council_id %>/photo?v=<%= t.council_photo_v %>" alt=""><% } %><a href="/app/councils/<%= t.council_id %>"><strong><%= t.council_name %></strong></a></p>
          <dl class="mini">
            <% if (t.council_tax_phone) { %><dt>Phone</dt><dd class="pre"><%= t.council_tax_phone %></dd><% } %>
            <% if (t.council_tax_email) { %><dt>Email</dt><dd class="pre"><%= t.council_tax_email %></dd><% } %>
          </dl>
        <% } else { %><p class="muted">No council set for this property. <a href="/app/properties/<%= t.property_id %>/edit">Set council</a></p><% } %>
      </div>
      <% } %>
      <div>
        <h3>Property</h3>
        <p><a href="/app/properties/<%= t.property_id %>"><strong><%= t.address_line1 %></strong></a></p>
        <dl class="mini">
          <% if (t.town || t.postcode) { %><dt>Address</dt><dd><%= [t.town, t.postcode].filter(Boolean).join(', ') %></dd><% } %>
          <% if (t.property_type) { %><dt>Type</dt><dd><%= t.property_type %><%= t.bedrooms ? ` · ${t.bedrooms} bed` : '' %></dd><% } %>
          <dt>Landlord</dt><dd><% if (t.landlord_id) { %><a href="/app/landlords/<%= t.landlord_id %>"><%= t.landlord_name %></a><% } else { %><span class="muted">—</span><% } %></dd>
        </dl>
      </div>
      <div>
        <h3>Tenancy agreement</h3>
        <dl class="mini">
          <dt>Status</dt><dd class="status-edit"><span class="badge s-<%= t.status %>"><%= t.status %></span> <a class="btn small" href="/app/tenancies/<%= t.id %>/edit">Edit</a></dd>
          <dt>Reserved</dt><dd><%= fmt.ukDate(t.booking_date) %></dd>
          <% if (t.term_booked) { %><dt>Term as booked</dt><dd><%= t.term_booked %></dd><% } %>
          <dt>Dates</dt><dd><%= fmt.ukDate(t.start_date) %> – <%= t.end_date ? fmt.ukDate(t.end_date) : 'ongoing' %></dd>
        </dl>
        <div class="agreement">
          <% if (t.agreement_name) { %>
            <p class="small"><a href="/app/tenancies/<%= t.id %>/agreement" target="_blank" rel="noopener"><strong>📄 <%= t.agreement_name %></strong></a><br><span class="muted">Uploaded <%= fmt.ukDateTime(t.agreement_uploaded) %> · <%= Math.max(1, Math.round(t.agreement_size / 1024)) %> KB</span></p>
          <% } else { %><p class="muted small">No signed agreement uploaded yet.</p><% } %>
          <div class="agreement-actions">
            <form method="post" action="/app/tenancies/<%= t.id %>/agreement" enctype="multipart/form-data">
              <%- include('partials/csrf') %>
              <input type="hidden" name="back" value="<%= back %>">
              <label class="btn small"><%= t.agreement_name ? 'Replace agreement' : 'Upload agreement' %><input type="file" name="agreement" accept="application/pdf,image/png,image/jpeg" data-autosubmit hidden></label>
              <noscript><button class="btn small" type="submit">Upload</button></noscript>
            </form>
            <% if (t.agreement_name) { %>
            <a class="btn small" href="/app/tenancies/<%= t.id %>/agreement?download=1">Download</a>
            <form method="post" action="/app/tenancies/<%= t.id %>/agreement/delete" data-confirm="Remove the uploaded tenancy agreement?">
              <%- include('partials/csrf') %><input type="hidden" name="back" value="<%= back %>">
              <button class="btn small link" type="submit">Remove</button>
            </form>
            <% } %>
          </div>
        </div>
      </div>
    </div>
  </section>
  <% }) %>
<% } %>

<% if (jobInvoice) { const ji = jobInvoice; const done = ji.status === 'completed'; %>
<section class="card" id="landlord-invoice">
  <div class="card-head"><h2>Landlord invoice</h2></div>
  <% if (!done) { %>
    <p class="muted">The maintenance invoice for <%= ji.landlord_name || 'the landlord' %> is ready to download and email once this job is marked <strong>completed</strong>.</p>
  <% } else { %>
    <p class="muted small">
      Maintenance invoice to <strong><%= ji.landlord_name || 'no landlord set on the property' %></strong> for <strong><%= fmt.money(ji.cost_pence || 0) %></strong><%= ji.cost_pence ? '' : ' (add the cost to the job first)' %>.
      <% if (ji.invoice_emailed_at) { %><br>Emailed to <%= ji.invoice_emailed_to %> on <%= fmt.ukDateTime(ji.invoice_emailed_at) %>.<% } %>
    </p>
    <div class="invoice-actions">
      <div class="step-actions">
        <a class="btn" href="/app/maintenance/<%= row.id %>/invoice.pdf" target="_blank" rel="noopener">View invoice</a>
        <a class="btn primary" href="/app/maintenance/<%= row.id %>/invoice.pdf?download=1">Download invoice (PDF)</a>
      </div>
      <form method="post" action="/app/maintenance/<%= row.id %>/invoice/date" class="inline-form" data-no-keep>
        <%- include('partials/csrf') %>
        <label for="inv-date" class="small">Invoice date</label>
        <input id="inv-date" type="date" name="invoice_date" value="<%= ji.invoice_date || today %>" required>
        <button class="btn small" type="submit">Save date</button>
      </form>
      <form method="post" action="/app/maintenance/<%= row.id %>/invoice/email" class="step-email" data-busy="Sending…" data-no-keep>
        <%- include('partials/csrf') %>
        <label for="inv-to" class="small">Email to</label>
        <input id="inv-to" type="email" name="to" value="<%= ji.landlord_email || '' %>" placeholder="landlord@example.com" required>
        <button class="btn primary" type="submit" <%= emailEnabled ? '' : 'disabled' %>><%= ji.invoice_emailed_at ? 'Email again' : 'Email invoice' %></button>
      </form>
      <% if (!emailEnabled) { %><p class="muted small">Email isn't set up yet, so the invoice can only be downloaded for now.</p><% } %>
    </div>
  <% } %>
</section>
<% } %>

<% if (typeof certFiles !== 'undefined' && certFiles) { %>
<section class="card" id="cert-files">
  <div class="card-head">
    <h2>Certificate files <span class="count"><%= certFiles.length %></span></h2>
    <form method="post" action="/app/compliance/<%= row.id %>/files" enctype="multipart/form-data" class="inline" data-busy="Uploading…">
      <%- include('partials/csrf') %>
      <label class="btn small primary">+ Upload certificate<input type="file" name="files" multiple accept="application/pdf,image/*,.heic,.heif,.doc,.docx" data-autosubmit hidden></label>
      <noscript><button class="btn small" type="submit">Upload</button></noscript>
    </form>
  </div>
  <% if (!certFiles.length) { %><p class="muted">No file yet. Upload the certificate as a PDF or photo, up to 25 MB.</p><% } else { %>
  <ul class="cert-file-list">
    <% certFiles.forEach(f => { const url = `/app/compliance/${row.id}/files/${f.id}`; %>
    <li>
      <a href="<%= url %>" target="_blank" rel="noopener"><strong>📄 <%= f.filename %></strong></a>
      <span class="muted small"><%= Math.max(1, Math.round(f.size / 1024)) %> KB · <%= fmt.ukDate(f.uploaded_at.slice(0, 10)) %><%= f.uploaded_by_name ? ` · ${f.uploaded_by_name}` : '' %></span>
      <a class="small" href="<%= url %>?download=1">Download</a>
      <form method="post" action="<%= url %>/delete" data-confirm="Remove <%= f.filename %>?" class="inline"><%- include('partials/csrf') %><button class="btn small link" type="submit">Remove</button></form>
    </li>
    <% }) %>
  </ul>
  <% } %>
</section>
<% } %>
<% if (jobFiles) { %>
<section class="card" id="files">
  <div class="card-head">
    <h2>Photos &amp; files <span class="count"><%= jobFiles.length %></span></h2>
    <form method="post" action="/app/maintenance/<%= row.id %>/files" enctype="multipart/form-data" class="inline" data-busy="Uploading…">
      <%- include('partials/csrf') %>
      <label class="btn small primary">+ Upload photos or files<input type="file" name="files" multiple accept="image/*,.heic,.heif,application/pdf" data-autosubmit hidden></label>
      <noscript><button class="btn small" type="submit">Upload</button></noscript>
    </form>
  </div>
  <% if (!jobFiles.length) { %><p class="muted">No photos or files yet. Add before/after photos, quotes or reports. You can pick several at once, up to 25 MB each.</p><% } else { %>
  <div class="file-grid">
    <% jobFiles.forEach(f => { const url = `/app/maintenance/${row.id}/files/${f.id}`; const isImg = ['image/jpeg','image/png','image/webp','image/gif'].includes(f.mime); %>
    <figure class="file-tile">
      <a href="<%= url %>" target="_blank" rel="noopener" class="file-thumb">
        <% if (isImg) { %><img src="<%= url %>" alt="<%= f.filename %>" loading="lazy"><% } else { %><span class="file-type"><%= f.mime === 'application/pdf' ? 'PDF' : 'HEIC' %></span><% } %>
      </a>
      <figcaption>
        <span class="file-name" title="<%= f.filename %>"><%= f.filename %></span>
        <span class="muted small"><%= fmt.ukDate(f.uploaded_at.slice(0, 10)) %><%= f.uploaded_by_name ? ` · ${f.uploaded_by_name}` : '' %></span>
        <span class="file-actions">
          <a class="small" href="<%= url %>?download=1">Download</a>
          <form method="post" action="<%= url %>/delete" data-confirm="Remove <%= f.filename %>?" class="inline"><%- include('partials/csrf') %><button class="btn small link" type="submit">Remove</button></form>
        </span>
      </figcaption>
    </figure>
    <% }) %>
  </div>
  <% } %>
</section>
<% } %>

<% if (certs) { %>
<section class="card" id="certificates">
  <div class="card-head"><h2>Certificates &amp; insurance</h2></div>
  <div class="cert-grid">
    <% certs.forEach(c => { %>
    <div class="cert cert-<%= c.status.key %>">
      <div class="cert-head">
        <h3><%= c.title %></h3>
        <span class="badge cert-badge-<%= c.status.key %>"><%= c.status.label %></span>
      </div>
      <% if (c.current) { %>
        <dl class="cert-facts">
          <div><dt>Expires</dt><dd><strong><%= fmt.ukDate(c.current.expiry_date) %></strong></dd></div>
          <div><dt>Issued</dt><dd><%= c.current.issued_date ? fmt.ukDate(c.current.issued_date) : '—' %></dd></div>
          <div><dt>Added</dt><dd><%= fmt.ukDate(c.current.created_at) %></dd></div>
          <% if (c.current.provider) { %><div><dt>Provider</dt><dd><%= c.current.provider %></dd></div><% } %>
          <% if (c.current.reference) { %><div><dt>No.</dt><dd><%= c.current.reference %></dd></div><% } %>
        </dl>
        <% c.current.files.forEach(f => { %><a class="small cert-file-link" href="/app/compliance/<%= c.current.id %>/files/<%= f.id %>" target="_blank" rel="noopener">📄 <%= f.filename %></a><% }) %>
        <a class="small" href="/app/compliance/<%= c.current.id %>"><%= c.current.files.length ? 'View / edit' : 'View / edit · upload certificate' %></a>
      <% } else { %>
        <p class="muted small">No <%= c.title.toLowerCase() %> recorded for this property.</p>
      <% } %>
      <a class="btn small <%= c.current ? '' : 'primary' %>" href="/app/compliance/new?property_id=<%= row.id %>&item_type=<%= encodeURIComponent(c.type) %>">+ Add <%= c.current ? 'new' : '' %> <%= c.title.split(' (')[0].toLowerCase() %></a>
      <% if (c.previous.length) { %>
      <details class="cert-history">
        <summary>Previous (<%= c.previous.length %>)</summary>
        <div class="table-scroll"><table>
          <thead><tr><th>Issued</th><th>Expired</th><th>Provider</th><th>No.</th></tr></thead>
          <tbody>
          <% c.previous.forEach(p => { %>
            <tr data-href="/app/compliance/<%= p.id %>"><td><a href="/app/compliance/<%= p.id %>"><%= p.issued_date ? fmt.ukDate(p.issued_date) : '—' %></a></td><td><%= fmt.ukDate(p.expiry_date) %></td><td><%= p.provider || '' %></td><td><%= p.reference || '' %></td></tr>
          <% }) %>
          </tbody>
        </table></div>
      </details>
      <% } %>
    </div>
    <% }) %>
  </div>
</section>
<% } %>

<% if (invoices) { const q = { maintenance: 'maintenance_job_id', contractors: 'contractor_id' }[def.key] || 'property_id'; %>
<section class="card">
  <div class="card-head">
    <h2>Invoices <span class="count"><%= invoices.length %></span><% if (def.key === 'contractors') { const paid = invoices.filter(i => i.status === 'paid').reduce((t, i) => t + i.amount_pence, 0); %> <span class="muted small">· <%= fmt.money(paid) %> paid in total</span><% } %></h2>
    <a class="btn small" href="/app/invoices/new?<%= q %>=<%= row.id %>">+ Upload invoice</a>
  </div>
  <% if (!invoices.length) { %><p class="muted">No invoices yet.</p><% } else { %>
    <%- include('invoices/table', { invoices, showProperty: def.key === 'contractors', backTo: `/app/${def.key}/${row.id}` }) %>
  <% } %>
</section>
<% } %>

<% related.forEach(r => { %>
<section class="card">
  <div class="card-head"><h2><%= r.title %> <span class="count"><%= r.rows.length %></span></h2></div>
  <% if (!r.rows.length) { %><p class="muted"><%= r.empty %></p><% } else { %>
  <div class="table-wrap"><table>
    <thead><tr><% r.headers.forEach(h => { %><th><%= h %></th><% }) %></tr></thead>
    <tbody>
    <% r.rows.forEach(cells => { %><tr><% cells.forEach(c => { %><td class="<%= c.num ? 'num' : '' %>"><% if (c.href) { %><a href="<%= c.href %>"><%= c.text %></a><% } else { %><%= c.text %><% } %></td><% }) %></tr><% }) %>
    </tbody>
  </table></div>
  <% } %>
</section>
<% }) %>

<% children.forEach(c => { const fold = def.key === 'councils'; const heading = `${c.title ? c.title : def.key === 'landlords' && c.def.key === 'properties' ? 'Properties owned' : def.key === 'councils' && c.def.key === 'properties' ? 'Properties in this council' : c.def.plural}`; %>
<% if (fold) { %><details class="card fold" id="council-properties"><summary><h2><%= heading %> <span class="count"><%= c.rows.length %></span></h2></summary><% } else { %><section class="card"><% } %>
  <div class="card-head">
    <% if (!fold) { %><h2><%= heading %> <span class="count"><%= c.rows.length %></span></h2><% } else { %><span></span><% } %>
    <% if (def.key === 'properties' && c.def.key === 'tenancies') { %>
      <a class="btn small" href="/app/properties/<%= row.id %>/add-tenant">+ Add tenant</a>
    <% } else { %>
      <a class="btn small" href="/app/<%= c.def.key %>/new?<%= c.fk %>=<%= row.id %>">+ Add <%= c.def.singular.toLowerCase() %></a>
    <% } %>
  </div>
  <% if (!c.rows.length) { %><p class="muted">None yet.</p><% } else { %>
    <%- include('partials/table', { def: c.def, rows: c.rows, maps: c.maps, hideField: c.fk, endTenancy: def.key === 'properties' && c.def.key === 'tenancies', editRows: def.key === 'tenants' && c.def.key === 'tenancies' }) %>
  <% } %>
<% if (fold) { %></details><% } else { %></section><% } %>
<% }) %>
<% if (typeof callNotes !== 'undefined' && callNotes) { %>
<details class="card fold" id="call-notes" open>
  <summary><h2>Tenant calls <span class="count"><%= callNotes.notes.length %></span></h2></summary>
  <form method="post" action="/app/properties/<%= row.id %>/notes" class="call-note-form" data-no-keep>
    <%- include('partials/csrf') %>
    <div class="field"><label for="cn-date">Date</label><input id="cn-date" type="date" name="note_date" value="<%= today %>" required></div>
    <div class="field"><label for="cn-by">Added by</label><select id="cn-by" name="added_by"><% callNotes.people.forEach(o => { %><option value="<%= o.id %>" <%= o.id === callNotes.me ? 'selected' : '' %>><%= o.label %></option><% }) %></select></div>
    <div class="field wide"><label for="cn-body">Note</label><textarea id="cn-body" name="body" rows="3" maxlength="5000" required placeholder="Who called, what about, what was agreed…"></textarea></div>
    <div class="form-actions wide"><button class="btn primary" type="submit">Add note</button></div>
  </form>
  <% if (!callNotes.notes.length) { %><p class="muted">No calls noted yet.</p><% } %>
  <% callNotes.notes.forEach(n => { %>
  <div class="call-note">
    <div class="call-note-head"><strong><%= fmt.ukDate(n.note_date) %></strong><span class="muted small"><%= n.added_by_name ? `Added by ${n.added_by_name}` : '' %></span>
      <form method="post" action="/app/properties/<%= row.id %>/notes/<%= n.id %>/delete" class="inline" data-confirm="Remove this note?"><%- include('partials/csrf') %><button class="btn small link" type="submit">Remove</button></form>
    </div>
    <div class="call-note-body pre"><%= n.body %></div>
  </div>
  <% }) %>
</details>
<% } %>
<% if (typeof landlordStatements !== 'undefined' && landlordStatements) { %>
<details class="card fold" id="landlord-statements">
  <summary><h2>Statements <span class="count"><%= landlordStatements.length %></span></h2></summary>
  <% if (!landlordStatements.length) { %><p class="muted">No statements yet. They're made when the rents are calculated on the Rent run.</p><% } else { %>
  <div class="table-wrap"><table>
    <thead><tr><th>Month</th><th class="num">Rent received</th><th class="num">Deductions</th><th class="num">Held</th><th>Emailed</th><th></th></tr></thead>
    <tbody>
    <% landlordStatements.forEach(s => { %><tr><td><a href="/app/monthly/<%= s.id %>"><%= s.monthLabel %></a></td><td class="num"><%= fmt.money(s.rent_pence) %></td><td class="num"><%= fmt.money(s.fees_pence + s.expenses_pence) %></td><td class="num"><strong><%= fmt.money(s.closing_pence) %></strong></td><td><%= s.emailed_at ? fmt.ukDate(s.emailed_at) : 'Not yet' %></td><td class="num"><a class="btn small" href="/app/monthly/<%= s.id %>">View</a></td></tr><% }) %>
    </tbody>
  </table></div>
  <% } %>
</details>
<% } %>
<% if (typeof councilBoxes !== 'undefined' && councilBoxes) { const cb = councilBoxes; %>
<details class="card fold" id="council-database">
  <summary><h2>Council Database <span class="count"><%= cb.live.length %></span></h2></summary>
  <div class="card-head">
    <span></span>
    <div class="actions">
      <a class="btn small" href="/app/councils/<%= row.id %>/database">Open database</a>
      <a class="btn small" href="/app/councils/<%= row.id %>/database.xlsx">Download Excel</a>
    </div>
  </div>
  <% if (!cb.live.length) { %><p class="muted">No live entries yet.<% if (cb.previous) { %> <%= cb.previous %> previous tenant<%= cb.previous === 1 ? '' : 's' %>.<% } %> Add entries in the <a href="/app/councils/<%= row.id %>/database">database</a>.</p><% } else { %>
  <div class="table-wrap"><table>
    <thead><tr><th>Our ref</th><th>Property address</th><th>Client's name</th><th>Date of booking</th><th class="num">Price per night</th><th>Contact number</th></tr></thead>
    <tbody>
    <% cb.live.forEach(e => { %><tr><td><%= e.our_ref || '' %></td><td><%= e.property_address || '' %></td><td><%= e.client_name || '' %></td><td><%= e.booking_date ? fmt.ukDate(e.booking_date) : '' %></td><td class="num"><%= e.price_pence != null ? fmt.money(e.price_pence) : '' %></td><td><%= e.contact_number || '' %></td></tr><% }) %>
    </tbody>
  </table></div>
  <% if (cb.previous) { %><p class="muted small"><%= cb.previous %> previous tenant<%= cb.previous === 1 ? '' : 's' %> in the <a href="/app/councils/<%= row.id %>/database#previous">database</a>.</p><% } %>
  <% } %>
</details>

<details class="card fold" id="council-invoices">
  <summary><h2>Council Invoices <span class="count"><%= cb.invoices.length %></span></h2></summary>
  <p class="muted">No council invoices yet.</p>
</details>
<% } %>
<%- include('partials/footer') %>
