<%- include('partials/header') %>
<% const minus = (v) => v ? '−' + fmt.money(v) : '—'; %>
<header class="page-head">
  <div>
    <h1>Rent roll</h1>
    <p class="muted">Every property for <%= monthLabel %>: rent due, rent received, fees and costs deducted, and what's left for the landlord.</p>
  </div>
  <form method="get" class="inline-form">
    <input type="month" name="month" value="<%= month %>" aria-label="Month">
    <select name="landlord_id" aria-label="Landlord">
      <option value="">All landlords</option>
      <% landlords.forEach(l => { %><option value="<%= l.id %>" <%= landlord && landlord.id === l.id ? 'selected' : '' %>><%= l.label %></option><% }) %>
    </select>
    <button class="btn" type="submit">Show</button>
  </form>
</header>
<% if (flash) { %><div class="notice ok"><%= flash %></div><% } %>

<section class="tiles">
  <div class="tile"><span class="label">Rent due</span><span class="value"><%= fmt.money(roll.totals.rent) %></span><span class="sub"><%= roll.totals.let %> of <%= roll.rows.length %> propert<%= roll.rows.length === 1 ? 'y' : 'ies' %> let</span></div>
  <div class="tile"><span class="label">Rent received</span><span class="value"><%= fmt.money(roll.totals.received) %></span><span class="sub">of <%= fmt.money(roll.totals.charged) %> charged</span></div>
  <div class="tile"><span class="label">Deductions</span><span class="value"><%= minus(roll.totals.fees + roll.totals.expenses) %></span><span class="sub">Fees <%= fmt.money(roll.totals.fees) %> · Costs <%= fmt.money(roll.totals.expenses) %></span></div>
  <div class="tile"><span class="label">Net for landlords</span><span class="value"><%= fmt.money(roll.totals.net) %></span><span class="sub">received minus deductions</span></div>
  <div class="tile <%= roll.totals.outstanding ? 'alert' : '' %>"><span class="label">Still owed by tenants</span><span class="value"><%= fmt.money(roll.totals.outstanding) %></span><span class="sub">charged but not received</span></div>
</section>

<section class="card">
  <div class="card-head">
    <h2><%= monthLabel %><%= landlord ? ' · ' + landlord.name : '' %></h2>
    <form method="post" action="/app/rent/raise">
      <%- include('partials/csrf') %>
      <input type="hidden" name="month" value="<%= month %>">
      <input type="hidden" name="back" value="rent-roll">
      <button class="btn small" type="submit" title="Charge this month's rent to every active tenancy. Tenancies already charged are skipped.">Raise rent charges for <%= month %></button>
    </form>
  </div>
  <% if (!roll.rows.length) { %><p class="muted">No properties yet.</p><% } else { %>
  <div class="table-wrap"><table class="rent-roll">
    <thead><tr>
      <th>Property</th><th>Landlord</th><th>Tenant</th>
      <th class="num">Rent due</th><th class="num">Received</th><th class="num">Fees</th><th class="num">Costs</th><th class="num">Net</th><th class="num">Owed</th>
    </tr></thead>
    <tbody>
    <% roll.rows.forEach(r => { %>
      <tr>
        <td><a href="/app/properties/<%= r.id %>"><%= r.address_line1 %></a></td>
        <td><% if (r.landlord_id) { %><a href="/app/landlords/<%= r.landlord_id %>"><%= r.landlord_name %></a><% if (r.landlord_code) { %> <span class="muted small"><%= r.landlord_code %></span><% } %><% } else { %><span class="muted">—</span><% } %></td>
        <td><%= r.tenants.length ? r.tenants.join(', ') : '' %><% if (!r.tenants.length) { %><span class="badge s-vacant">vacant</span><% } %></td>
        <td class="num"><%= r.rent ? fmt.money(r.rent) : '—' %></td>
        <td class="num"><%= r.received ? fmt.money(r.received) : '—' %></td>
        <td class="num"><%= minus(r.fees) %></td>
        <td class="num"><%= minus(r.expenses) %></td>
        <td class="num"><strong><%= fmt.money(r.net) %></strong></td>
        <td class="num"><% if (r.outstanding) { %><span class="badge bad"><%= fmt.money(r.outstanding) %></span><% } else { %>—<% } %></td>
      </tr>
    <% }) %>
      <tr class="total">
        <td colspan="3">Total</td>
        <td class="num"><%= fmt.money(roll.totals.rent) %></td>
        <td class="num"><%= fmt.money(roll.totals.received) %></td>
        <td class="num"><%= minus(roll.totals.fees) %></td>
        <td class="num"><%= minus(roll.totals.expenses) %></td>
        <td class="num"><%= fmt.money(roll.totals.net) %></td>
        <td class="num"><%= fmt.money(roll.totals.outstanding) %></td>
      </tr>
    </tbody>
  </table></div>
  <p class="muted small">Rent due is each tenancy's monthly rent (weekly rents × 52 ÷ 12). Net is rent received minus management fees and costs, the same as on the monthly statements. Costs not linked to a property aren't included here; they appear on the landlord's statement.</p>
  <% } %>
</section>
<%- include('partials/footer') %>
