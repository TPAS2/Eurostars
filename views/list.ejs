<%- include('partials/header') %>
<header class="page-head">
  <h1><%= def.plural %></h1>
  <div class="actions">
    <% if (searchable && !def.searchBar) { %>
    <form method="get" class="search"><% if (typeof monthView !== 'undefined' && monthView) { %><input type="hidden" name="month" value="<%= monthView.month %>"><% } %><input type="search" name="q" value="<%= q %>" placeholder="Search <%= def.plural.toLowerCase() %>…"></form>
    <% } %>
    <% if (def.key === 'maintenance') { %><a class="btn" href="/app/maintenance/job-sheet.pdf" download>Blank job sheet (PDF)</a><% } %>
    <% if (def.key === 'inspections') { %><a class="btn" href="/app/inspections/sheet.pdf" download>Blank inspection sheet (PDF)</a><% } %>
    <% if (def.key === 'contractors') { %>
    <div class="transfer-box" title="Use the same contractors in another agency: export here, then import there">
      <a class="btn small" href="/app/contractors/export.csv" download>Export</a>
      <form method="post" action="/app/contractors/import" enctype="multipart/form-data" class="inline-form" data-busy="Importing">
        <%- include('partials/csrf') %>
        <label class="btn small">Import<input type="file" name="file" accept=".csv,text/csv" data-autosubmit hidden></label>
      </form>
    </div>
    <% } %>
    <a class="btn primary" href="/app/<%= def.key %>/new">+ Add <%= def.singular.toLowerCase() %></a>
  </div>
</header>
<% if (searchable && def.searchBar) { %>
<form method="get" class="search-bar" role="search">
  <input type="search" name="q" value="<%= q %>" placeholder="Search <%= def.plural.toLowerCase() %>…" aria-label="Search <%= def.plural.toLowerCase() %>">
  <button class="btn primary" type="submit">Search</button>
  <% if (q) { %><a class="btn" href="/app/<%= def.key %>">Clear</a><% } %>
</form>
<% if (q) { %><p class="muted small search-count"><%= rows.length %><%= truncated ? '+' : '' %> result<%= rows.length === 1 ? '' : 's' %> for “<%= q %>”</p><% } %>
<% } %>
<% if (typeof rentTotals !== 'undefined' && rentTotals) { %>
<div class="rent-totals" aria-label="Rent totals">
  <% rentTotals.forEach(([label, value, note, tone]) => { %><div class="<%= tone ? 'rt-' + tone : '' %>"><span><%= label %></span><strong><%= value %></strong><% if (note) { %><small><%= note %></small><% } %></div><% }) %>
</div>
<% } %>
<% if (typeof flash !== 'undefined' && flash) { %><div class="notice ok"><%= flash %></div><% } %>
<% if (typeof error !== 'undefined' && error) { %><div class="notice err"><%= error %></div><% } %>
<% if (typeof tenantFilter !== 'undefined' && tenantFilter) { %>
<nav class="tabs page-tabs">
  <% [['current', 'Current'], ['past', 'Past'], ['all', 'All']].forEach(([k, label]) => { %><a href="/app/tenants?show=<%= k %><%= q ? '&q=' + encodeURIComponent(q) : '' %>" class="<%= tenantFilter === k ? 'active' : '' %>"><%= label %></a><% }) %>
</nav>
<% } %>
<% if (typeof monthView !== 'undefined' && monthView) { const mv = monthView; %>
<%- include('partials/month-nav', { base: `/app/${def.key}`, month: mv.month, prev: mv.prev, next: mv.next, thisMonth: mv.thisMonth, keep: q ? { q } : {}, allowAll: true }) %>
<section class="tiles">
  <% if (mv.inMonth && mv.kind === 'inspections') { %>
  <div class="tile"><span class="label">Inspections · <%= mv.monthLabel %></span><span class="value"><%= mv.inMonth.n %></span><span class="sub"><%= mv.inMonth.n === 1 ? 'inspection' : 'inspections' %></span></div>
  <div class="tile ok"><span class="label">Good</span><span class="value"><%= mv.inMonth.good %></span><span class="sub">from <%= mv.monthLabel %></span></div>
  <div class="tile <%= mv.inMonth.fair ? 'warn' : '' %>"><span class="label">Fair</span><span class="value"><%= mv.inMonth.fair %></span><span class="sub">from <%= mv.monthLabel %></span></div>
  <div class="tile <%= mv.inMonth.poor ? 'alert' : '' %>"><span class="label">Poor</span><span class="value"><%= mv.inMonth.poor %></span><span class="sub">from <%= mv.monthLabel %></span></div>
  <a class="tile" href="/app/<%= def.key %>?month=all"><span class="label">Every month</span><span class="value">All</span><span class="sub">Show all inspections</span></a>
  <% } else if (mv.inMonth) { %>
  <div class="tile"><span class="label">Reported · <%= mv.monthLabel %></span><span class="value"><%= mv.inMonth.n %></span><span class="sub"><%= mv.inMonth.n === 1 ? 'job' : 'jobs' %></span></div>
  <div class="tile <%= mv.inMonth.open ? 'warn' : '' %>"><span class="label">Outstanding</span><span class="value"><%= mv.inMonth.open %></span><span class="sub">from <%= mv.monthLabel %></span></div>
  <div class="tile ok"><span class="label">Completed jobs</span><span class="value"><%= mv.inMonth.done %></span><span class="sub">from <%= mv.monthLabel %></span></div>
  <div class="tile"><span class="label">Cost · <%= mv.monthLabel %></span><span class="value"><%= fmt.money(mv.inMonth.cost) %></span><span class="sub">&nbsp;</span></div>
  <a class="tile <%= mv.olderOpen ? 'warn' : '' %>" href="/app/<%= def.key %>?month=all"><span class="label">Open from earlier months</span><span class="value"><%= mv.olderOpen %></span><span class="sub">Show all months</span></a>
  <% } %>
</section>
<% } %>
<section class="card">
  <% if (!rows.length) { %>
    <p class="muted"><%= q ? 'No matches.' : (typeof monthView !== 'undefined' && monthView && monthView.month !== 'all') ? (monthView.kind === 'inspections' ? `No inspections in ${monthView.monthLabel}.` : `No maintenance jobs reported in ${monthView.monthLabel}.`) : `No ${def.plural.toLowerCase()} yet.` %></p>
  <% } else { %>
    <%- include('partials/table', { rows, hideField: null }) %>
    <% if (truncated) { %><p class="muted small">Showing the first 500. Use search to narrow down.</p><% } %>
  <% } %>
</section>
<%- include('partials/footer') %>
