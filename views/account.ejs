<%- include('partials/header') %>
<header class="page-head">
  <div>
    <h1>My account</h1>
    <p class="muted">
      <% if (acct.is_admin) { %>You can change these details from your admin panel.
      <% } else { %>To change any of these details, contact your <%= appName %> administrator.<% } %>
    </p>
  </div>
  <% if (acct.is_admin) { %><div class="actions"><a class="btn primary" href="/admin/users/<%= acct.company_id %>#details">Edit in admin panel</a></div><% } %>
</header>

<section class="card">
  <dl class="details">
    <div><dt>Username</dt><dd><code><%= acct.username %></code></dd></div>
    <% if (acct.login_name) { %><div><dt>Your name (sign-in)</dt><dd><code><%= acct.login_name %></code></dd></div><% } %>
    <div><dt>Password</dt><dd>••••••••</dd></div>
    <div><dt>Account since</dt><dd><%= fmt.ukDate(acct.created_at) %></dd></div>
    <div><dt>Your name</dt><dd><%= acct.name %></dd></div>
    <div><dt>Company name</dt><dd><%= acct.agency_name %></dd></div>
    <div><dt>Email</dt><dd><%= acct.email || '—' %></dd></div>
    <div><dt>Phone</dt><dd><%= acct.phone || '—' %></dd></div>
  </dl>
</section>
<section class="card" id="install">
  <h2>Use <%= appName %> as an app</h2>
  <p class="muted" data-installed hidden>You're using <%= appName %> as an app on this device.</p>
  <div data-install hidden>
    <p>Add <%= appName %> to this device so it opens in its own window, like any other app. It always loads the latest version.</p>
    <button class="btn primary" type="button" data-install-button>Install <%= appName %></button>
  </div>
  <div data-install-help>
    <p>Your browser will offer to add <%= appName %> as an app:</p>
    <ul class="install-steps">
      <li><strong>iPhone or iPad (Safari):</strong> tap the Share button, then <em>Add to Home Screen</em>.</li>
      <li><strong>Android (Chrome):</strong> open the menu (⋮), then <em>Install app</em>.</li>
      <li><strong>Windows or Mac (Chrome or Edge):</strong> click the install icon at the right of the address bar, or open the menu and choose <em>Install <%= appName %></em>.</li>
    </ul>
  </div>
  <p class="muted small">Nothing is stored on the device: your details stay safely on the server, and you need an internet connection to use it.</p>
</section>
<%- include('partials/footer') %>
