<%- include('../partials/header') %>
<header class="page-head">
  <div>
    <a class="crumb" href="<%= inv ? '/app/landlord-invoices/' + inv.id : '/app/landlord-invoices' %>">← <%= inv ? inv.invoice_number : 'Landlord invoices' %></a>
    <h1><%= title %></h1>
  </div>
</header>
<section class="card">
  <% if (Object.keys(errors).length) { %><div class="notice err">Please fix the highlighted fields.</div><% } %>
  <form method="post" action="/app/landlord-invoices<%= inv ? '/' + inv.id : '' %>" class="form-grid" data-draft="landlord-invoice-<%= inv ? inv.id : 'new' %>">
    <%- include('../partials/csrf') %>
    <% const field = (name, label, html, req) => ({ name, label, html, req }); %>
    <div class="field">
      <label for="f-landlord">Landlord <span class="req">*</span></label>
      <select id="f-landlord" name="landlord_id" required>
        <option value="">Choose…</option>
        <% landlords.forEach(l => { %><option value="<%= l.id %>" <%= String(values.landlord_id) === String(l.id) ? 'selected' : '' %>><%= l.name %><%= l.code ? ` (${l.code})` : '' %></option><% }) %>
      </select>
      <% if (errors.landlord_id) { %><div class="field-err"><%= errors.landlord_id %></div><% } %>
    </div>
    <div class="field">
      <label for="f-property">Property <span class="req">*</span></label>
      <select id="f-property" name="property_id" required>
        <option value="">Choose…</option>
        <% properties.forEach(p => { %><option value="<%= p.id %>" <%= String(values.property_id) === String(p.id) ? 'selected' : '' %>><%= p.address_line1 %></option><% }) %>
      </select>
      <% if (errors.property_id) { %><div class="field-err"><%= errors.property_id %></div><% } %>
    </div>
    <div class="field">
      <label for="f-number">Invoice number</label>
      <input id="f-number" name="invoice_number" value="<%= values.invoice_number || (inv ? inv.invoice_number : '') %>" maxlength="30">
      <div class="help">Filled in automatically (LI- and the next number). Change it if you need to.</div>
      <% if (errors.invoice_number) { %><div class="field-err"><%= errors.invoice_number %></div><% } %>
    </div>
    <div class="field">
      <label for="f-amount">Amount (£) <span class="req">*</span></label>
      <input id="f-amount" name="amount" inputmode="decimal" placeholder="0.00" value="<%= values.amount || '' %>" required>
      <% if (errors.amount) { %><div class="field-err"><%= errors.amount %></div><% } %>
    </div>
    <div class="field">
      <label for="f-months">Pay over</label>
      <select id="f-months" name="months" data-instalments>
        <% for (let n = 1; n <= 24; n++) { %><option value="<%= n %>" <%= Number(values.months || 1) === n ? 'selected' : '' %>><%= n === 1 ? 'One payment' : `${n} months` %></option><% } %>
      </select>
      <div class="help" data-instalment-help>Deducted from their rent in one go, or split over several months (one deduction a month from the invoice date).</div>
      <% if (errors.months) { %><div class="field-err"><%= errors.months %></div><% } %>
    </div>
    <div class="field">
      <label for="f-date">Invoice date <span class="req">*</span></label>
      <input id="f-date" type="date" name="invoice_date" value="<%= values.invoice_date || '' %>" required>
      <% if (errors.invoice_date) { %><div class="field-err"><%= errors.invoice_date %></div><% } %>
    </div>
    <div class="field wide">
      <label for="f-desc">Reason for invoice <span class="req">*</span></label>
      <input id="f-desc" name="description" value="<%= values.description || '' %>" placeholder="e.g. Tenant find fee, inventory check, annual inspection" required>
      <% if (errors.description) { %><div class="field-err"><%= errors.description %></div><% } %>
    </div>
    <div class="field wide">
      <label for="f-notes">Description of works</label>
      <textarea id="f-notes" name="notes" rows="3"><%= values.notes || '' %></textarea>
      <% if (errors.notes) { %><div class="field-err"><%= errors.notes %></div><% } %>
    </div>
    <% if (inv) { const ln = (landlords.find(l => String(l.id) === String(values.landlord_id)) || {}).name || 'the landlord'; %>
    <fieldset class="field wide settle-edit">
      <legend>Deduct from landlord’s rent</legend>
      <label class="check"><input type="radio" name="settle" value="deduct" <%= values.settle === 'deduct' ? 'checked' : '' %>> <span><strong>Deduct from <%= ln %>’s rent</strong> <span class="muted small">— on their statement for the month of the date below<%= Number(values.months) > 1 ? ', split over the months chosen above' : '' %>.</span></span></label>
      <label class="check"><input type="radio" name="settle" value="paid" <%= values.settle === 'paid' ? 'checked' : '' %>> <span><strong>Paid by the landlord</strong> <span class="muted small">— nothing is taken from their rent.</span></span></label>
      <label class="check"><input type="radio" name="settle" value="unpaid" <%= values.settle === 'unpaid' ? 'checked' : '' %>> <span><strong>Not settled yet</strong></span></label>
      <label class="settle-date">Date <input type="date" name="settle_date" value="<%= values.settle_date || '' %>"></label>
      <% if (errors.settle_date) { %><div class="field-err"><%= errors.settle_date %></div><% } %>
    </fieldset>
    <% } %>
    <div class="form-actions wide">
      <button class="btn primary" type="submit" name="then" value="save"><%= inv ? 'Save' : 'Create invoice' %></button>
      <% if (!inv) { %><button class="btn primary deduct-btn" type="submit" name="then" value="deduct" title="Takes it off the landlord's rent for the month of the invoice date">Create &amp; deduct from rent</button><% } %>
    </div>
  </form>
</section>
<%- include('../partials/footer') %>
