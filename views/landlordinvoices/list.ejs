<%- include('../partials/header') %>
<header class="page-head with-head-tiles">
  <div class="head-text">
    <h1>Landlord invoices</h1>
    <p class="muted">Invoices you raise to landlords. Deduct them from their rent or mark them paid.</p>
    <div class="actions head-actions"><a class="btn primary" href="/app/landlord-invoices/new">+ New landlord invoice</a></div>
  </div>
  <div class="head-tiles" title="Price to landlord minus price paid to the contractor, on paid contractor invoices charged to a landlord">
    <div class="mini-tile"><span class="label">Profit from invoices · <%= profit.monthLabel %></span><span class="value <%= profit.month.profit > 0 ? 'ok-text' : profit.month.profit < 0 ? 'bad-text' : '' %>" id="profit-month"><%= fmt.money(profit.month.profit) %></span></div>
    <div class="mini-tile"><span class="label">Profit from invoices · all time</span><span class="value <%= profit.all.profit > 0 ? 'ok-text' : profit.all.profit < 0 ? 'bad-text' : '' %>" id="profit-all"><%= fmt.money(profit.all.profit) %></span></div>
  </div>
</header>
<% if (flash) { %><div class="notice ok"><%= flash %></div><% } %>
<%- include('../partials/month-nav', { base: '/app/landlord-invoices', keep: status === 'all' ? {} : { status }, allowAll: true }) %>

<section class="tiles centered-tiles">
  <% if (monthTotals) { %><a class="tile <%= monthTotals.unpaid_n ? 'warn' : '' %>" href="/app/landlord-invoices?month=<%= month %>&status=unpaid"><span class="label">Unpaid · <%= monthLabel %></span><span class="value"><%= fmt.money(monthTotals.unpaid) %></span><span class="sub"><%= monthTotals.unpaid_n %> invoice<%= monthTotals.unpaid_n === 1 ? '' : 's' %></span></a><% } %>
  <a class="tile <%= totals.unpaid_n ? 'warn' : '' %>" href="/app/landlord-invoices?status=unpaid&month=all"><span class="label">Unpaid · all months</span><span class="value"><%= fmt.money(totals.unpaid) %></span><span class="sub"><%= totals.unpaid_n %> invoice<%= totals.unpaid_n === 1 ? '' : 's' %><%= totals.overdue ? ` · ${fmt.money(totals.overdue)} past due` : '' %></span></a>
  <% if (monthTotals) { %><a class="tile ok" href="/app/landlord-invoices?month=<%= month %>&status=paid"><span class="label">Paid · <%= monthLabel %></span><span class="value"><%= fmt.money(monthTotals.paid) %></span><span class="sub"><%= monthTotals.paid_n %> invoice<%= monthTotals.paid_n === 1 ? '' : 's' %></span></a><% } %>
</section>

<section class="card">
  <nav class="tabs">
    <% [['all', 'All'], ['unpaid', 'Unpaid'], ['paid', 'Paid']].forEach(([k, label]) => { %>
      <a href="/app/landlord-invoices?<%= new URLSearchParams(Object.assign({ month }, k === 'all' ? {} : { status: k })) %>" class="<%= status === k ? 'active' : '' %>"><%= label %></a>
    <% }) %>
  </nav>
  <% if (!invoices.length) { %><p class="muted">No landlord invoices <%= month === 'all' ? 'here' : 'for ' + monthLabel %>.</p><% } else { %>
  <div class="table-wrap"><table class="clickable">
    <thead><tr><th>Invoice</th><th>Landlord</th><th>Property</th><th>Date</th><th>For</th><th class="num">Amount</th><th>Status</th><th>Deducted</th><th></th></tr></thead>
    <tbody>
    <% invoices.forEach(i => { const overdue = i.status === 'unpaid' && i.due_date && i.due_date < today; const link = statementLink(i); %>
      <tr data-href="/app/landlord-invoices/<%= i.id %>">
        <td><a href="/app/landlord-invoices/<%= i.id %>"><strong><%= i.invoice_number %></strong></a></td>
        <td><a href="/app/landlords/<%= i.landlord_id %>"><%= i.landlord_name %></a></td>
        <td><% if (i.property_id) { %><a href="/app/properties/<%= i.property_id %>"><%= i.address_line1 %></a><% } %></td>
        <td><%= fmt.ukDate(i.invoice_date) %></td>
        <td><%= i.description %></td>
        <td class="num"><%= fmt.money(i.amount_pence) %></td>
        <td><% if (i.status === 'paid') { %><span class="badge s-active plain"><%= i.paid_how === 'Deducted from rent' ? 'Deducted' : i.paid_how === 'Paid by us' ? 'Paid by us' : 'Paid' %> <%= fmt.ukDate(i.paid_date) %></span><% } else if (overdue) { %><span class="badge bad plain">Overdue</span><% } else { %><span class="badge warn plain">Unpaid</span><% } %></td>
        <td><% if (i.txn_id) { %><span class="yes-no yes">Yes</span><% if (link) { %> <a class="small" href="<%= link %>">View statement</a><% } %><% } else { %><span class="yes-no no">No</span><% } %></td>
        <td class="num"><a class="btn small" href="/app/landlord-invoices/<%= i.id %>/edit">Edit</a></td>
      </tr>
    <% }) %>
    </tbody>
  </table></div>
  <% } %>
</section>
<%- include('../partials/footer') %>
