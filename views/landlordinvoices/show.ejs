<%- include('../partials/header') %>
<% const overdue = inv.status === 'unpaid' && inv.due_date && inv.due_date < today; const link = statementLink(inv); %>
<header class="page-head no-print">
  <div>
    <a class="crumb" href="/app/landlord-invoices">← Landlord invoices</a>
    <h1><%= inv.invoice_number %> · <%= fmt.money(inv.amount_pence) %></h1>
    <p class="muted"><%= inv.landlord_name %> ·
      <% if (inv.status === 'paid') { %><span class="badge s-active plain"><%= inv.paid_how %> <%= fmt.ukDate(inv.paid_date) %></span><% } else if (overdue) { %><span class="badge bad plain">Overdue</span><% } else { %><span class="badge warn plain">Unpaid</span><% } %>
      <% if (inv.emailed_at) { %><span class="muted small">· emailed <%= fmt.ukDateTime(inv.emailed_at) %></span><% } %>
    </p>
  </div>
  <div class="actions">
    <a class="btn primary" href="/app/landlord-invoices/<%= inv.id %>/invoice.pdf">Download invoice</a>
    <button class="btn" type="button" data-print>Print</button>
    <% if (emailEnabled && inv.landlord_email) { %>
    <form method="post" action="/app/landlord-invoices/<%= inv.id %>/email" data-busy="Sending…" data-confirm="Email <%= inv.invoice_number %> to <%= inv.landlord_email %>?">
      <%- include('../partials/csrf') %><button class="btn" type="submit">Email to landlord</button>
    </form>
    <% } %>
    <a class="btn" href="/app/landlord-invoices/<%= inv.id %>/edit">Edit</a>
    <form method="post" action="/app/landlord-invoices/<%= inv.id %>/delete" data-confirm="Delete <%= inv.invoice_number %>?<%= inv.txn_id ? ' The deduction from the landlord\'s rent will be removed too.' : '' %>">
      <%- include('../partials/csrf') %><button class="btn danger" type="submit">Delete</button>
    </form>
  </div>
</header>
<% if (flash) { %><div class="notice ok no-print"><%= flash %></div><% } %>
<% if (error) { %><div class="notice err no-print"><%= error %></div><% } %>

<% if (schedule) { %>
<section class="card no-print">
  <h2>Paid over <%= inv.months %> months</h2>
  <p class="muted small"><%= inv.txn_id ? 'Taken off their rent one month at a time:' : 'When deducted, it comes off their rent one month at a time, starting from the date you choose:' %></p>
  <div class="table-wrap"><table class="centered">
    <thead><tr><th>Payment</th><th>Month</th><th class="num">Amount</th><% if (inv.txn_id) { %><th>Status</th><% } %></tr></thead>
    <tbody>
    <% schedule.forEach(p => { %><tr><td><%= p.n %> of <%= inv.months %></td><td><%= p.month %></td><td class="num"><%= fmt.money(p.pence) %></td><% if (inv.txn_id) { %><td><span class="badge plain <%= p.done ? 's-active' : 'warn' %>"><%= p.done ? 'Deducted' : 'Due' %></span></td><% } %></tr><% }) %>
    </tbody>
  </table></div>
</section>
<% } %>

<% if (inv.status === 'unpaid') { %>
<section class="card no-print">
  <h2>Settle this invoice</h2>
  <form method="post" action="/app/landlord-invoices/<%= inv.id %>/settle" class="settle-form">
    <%- include('../partials/csrf') %>
    <label class="check"><input type="radio" name="how" value="deduct" checked> <span><strong>Deduct from <%= inv.landlord_name %>'s rent</strong><br><span class="muted small">Shows as a deduction on their statement for the month of this date.</span></span></label>
    <label class="check"><input type="radio" name="how" value="paid"> <span><strong>Paid by the landlord</strong><br><span class="muted small">They paid you directly; nothing is taken from their rent.</span></span></label>
    <label>Date <input type="date" name="date" value="<%= today %>" required></label>
    <button class="btn primary" type="submit">Settle <%= fmt.money(inv.amount_pence) %></button>
  </form>
</section>
<% } else { %>
<section class="card no-print">
  <div class="settled">
    <div><strong><%= inv.paid_how %></strong> on <%= fmt.ukDate(inv.paid_date) %>.
      <% if (inv.txn_id) { %>Deducted: <span class="yes-no yes">Yes</span><% if (link) { %> · <a href="<%= link %>">View statement</a><% } %><% } else { %>Deducted: <span class="yes-no no">No</span><% } %>
    </div>
    <form method="post" action="/app/landlord-invoices/<%= inv.id %>/unsettle" data-confirm="Undo? <%= inv.txn_id ? 'The deduction from their rent will be removed.' : '' %>">
      <%- include('../partials/csrf') %><button class="btn small" type="submit">Undo</button>
    </form>
  </div>
</section>
<% } %>

<% const c = doc.company; const addr = String(c.address || '').split(/\r?\n/).map(l => l.trim()).filter(Boolean).join(', '); const d = doc.date ? longDate(doc.date) : null; %>
<section class="card lodge-sheet">
  <div class="lodge-page">
    <div class="lodge-name"><%= String(c.name || '').toUpperCase() %></div>
    <div class="lodge-sub">(Maintenance Invoice)</div>
    <% if (addr) { %><div class="lodge-addr"><%= addr %></div><% } %>
    <div class="lodge-contact"><% if (c.phone) { %>Tel: <%= c.phone %> <% } %><% if (c.email) { %>Email: <a href="mailto:<%= c.email %>"><%= c.email %></a><% } %></div>
    <div class="lodge-box lodge-row"><strong>Date:</strong><span><% if (d) { %><%= d.day %><sup><%= d.suffix %></sup> <%= d.rest %><% } %></span></div>
    <div class="lodge-box lodge-row"><span><strong>Client</strong>:</span><span><%= doc.client %></span></div>
    <div class="lodge-box lodge-row lodge-prop"><strong>Property Address:</strong><span><% doc.property.forEach(l => { %><strong><%= l %></strong><br><% }) %></span></div>
    <div class="lodge-box lodge-main">
      <div class="lodge-invoice">INVOICE</div>
      <ul><% doc.items.forEach(i => { %><li><%= i %></li><% }) %></ul>
      <% if (doc.note) { %><div class="lodge-note"><%= doc.note %></div><% } %>
    </div>
    <div class="lodge-box lodge-total"><strong>TOTAL</strong><strong><%= fmt.money(doc.totalPence) %></strong></div>
  </div>
</section>
<%- include('../partials/footer') %>
