<%- include('partials/header') %>
<header class="page-head">
  <div>
    <h1>Rent run</h1>
    <p class="muted">Month end in five steps: calculate the rents, email every landlord their statement, check the report, email it, and the payment instruction to pay the landlords.</p>
  </div>
  <form method="get" data-autogo class="inline-form">
    <input type="month" name="month" value="<%= month %>" aria-label="Month">
    <noscript><button class="btn" type="submit">Show</button></noscript>
  </form>
</header>
<% if (flash) { %><div class="notice ok"><%= flash %></div><% } %>
<% if (error) { %><div class="notice err"><%= error %></div><% } %>
<% const byEmail = rows.filter(r => r.statement_type !== 'Cheque'); const byCheque = rows.length - byEmail.length; const withEmail = byEmail.filter(r => r.email).length; const emailed = rows.filter(r => r.emailed_at).length; const generated = rows.filter(r => r.id).length; %>

<section class="card" id="month-end">
  <div class="card-head"><h2><%= monthLabel %></h2></div>
  <ol class="monthend">
    <li>
      <div><strong>Calculate rents</strong><p class="muted small">Charges each active tenancy's rent for <%= monthLabel %> (any already charged are skipped), then works out every landlord's statement: rent received, minus management fees and costs.</p></div>
      <form method="post" action="/app/monthly/calculate" data-busy="Calculating… this can take a minute.">
        <%- include('partials/csrf') %><input type="hidden" name="month" value="<%= month %>">
        <button class="btn primary" type="submit" <%= rows.length ? '' : 'disabled' %>>Calculate all rents</button>
      </form>
    </li>
    <li>
      <div><strong>Email landlords</strong><p class="muted small">
        Sends each landlord whose statement type is Email their <%= monthLabel %> statement. <%= withEmail %> of <%= byEmail.length %> ha<%= byEmail.length === 1 ? 's' : 've' %> an email address<%= emailed ? ` · ${emailed} already emailed` : '' %>.<% if (byCheque) { %> <%= byCheque %> paid by cheque <%= byCheque === 1 ? 'is' : 'are' %> left out: print their statements below.<% } %>
        <% if (!emailEnabled) { %><br><strong class="warn-text">Email isn't set up yet.</strong> Your administrator needs to add the email settings.<% } %>
      </p></div>
      <div class="step-actions">
        <form method="post" action="/app/monthly/email" data-busy="Sending emails…" data-confirm="Email <%= monthLabel %> statements to <%= withEmail %> landlord<%= withEmail === 1 ? '' : 's' %>?">
          <%- include('partials/csrf') %><input type="hidden" name="month" value="<%= month %>">
          <% if (emailed) { %><label class="check small"><input type="checkbox" name="skip_sent" value="1" checked> Skip those already emailed</label><% } %>
          <button class="btn primary" type="submit" <%= emailEnabled && withEmail ? '' : 'disabled' %>>Email all landlords</button>
        </form>
        <button class="btn" type="button" data-toggle="#sender-settings" aria-controls="sender-settings" aria-expanded="false">Edit sender</button>
      </div>
      <div class="sender-now muted small">From: <strong><%= sender.fromName %></strong> &lt;<%= sender.from || sender.defaults.from || 'not set' %>&gt;<% if (sender.replyTo) { %> · replies to <%= sender.replyTo %><% } %></div>
      <form method="post" action="/app/monthly/email/settings" id="sender-settings" class="sender-settings form-grid" hidden data-no-keep>
        <%- include('partials/csrf') %><input type="hidden" name="month" value="<%= month %>">
        <div class="field">
          <label for="s-from">Send from (email)</label>
          <input id="s-from" name="from_email" type="email" value="<%= sender.saved.from %>" placeholder="<%= sender.defaults.from || 'e.g. statements@youragency.co.uk' %>">
          <div class="help">Must be on a domain verified with your email service (Resend). Leave blank for <%= sender.defaults.from || 'the default' %>.</div>
        </div>
        <div class="field">
          <label for="s-name">Sender name</label>
          <input id="s-name" name="from_name" value="<%= sender.saved.name %>" maxlength="80" placeholder="<%= sender.defaults.name %>">
          <div class="help">What landlords see as who it's from.</div>
        </div>
        <div class="field">
          <label for="s-reply">Replies go to</label>
          <input id="s-reply" name="reply_to" type="email" value="<%= sender.saved.replyTo %>" placeholder="<%= sender.defaults.replyTo || 'e.g. office@gmail.com' %>">
          <div class="help">Any address, Gmail is fine. Leave blank for your account email.</div>
        </div>
        <div class="form-actions wide"><button class="btn primary" type="submit">Save sender</button></div>
      </form>
    </li>
    <li>
      <div><strong>CFP report</strong><p class="muted small">The Excel workbook of every landlord being paid for <%= monthLabel %>: date, name, amount and landlord code, with the total. Check it in the preview first.</p></div>
      <div class="step-actions">
        <a class="btn" href="/app/monthly/report?month=<%= month %>">Preview report</a>
        <a class="btn primary <%= generated ? '' : 'disabled' %>" href="/app/monthly/report.xlsx?month=<%= month %>" <%- generated ? '' : 'aria-disabled="true" tabindex="-1"' %>>Download Excel</a>
      </div>
    </li>
    <li>
      <div><strong>Email the report</strong><p class="muted small">Sends the same CFP report, as the Excel workbook attached.</p></div>
      <a class="btn" href="/app/monthly/report?month=<%= month %>&step=4">Preview report</a>
      <form method="post" action="/app/monthly/report/email" class="step-email" data-busy="Sending…">
        <%- include('partials/csrf') %><input type="hidden" name="month" value="<%= month %>">
        <input type="email" name="to" value="<%= reportTo %>" placeholder="name@example.com" aria-label="Send the report to" required>
        <button class="btn primary" type="submit" <%= emailEnabled && generated ? '' : 'disabled' %>>Email report</button>
      </form>
    </li>
  </ol>
</section>

<section class="card step5" id="payment-instruction">
  <div class="card-head">
    <h2><span class="step-no">5</span> Metro Bank Bulk Payment Instruction</h2>
    <div class="step-actions">
      <button class="btn small" type="button" data-toggle="#metro-docs" aria-controls="metro-docs" aria-expanded="false">Previous documents (<%= metroDocs.length %>)</button>
      <a class="btn small blank-form" href="/app/rent-run/metro-blank.pdf" target="_blank" rel="noopener">Blank form</a>
    </div>
  </div>
  <div id="metro-docs" class="metro-docs" hidden>
    <h3>Previous documents</h3>
    <% if (!metroDocs.length) { %><p class="muted small">None yet. Each time you click "Save &amp; open Metro form", a copy is kept here.</p><% } else { %>
    <div class="table-wrap"><table>
      <thead><tr><th>Created</th><th>For</th><th class="num">Total</th><th class="num">Payments</th><th>By</th><th></th></tr></thead>
      <tbody>
      <% metroDocs.forEach(d => { %>
        <tr>
          <td class="nowrap"><%= fmt.ukDateTime(d.created_at) %></td>
          <td><%= d.monthLabel %></td>
          <td class="num"><%= fmt.money(d.total_pence || 0) %></td>
          <td class="num"><%= d.payments %></td>
          <td><%= d.created_by_name || '' %></td>
          <td class="num nowrap">
            <a class="btn small" href="/app/rent-run/documents/<%= d.id %>" target="_blank" rel="noopener">Open</a>
            <a class="btn small" href="/app/rent-run/documents/<%= d.id %>?download=1">Download</a>
            <form method="post" action="/app/rent-run/documents/<%= d.id %>/delete" class="inline" data-confirm="Remove this document?"><%- include('partials/csrf') %><input type="hidden" name="month" value="<%= month %>"><button class="btn small link" type="submit">Remove</button></form>
          </td>
        </tr>
      <% }) %>
      </tbody>
    </table></div>
    <% } %>
  </div>
  <p class="muted small">What goes on Metro's form for <%= monthLabel %>. The totals are worked out from the payments; change anything you need, fill in the blanks, then open the form to print, sign and take to Metro.</p>
  <form method="post" action="/app/rent-run/instruction/form" class="form-grid step5-grid" data-no-keep>
    <%- include('partials/csrf') %><input type="hidden" name="month" value="<%= month %>">
    <h3 class="wide form-subhead">1. Customer details</h3>
    <div class="field wide"><label for="m-store">Store</label><input id="m-store" name="store" value="<%= step5.store %>" placeholder="Metro branch, e.g. Borehamwood"></div>
    <div class="field"><label for="m-name">Account name</label><input id="m-name" name="from_name" value="<%= step5.from_name %>" placeholder="e.g. <%= step5.agencyName %> Client Account"></div>
    <div class="field"><label for="m-contact">Contact name</label><input id="m-contact" name="contact_name" value="<%= step5.contact_name %>"></div>
    <div class="field"><label for="m-acc">Account number</label><input id="m-acc" name="from_account_number" value="<%= step5.from_account_number %>" inputmode="numeric" placeholder="8 digits"></div>
    <h3 class="wide form-subhead">2. Payment details</h3>
    <div class="field"><label for="m-total">Total amount in figures</label><input id="m-total" name="totalFigures" value="<%= step5.totalFigures %>"></div>
    <div class="field"><label for="m-date">Value date</label><input id="m-date" type="date" name="payment_date" value="<%= step5.payment_date %>"></div>
    <div class="field wide"><label for="m-words">Total amount in words</label><input id="m-words" name="totalWords" value="<%= step5.totalWords %>"></div>
    <div class="field"><label for="m-count">Total number of transactions</label><input id="m-count" name="count" value="<%= step5.count %>" inputmode="numeric"></div>
    <h3 class="wide form-subhead">3. Customer signature</h3>
    <div class="field"><label for="m-sig1">Authorised signatory 1</label><input id="m-sig1" name="signatory_1" value="<%= step5.signatory_1 %>" placeholder="Name printed under the signature"></div>
    <div class="field"><label for="m-sig2">Authorised signatory 2 (if applicable)</label><input id="m-sig2" name="signatory_2" value="<%= step5.signatory_2 %>"></div>
    <div class="form-actions wide">
      <button class="btn" type="submit" formaction="/app/rent-run/instruction/preview" formtarget="_blank">Preview document</button>
      <button class="btn" type="submit" name="then" value="save">Save</button>
      <button class="btn primary" type="submit" name="then" value="metro" formtarget="_blank">Save &amp; open Metro form (PDF)</button>
      <% if (step5.saved_at) { %><span class="muted small">Last saved <%= fmt.ukDateTime(step5.saved_at) %></span><% } %>
    </div>
  </form>
</section>

<section class="card">
  <div class="card-head">
    <h2>Landlords</h2>
  </div>
  <% if (!rows.length) { %><p class="muted">Add landlords to start your rent run.</p><% } else { %>
  <div class="table-wrap"><table class="centered">
    <thead><tr><th>Landlord</th><th>Statement type</th><th>Email</th><th class="num">Rent received</th><th class="num">Deductions</th><th class="num">Net</th><th class="num">Held</th><th>Statement emailed</th><th></th></tr></thead>
    <tbody>
    <% rows.forEach(r => { %>
      <tr>
        <td><% if (r.id) { %><a href="/app/monthly/<%= r.id %>"><strong><%= r.name %></strong></a><% } else { %><a href="/app/landlords/<%= r.landlord_id %>"><%= r.name %></a><% } %></td>
        <td><span class="badge <%= r.statement_type === 'Cheque' ? 'warn' : 's-admin' %>"><%= r.statement_type || 'Email' %></span></td>
        <td class="small"><%= r.email || '' %><% if (!r.email && r.statement_type !== 'Cheque') { %><a class="muted" href="/app/landlords/<%= r.landlord_id %>/edit">Add email</a><% } %></td>
        <% if (r.id) { %>
          <td class="num"><%= fmt.money(r.rent_pence) %></td>
          <td class="num"><%= r.fees_pence + r.expenses_pence ? '−' + fmt.money(r.fees_pence + r.expenses_pence) : '—' %></td>
          <td class="num"><strong><%= fmt.money(r.net_pence) %></strong></td>
          <td class="num"><%= fmt.money(r.closing_pence) %></td>
        <% } else { %>
          <td colspan="4" class="muted">Not calculated yet</td>
        <% } %>
        <td class="small"><% if (r.statement_type === 'Cheque' && !r.emailed_at) { %><span class="muted">By cheque</span><% } else if (r.emailed_at) { %><span class="badge s-active">sent</span> <span class="muted"><%= fmt.ukDateTime(r.emailed_at) %></span><% } else { %><span class="muted">Not yet</span><% } %></td>
        <td class="num row-actions">
          <% if (r.statement_type === 'Cheque' && r.id) { %><a class="btn small" href="/app/monthly/<%= r.id %>">Print statement</a><% } %>
          <% if (emailEnabled && r.email && r.statement_type !== 'Cheque') { %>
          <form method="post" action="/app/monthly/email" data-busy="Sending…" data-confirm="Email the <%= monthLabel %> statement to <%= r.name %> (<%= r.email %>)?">
            <%- include('partials/csrf') %>
            <input type="hidden" name="month" value="<%= month %>">
            <input type="hidden" name="landlord_id" value="<%= r.landlord_id %>">
            <button class="btn small" type="submit"><%= r.emailed_at ? 'Email again' : 'Email' %></button>
          </form>
          <% } %>
        </td>
      </tr>
    <% }) %>
    </tbody>
  </table></div>
  <% } %>
</section>
<%- include('partials/footer') %>
