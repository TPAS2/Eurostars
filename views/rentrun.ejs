<%- include('partials/header') %>
<header class="page-head">
  <div>
    <h1>Rent run</h1>
    <p class="muted">Month end: calculate the rents, email every landlord their statement, check and email the Rift report, then the bank transfer sheet, Metro&rsquo;s bulk payment file and the payment instruction to pay the landlords.</p>
  </div>
  <div class="rentrun-month">
    <form method="get" data-autogo class="inline-form">
      <input type="month" name="month" value="<%= month %>" aria-label="Month">
      <noscript><button class="btn" type="submit">Show</button></noscript>
    </form>
    <% if (month === thisMonth) { %><span class="btn disabled" aria-disabled="true">This month</span><% } else { %><a class="btn primary" href="/app/rent-run?month=<%= thisMonth %>">This month</a><% } %>
  </div>
</header>
<% if (flash) { %><div class="notice ok"><%= flash %></div><% } %>
<% if (error) { %><div class="notice err"><%= error %></div><% } %>
<% const byEmail = rows.filter(r => r.statement_type !== 'Cheque'); const byCheque = rows.length - byEmail.length; const withEmail = byEmail.filter(r => r.email).length; const emailed = rows.filter(r => r.emailed_at).length; const generated = rows.filter(r => r.id).length; %>

<section class="card" id="month-end">
  <div class="card-head"><h2><%= monthLabel %></h2></div>
  <ol class="monthend">
    <li>
      <div><strong>Calculate rents</strong><p class="muted small">Charges each active tenancy's rent for <%= monthLabel %> (any already charged are skipped), then works out every landlord's statement: rent received, minus management fees and costs.</p></div>
      <form method="post" action="/app/monthly/calculate" data-busy="Calculating… this can take a minute.">
        <%- include('partials/csrf') %><input type="hidden" name="month" value="<%= month %>">
        <button class="btn primary" type="submit" <%= rows.length ? '' : 'disabled' %>>Calculate all rents</button>
      </form>
    </li>
    <li>
      <div><strong>Email landlords</strong><p class="muted small">
        Sends each landlord whose statement type is Email their <%= monthLabel %> statement. <%= withEmail %> of <%= byEmail.length %> ha<%= byEmail.length === 1 ? 's' : 've' %> an email address<%= emailed ? ` · ${emailed} already emailed` : '' %>.<% if (byCheque) { %> <%= byCheque %> paid by cheque <%= byCheque === 1 ? 'is' : 'are' %> left out: print their statements below.<% } %>
        <% if (!emailEnabled) { %><br><strong class="warn-text">Email isn't set up yet.</strong> Your administrator needs to add the email settings.<% } %>
      </p></div>
      <div class="step-actions">
        <button class="btn" type="button" data-toggle="#sender-settings" aria-controls="sender-settings" aria-expanded="false">Edit sender</button>
        <form method="post" action="/app/monthly/email" data-busy="Sending emails…" data-confirm="Email <%= monthLabel %> statements to <%= withEmail %> landlord<%= withEmail === 1 ? '' : 's' %>?">
          <%- include('partials/csrf') %><input type="hidden" name="month" value="<%= month %>">
          <% if (emailed) { %><label class="check small"><input type="checkbox" name="skip_sent" value="1" checked> Skip those already emailed</label><% } %>
          <button class="btn primary" type="submit" <%= emailEnabled && withEmail ? '' : 'disabled' %>>Email all landlords</button>
        </form>
      </div>
      <div class="sender-now muted small">From: <strong><%= sender.fromName %></strong> &lt;<%= sender.from || sender.defaults.from || 'not set' %>&gt;<% if (sender.replyTo) { %> · replies to <%= sender.replyTo %><% } %></div>
      <form method="post" action="/app/monthly/email/settings" id="sender-settings" class="sender-settings form-grid" hidden data-no-keep>
        <%- include('partials/csrf') %><input type="hidden" name="month" value="<%= month %>">
        <div class="field">
          <label for="s-from">Send from (email)</label>
          <input id="s-from" name="from_email" type="email" value="<%= sender.saved.from %>" placeholder="<%= sender.defaults.from || 'e.g. statements@youragency.co.uk' %>">
          <div class="help">Must be on a domain verified with your email service (Resend). Leave blank for <%= sender.defaults.from || 'the default' %>.</div>
        </div>
        <div class="field">
          <label for="s-name">Sender name</label>
          <input id="s-name" name="from_name" value="<%= sender.saved.name %>" maxlength="80" placeholder="<%= sender.defaults.name %>">
          <div class="help">What landlords see as who it's from.</div>
        </div>
        <div class="field">
          <label for="s-reply">Replies go to</label>
          <input id="s-reply" name="reply_to" type="email" value="<%= sender.saved.replyTo %>" placeholder="<%= sender.defaults.replyTo || 'e.g. office@gmail.com' %>">
          <div class="help">Any address, Gmail is fine. Leave blank for your account email.</div>
        </div>
        <div class="form-actions wide"><button class="btn primary" type="submit">Save sender</button></div>
      </form>
    </li>
    <li>
      <div><strong>Rift report</strong><p class="muted small">The Excel workbook of every landlord being paid for <%= monthLabel %>: date, name, amount and landlord code, with the total. Check it in the preview first.</p>
        <% if (report.rows.length) { %><p class="small"><strong><%= report.landlords %> landlord<%= report.landlords === 1 ? '' : 's' %> to pay · <%= fmt.money(report.total) %></strong></p><% } %>
        <% if (!report.rows.length || gaps.noRent.length || gaps.noLandlord.length) { %>
        <div class="notice warn small pay-gaps">
          <% if (!report.rows.length) { %><p><strong>No landlords to pay for <%= monthLabel %> yet.</strong> Landlords are paid each property’s <em>Rent to landlord</em> when the rents are calculated (step 1).</p><% } %>
          <% if (gaps.noRent.length) { %>
          <p><%= gaps.noRent.length %> propert<%= gaps.noRent.length === 1 ? 'y has' : 'ies have' %> a landlord but no <em>Rent to landlord</em>, so <%= gaps.noRent.length === 1 ? 'its landlord isn’t' : 'their landlords aren’t' %> paid. Fill it in, then calculate the rents again:</p>
          <p class="gap-list"><% gaps.noRent.slice(0, 30).forEach(p => { %><a href="/app/properties/<%= p.id %>/edit"><%= p.code ? `${p.code} · ` : '' %><%= p.address_line1 %></a><% }) %><% if (gaps.noRent.length > 30) { %><span class="muted">and <%= gaps.noRent.length - 30 %> more</span><% } %></p>
          <% } %>
          <% if (gaps.noLandlord.length) { %>
          <p><%= gaps.noLandlord.length %> propert<%= gaps.noLandlord.length === 1 ? 'y has' : 'ies have' %> a <em>Rent to landlord</em> but no landlord chosen:</p>
          <p class="gap-list"><% gaps.noLandlord.slice(0, 30).forEach(p => { %><a href="/app/properties/<%= p.id %>/edit"><%= p.code ? `${p.code} · ` : '' %><%= p.address_line1 %></a><% }) %></p>
          <% } %>
        </div>
        <% } %>
      </div>
      <div class="step-actions">
        <a class="btn" href="/app/monthly/report?month=<%= month %>">Preview report</a>
        <a class="btn primary <%= generated ? '' : 'disabled' %>" href="/app/monthly/report.xlsx?month=<%= month %>" <%- generated ? '' : 'aria-disabled="true" tabindex="-1"' %>>Download Excel</a>
      </div>
    </li>
    <li class="sub" data-step="3.1">
      <div><strong>Email the report</strong><p class="muted small">Sends the same Rift report, as the Excel workbook attached.</p></div>
      <a class="btn" href="/app/monthly/report?month=<%= month %>&step=4">Preview report</a>
      <form method="post" action="/app/monthly/report/email" class="step-email" data-busy="Sending…">
        <%- include('partials/csrf') %><input type="hidden" name="month" value="<%= month %>">
        <input type="email" name="to" value="<%= reportTo %>" placeholder="name@example.com" aria-label="Send the report to" required>
        <button class="btn primary" type="submit" <%= emailEnabled && generated ? '' : 'disabled' %>>Email report</button>
      </form>
    </li>
  </ol>
</section>

<details class="card step5 fold" id="transfer-sheet">
  <summary><h2><span class="step-no">4</span> Bank transfer sheet</h2></summary>
  <p class="muted small">Your Bank Transfer spreadsheet for <%= monthLabel %>, filled in from the Rift report: landlord, LCODE, property, sort code, account number, bank name and amount, with "No payment" for anyone with nothing to pay. It updates whenever the rents are recalculated.</p>
  <div class="bulk-summary">
    <span><strong><%= transferFile.rows.length %></strong> row<%= transferFile.rows.length === 1 ? '' : 's' %></span>
    <span>Total <strong><%= fmt.money(transferFile.total) %></strong></span>
    <% const noPay = transferFile.rows.filter(r => !r.pence).length; if (noPay) { %><span class="muted"><%= noPay %> no payment</span><% } %>
    <% if (transferFile.bankAlerts.length) { %><span class="bad-text strong">⚠ <%= transferFile.bankAlerts.length %> landlord<%= transferFile.bankAlerts.length === 1 ? '' : 's' %> with changed bank details to check</span><% } %>
  </div>
  <div class="form-actions">
    <a class="btn" href="/app/rent-run/transfer?month=<%= month %>">Preview</a>
    <a class="btn primary <%= transferFile.rows.length ? '' : 'disabled' %>" href="/app/rent-run/transfer.xlsx?month=<%= month %>"<%- transferFile.rows.length ? '' : ' aria-disabled="true" tabindex="-1"' %>>Download Excel</a>
  </div>
</details>

<details class="card step5 fold" id="bulk-file">
  <summary><h2><span class="step-no">5</span> Metro Bank bulk payment file</h2></summary>
  <p class="muted small">Metro's bulk payment spreadsheet for <%= monthLabel %>, filled in from the Rift report: sort code, beneficiary name, account, reference and amount for every landlord paid by bank. It updates whenever the rents are recalculated.</p>
  <div class="bulk-summary">
    <span><strong><%= bulkFile.rows.length %></strong> payment<%= bulkFile.rows.length === 1 ? '' : 's' %></span>
    <span>Total <strong><%= fmt.money(bulkFile.total) %></strong></span>
    <% if (bulkFile.problems.length) { %><span class="bad-text"><%= bulkFile.problems.length %> landlord<%= bulkFile.problems.length === 1 ? '' : 's' %> missing bank details</span><% } %>
    <% if (bulkFile.cheques.length) { %><span class="muted"><%= bulkFile.cheques.length %> paid by cheque (not included)</span><% } %>
    <% if (bulkFile.bankAlerts.length) { %><span class="bad-text strong">⚠ <%= bulkFile.bankAlerts.length %> landlord<%= bulkFile.bankAlerts.length === 1 ? '' : 's' %> with changed bank details to check</span><% } %>
  </div>
  <div class="form-actions">
    <a class="btn" href="/app/rent-run/bulk?month=<%= month %>">Preview</a>
    <a class="btn primary <%= bulkFile.rows.length ? '' : 'disabled' %>" href="/app/rent-run/bulk.xlsm?month=<%= month %>"<%- bulkFile.rows.length ? '' : ' aria-disabled="true" tabindex="-1"' %>>Download Excel (.xlsm)</a>
  </div>
</details>

<details class="card step5 fold" id="payment-instruction">
  <summary><h2><span class="step-no">5.1</span> Metro Bank Bulk Payment Instruction</h2></summary>
  <div class="card-head">
    <div class="step-actions">
      <button class="btn small" type="button" data-toggle="#metro-docs" aria-controls="metro-docs" aria-expanded="false">Previous documents (<%= metroDocs.length %>)</button>
      <a class="btn small blank-form" href="/app/rent-run/metro-blank.pdf" target="_blank" rel="noopener">Blank form</a>
    </div>
  </div>
  <div id="metro-docs" class="metro-docs" hidden>
    <h3>Previous documents</h3>
    <% if (!metroDocs.length) { %><p class="muted small">None yet. Each time you click "Save &amp; open Metro form", a copy is kept here.</p><% } else { %>
    <div class="table-wrap"><table>
      <thead><tr><th>Created</th><th>For</th><th class="num">Total</th><th class="num">Payments</th><th>By</th><th></th></tr></thead>
      <tbody>
      <% metroDocs.forEach(d => { %>
        <tr>
          <td class="nowrap"><%= fmt.ukDateTime(d.created_at) %></td>
          <td><%= d.monthLabel %></td>
          <td class="num"><%= fmt.money(d.total_pence || 0) %></td>
          <td class="num"><%= d.payments %></td>
          <td><%= d.created_by_name || '' %></td>
          <td class="num nowrap">
            <a class="btn small" href="/app/rent-run/documents/<%= d.id %>" target="_blank" rel="noopener">Open</a>
            <a class="btn small" href="/app/rent-run/documents/<%= d.id %>?download=1">Download</a>
            <form method="post" action="/app/rent-run/documents/<%= d.id %>/delete" class="inline" data-confirm="Remove this document?"><%- include('partials/csrf') %><input type="hidden" name="month" value="<%= month %>"><button class="btn small link" type="submit">Remove</button></form>
          </td>
        </tr>
      <% }) %>
      </tbody>
    </table></div>
    <% } %>
  </div>
  <div class="presets-bar">
    <label for="preset-pick" class="strong">Preset</label>
    <select id="preset-pick" data-preset-pick>
      <option value="">Choose a preset…</option>
      <% metroPresets.forEach(p => { %><option value="<%= p.id %>" data-preset="<%= JSON.stringify(p.data) %>"><%= p.name %></option><% }) %>
    </select>
    <button class="btn small primary" type="button" data-preset-fill>Fill in</button>
    <button class="btn small" type="button" data-toggle="#preset-manage" aria-controls="preset-manage" aria-expanded="false">Presets (<%= metroPresets.length %>)</button>
  </div>
  <div id="preset-manage" class="metro-docs" hidden>
    <h3>Presets</h3>
    <p class="muted small">Ready-made details (account, contact) to fill the form in one click. Save what's in the boxes below as a new preset, or edit one.</p>
    <% if (metroPresets.length) { %>
    <div class="table-wrap"><table>
      <thead><tr><th>Name</th><th>Account name</th><th>Account number</th><th></th></tr></thead>
      <tbody>
      <% metroPresets.forEach(p => { %><tr>
        <td><strong><%= p.name %></strong></td><td><%= p.data.from_name %></td><td><%= p.data.from_account_number %></td>
        <td class="num nowrap">
          <a class="btn small" href="/app/rent-run/presets/<%= p.id %>/edit?month=<%= month %>">Edit</a>
          <form method="post" action="/app/rent-run/presets/<%= p.id %>/delete" class="inline" data-confirm="Remove the preset <%= p.name %>?"><%- include('partials/csrf') %><input type="hidden" name="month" value="<%= month %>"><button class="btn small link" type="submit">Remove</button></form>
        </td>
      </tr><% }) %>
      </tbody>
    </table></div>
    <% } %>
    <div class="inline-form preset-save">
      <input form="step5-form" name="preset_name" placeholder="New preset name, e.g. Main client account" maxlength="60" aria-label="Preset name">
      <button form="step5-form" class="btn small" type="submit" formaction="/app/rent-run/presets">Save boxes as preset</button>
    </div>
  </div>
  <p class="muted small">What goes on Metro's form for <%= monthLabel %>. The totals are worked out from step 5's bulk payment file; change anything you need, fill in the blanks, then open the form to print, sign and take to Metro.</p>
  <form method="post" action="/app/rent-run/instruction/form" class="form-grid step5-grid" id="step5-form" data-no-keep>
    <%- include('partials/csrf') %><input type="hidden" name="month" value="<%= month %>">
    <h3 class="wide form-subhead">1. Customer details</h3>
    <div class="field"><label for="m-name">Account name</label><input id="m-name" name="from_name" value="<%= step5.from_name %>" placeholder="e.g. <%= step5.agencyName %> Client Account"></div>
    <div class="field"><label for="m-contact">Contact name</label><input id="m-contact" name="contact_name" value="<%= step5.contact_name %>"></div>
    <div class="field"><label for="m-acc">Account number</label><input id="m-acc" name="from_account_number" value="<%= step5.from_account_number %>" inputmode="numeric" placeholder="8 digits"></div>
    <h3 class="wide form-subhead">2. Payment details</h3>
    <div class="field"><label for="m-total">Total amount in figures</label><input id="m-total" name="totalFigures" value="<%= step5.totalFigures %>" inputmode="decimal" placeholder="£0-00" data-money-figures="#m-words"></div>
    <div class="field"><label for="m-date">Value date</label><input id="m-date" type="date" name="payment_date" value="<%= step5.payment_date %>"></div>
    <div class="field wide"><label for="m-words">Total amount in words</label><input id="m-words" name="totalWords" value="<%= step5.totalWords %>"></div>
    <div class="field"><label for="m-count">Total number of transactions</label><input id="m-count" name="count" value="<%= step5.count %>" inputmode="numeric"></div>
    <div class="form-actions wide">
      <button class="btn" type="submit" formaction="/app/rent-run/instruction/preview" formtarget="_blank">Preview document</button>
      <button class="btn" type="submit" name="then" value="save">Save</button>
      <button class="btn primary" type="submit" name="then" value="metro" formtarget="_blank">Save &amp; open Metro form (PDF)</button>
      <% if (step5.saved_at) { %><span class="muted small">Last saved <%= fmt.ukDateTime(step5.saved_at) %></span><% } %>
    </div>
  </form>
</details>

<details class="card step5 fold" id="send-email">
  <summary><h2><span class="step-no">5.2</span> Send an email</h2></summary>
  <p class="muted">Send the bank (or anyone) an email with files attached, such as the Metro bulk payment file and the signed payment instruction.<% if (!emailEnabled) { %> <strong class="warn-text">Email isn’t set up yet.</strong><% } %></p>
  <form method="post" action="/app/rent-run/send-email" enctype="multipart/form-data" class="mail-compose" data-busy="Sending…" data-no-keep>
    <%- include('partials/csrf') %>
    <input type="hidden" name="month" value="<%= month %>">
    <div class="mail-head">
      <label class="mail-row"><span>From</span><input type="email" name="from" value="<%= emailOut.from %>" required maxlength="254" autocomplete="email"></label>
      <label class="mail-row"><span>To</span><input name="to" required maxlength="2000" placeholder="name@example.com" autocomplete="off"></label>
      <label class="mail-row"><span>Cc</span><input name="cc" maxlength="2000" autocomplete="off"></label>
      <label class="mail-row"><span>Bcc</span><input name="bcc" maxlength="2000" autocomplete="off"></label>
      <label class="mail-row"><span>Subject</span><input name="subject" value="<%= emailOut.subject %>" required maxlength="300"></label>
    </div>
    <textarea name="message" rows="10" class="mail-body" placeholder="Write your message…" maxlength="20000"></textarea>
    <div class="mail-foot">
      <button class="btn primary" type="submit" <%= emailEnabled ? '' : 'disabled' %>>Send</button>
      <label class="btn mail-attach"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M21 11.5l-8.5 8.5a5 5 0 0 1-7-7l8.5-8.5a3.5 3.5 0 0 1 5 5L10.5 18a2 2 0 0 1-3-3l7.5-7.5"/></svg> Attach files<input type="file" name="files" multiple hidden data-file-list="#mail-files"></label>
      <span class="muted small" id="mail-files">No files attached</span>
    </div>
  </form>
  <p class="muted small">Separate several addresses with commas. Up to 10 files, 10 MB each. If the From address isn’t on your email service’s domain, the email comes from your usual sending address and replies go to the From address.</p>
  <% if (emailOut.sent.length) { %>
  <h3>Sent for <%= monthLabel %></h3>
  <div class="table-wrap"><table class="centered">
    <thead><tr><th>Sent</th><th>To</th><th>Subject</th><th>Files</th><th>By</th></tr></thead>
    <tbody>
    <% emailOut.sent.forEach(e => { %>
      <tr><td><%= fmt.ukDateTime(e.sent_at) %></td><td><%= e.to_addr %><% if (e.cc) { %><div class="muted small">cc <%= e.cc %></div><% } %></td><td><%= e.subject %></td><td class="small"><%= e.files || '—' %></td><td><%= e.sent_by_name || '' %></td></tr>
    <% }) %>
    </tbody>
  </table></div>
  <% } %>
</details>

<%- include('partials/footer') %>
