<%- include('partials/header') %>
<header class="page-head">
  <div>
    <a class="crumb" href="/app/councils/<%= council.id %>">← <%= council.name %></a>
    <h1><%= council.name %> database</h1>
    <p class="muted">Add entries to <strong>Live</strong>. When one finishes, click <strong>End</strong> to give it a cancellation date and move it to <strong>Previous tenant</strong>.</p>
  </div>
  <div class="actions">
    <a class="btn primary" href="/app/councils/<%= council.id %>/database.xlsx">Download Excel</a>
  </div>
</header>
<% if (flash) { %><div class="notice ok"><%= flash %></div><% } %>
<% if (error) { %><div class="notice err"><%= error %></div><% } %>

<section class="card" id="add-entry">
  <details class="fold" <%= Object.keys(errors).length ? 'open' : '' %>>
    <summary><h2>+ Add entry</h2></summary>
    <% if (errors.form) { %><div class="notice err"><%= errors.form %></div><% } %>
    <form method="post" action="/app/councils/<%= council.id %>/database/entries" class="form-grid three" data-no-keep>
      <%- include('partials/csrf') %>
      <%- include('partials/councildb-fields', { headings, values, errors, skipCancel: true }) %>
      <div class="form-actions wide"><button class="btn primary" type="submit">Add to Live</button></div>
    </form>
  </details>
</section>

<% [['live', 'Live', entries.live, titleRow], ['previous', 'Previous tenant', entries.previous, 'PREVIOUS TENANTS']].forEach(([id, name, list, sheetTitle]) => { %>
<section class="card" id="<%= id %>">
  <div class="card-head"><h2><%= name %> <span class="count"><%= list.length %></span></h2><span class="muted small"><%= sheetTitle %></span></div>
  <div class="table-wrap"><table class="council-db">
    <thead><tr><% headings.forEach(h => { %><th><%= h.label %></th><% }) %><th></th></tr></thead>
    <tbody>
    <% if (!list.length) { %><tr><td colspan="<%= headings.length + 1 %>" class="muted">No entries yet.</td></tr><% } %>
    <% list.forEach(e => { %>
      <tr>
        <% headings.forEach(h => { const v = e[h.key]; %><td><%= v == null || v === '' ? '' : h.date ? fmt.ukDate(v) : h.money ? fmt.money(v) : v %></td><% }) %>
        <td class="db-actions">
          <a class="btn small" href="/app/councils/<%= council.id %>/database/entries/<%= e.id %>/edit">Edit</a>
          <% if (id === 'live') { %>
          <form method="post" action="/app/councils/<%= council.id %>/database/entries/<%= e.id %>/end" class="end-tenancy" data-confirm="End this entry? It moves to Previous tenant with this cancellation date.">
            <%- include('partials/csrf') %>
            <input type="date" name="cancellation_date" value="<%= today %>" aria-label="Cancellation date">
            <button class="btn small danger" type="submit">End</button>
          </form>
          <% } else { %>
          <form method="post" action="/app/councils/<%= council.id %>/database/entries/<%= e.id %>/reopen" class="inline"><%- include('partials/csrf') %><button class="btn small" type="submit">Back to Live</button></form>
          <% } %>
          <form method="post" action="/app/councils/<%= council.id %>/database/entries/<%= e.id %>/delete" class="inline" data-confirm="Remove this entry?"><%- include('partials/csrf') %><button class="btn small link" type="submit">Remove</button></form>
        </td>
      </tr>
    <% }) %>
    </tbody>
  </table></div>
</section>
<% }) %>
<%- include('partials/footer') %>
