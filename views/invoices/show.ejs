<%- include('../partials/header') %>
<% const overdue = inv.status === 'unpaid' && inv.due_date && inv.due_date < today; %>
<header class="page-head">
  <div>
    <a class="crumb" href="/app/invoices">← Invoices</a>
    <h1><%= inv.supplier %> · <%= fmt.money(inv.amount_pence) %></h1>
    <p class="muted">
      <%= inv.invoice_number ? 'Invoice ' + inv.invoice_number + ' · ' : '' %>
      <% if (inv.status === 'paid') { %><span class="badge s-active">paid</span><% } else if (overdue) { %><span class="badge bad">overdue</span><% } else { %><span class="badge warn">unpaid</span><% } %>
    </p>
  </div>
  <div class="actions">
    <a class="btn" href="/app/invoices/<%= inv.id %>/edit">Edit</a>
    <form method="post" action="/app/invoices/<%= inv.id %>/delete" data-confirm="<%= inv.status === 'paid' && inv.payment_txn_id ? 'Delete this paid invoice and its file? The charge to the landlord will be removed too.' : 'Delete this invoice and its file?' %>">
      <%- include('../partials/csrf') %><button class="btn danger" type="submit">Delete</button>
    </form>
  </div>
</header>
<% if (flash) { %><div class="notice ok"><%= flash %></div><% } %>
<% if (error) { %><div class="notice err"><%= error %></div><% } %>

<div class="grid-2">
  <section class="card">
    <h2>Details</h2>
    <dl class="details">
      <div><dt>Contractor</dt><dd><%= inv.supplier %></dd></div>
      <% const toLandlord = inv.landlord_price_pence ?? inv.amount_pence; const profit = toLandlord - inv.amount_pence; %>
      <div><dt>Charge to landlord</dt><dd><span class="badge plain <%= inv.charge_landlord ? 's-active' : '' %>"><%= inv.charge_landlord ? 'Yes' : 'No' %></span></dd></div>
      <div><dt>Price to us</dt><dd><strong><%= fmt.money(inv.amount_pence) %></strong></dd></div>
      <% if (inv.charge_landlord) { %><div><dt>Price to landlord</dt><dd><strong><%= fmt.money(toLandlord) %></strong></dd></div>
      <div><dt>Profit</dt><dd><strong class="<%= profit > 0 ? 'ok-text' : profit < 0 ? 'bad-text' : '' %>"><%= profit < 0 ? '−' + fmt.money(-profit) : fmt.money(profit) %></strong></dd></div><% } %>
      <div><dt>Invoice date</dt><dd><%= fmt.ukDate(inv.invoice_date) || '—' %></dd></div>
      <% if (inv.due_date) { %><div><dt>Due date</dt><dd class="<%= overdue ? 'neg' : '' %>"><%= fmt.ukDate(inv.due_date) %></dd></div><% } %>
      <div><dt>Property</dt><dd><% if (property) { %><a href="/app/properties/<%= property.id %>"><%= property.address_line1 %></a><% } else { %>—<% } %></dd></div>
      <div><dt>Maintenance job</dt><dd><% if (job) { %><a href="/app/maintenance/<%= job.id %>"><%= job.title %></a><% } else { %>—<% } %></dd></div>
      <div><dt>Added by</dt><dd><%= addedBy ? addedBy.name : '—' %></dd></div>
      <div><dt>Landlord</dt><dd><% if (landlord) { %><a href="/app/landlords/<%= landlord.id %>"><%= landlord.name %></a><% } else { %>—<% } %></dd></div>
      <div><dt>Landlord invoice</dt><dd><% landlordInvoices.forEach((li, i) => { %><%= i ? ', ' : '' %><a href="/app/landlord-invoices/<%= li.id %>"><%= li.invoice_number %></a> (<%= fmt.money(li.amount_pence) %>)<% }) %><%= landlordInvoices.length ? ' · ' : '' %><a href="/app/landlord-invoices/new?contractor_invoice_id=<%= inv.id %>">+ Bill the landlord</a></dd></div>
      <% if (inv.work_required) { %><div class="wide"><dt>What's required</dt><dd class="pre"><%= inv.work_required %></dd></div><% } %>
      <% if (inv.description) { %><div class="wide"><dt>Notes</dt><dd class="pre"><%= inv.description %></dd></div><% } %>
    </dl>
    <% if (inv.file_name) { %>
    <div class="file-box">
      <span>📄 <%= inv.file_original %> <span class="muted small">(<%= Math.max(1, Math.round(inv.file_size / 1024)) %> KB)</span></span>
      <span class="actions">
        <a class="btn small" href="/app/invoices/<%= inv.id %>/file" target="_blank" rel="noopener">View</a>
        <a class="btn small" href="/app/invoices/<%= inv.id %>/file?download=1">Download</a>
      </span>
    </div>
    <% } %>
  </section>

  <section class="card" id="pay">
    <% if (inv.status === 'paid') { %>
      <h2>Payment</h2>
      <div class="callout"><span>Paid on <%= fmt.ukDate(inv.paid_date) %></span><strong><%= fmt.money(inv.amount_pence) %></strong></div>
      <dl class="details">
        <div><dt>Method</dt><dd><%= inv.payment_method %></dd></div>
        <div><dt>Reference</dt><dd><%= inv.payment_reference || '—' %></dd></div>
        <% if (deduction && deduction.deduction_id) { %><div><dt>Deducted from landlord</dt><dd><span class="yes-no yes">Yes</span> <%= deduction.deducted_landlord || '' %> · <a href="<%= statementLink(deduction) %>">View statement</a> · <a href="/app/transactions/<%= inv.payment_txn_id %>">Transaction</a></dd></div><% } %>
      </dl>
      <form method="post" action="/app/invoices/<%= inv.id %>/paid-date" class="inline-form paid-date-form" data-no-keep>
        <%- include('../partials/csrf') %>
        <label for="pd-date">Paid date</label>
        <input id="pd-date" type="date" name="paid_date" value="<%= inv.paid_date %>" required>
        <button class="btn small" type="submit">Change</button>
      </form>
      <form method="post" action="/app/invoices/<%= inv.id %>/unpay" data-confirm="Undo this payment? The invoice will go back to unpaid and the landlord charge will be removed." class="spaced">
        <%- include('../partials/csrf') %><button class="btn small" type="submit">Undo payment</button>
      </form>
    <% } else { %>
      <h2>Pay this invoice</h2>
      <p class="muted small">Record the payment to <%= inv.supplier %>. To bill the landlord, add a landlord invoice.</p>
      <form method="post" action="/app/invoices/<%= inv.id %>/pay" class="stack" data-confirm="Mark <%= fmt.money(inv.amount_pence) %> to <%= inv.supplier %> as paid?">
        <%- include('../partials/csrf') %>
        <label>Payment date <input type="date" name="paid_date" value="<%= today %>" required></label>
        <label>Paid by
          <select name="payment_method" required>
            <% methods.forEach(m => { %><option><%= m %></option><% }) %>
          </select>
        </label>
        <label>Payment reference <input name="payment_reference" placeholder="e.g. bank transfer reference"></label>
        <button class="btn primary" type="submit">Pay <%= fmt.money(inv.amount_pence) %></button>
      </form>
    <% } %>
  </section>
</div>
<%- include('../partials/footer') %>
