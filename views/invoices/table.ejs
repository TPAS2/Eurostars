<%# locals: invoices, showProperty, today, backTo, statementLink %>
<div class="table-wrap">
<table class="clickable">
  <thead><tr><th>Supplier</th><th>Invoice no.</th><% if (showProperty) { %><th>Property / job</th><% } %><th>Due</th><th class="num">Amount</th><th>Status</th><th>Deducted</th><th></th></tr></thead>
  <tbody>
  <% invoices.forEach(i => { const overdue = i.status === 'unpaid' && i.due_date && i.due_date < today; %>
    <tr data-href="/app/invoices/<%= i.id %>">
      <td><a href="/app/invoices/<%= i.id %>"><strong><%= i.supplier %></strong></a></td>
      <td><%= i.invoice_number || '' %></td>
      <% if (showProperty) { %><td><% if (i.property_id) { %><a href="/app/properties/<%= i.property_id %>"><%= i.address_line1 %></a><% } %><% if (i.job_title) { %><div class="muted small"><a class="muted" href="/app/maintenance/<%= i.maintenance_job_id %>"><%= i.job_title %></a></div><% } %></td><% } %>
      <td><%= fmt.ukDate(i.due_date) %></td>
      <td class="num"><%= fmt.money(i.amount_pence) %></td>
      <td>
        <% if (i.status === 'paid') { %><span class="badge s-active">paid <%= fmt.ukDate(i.paid_date) %></span>
        <% } else if (overdue) { %><span class="badge bad">overdue</span>
        <% } else { %><span class="badge warn">unpaid</span><% } %>
      </td>
      <td>
        <% const stLink = statementLink(i); %>
        <% if (i.deduction_id) { %><span class="yes-no yes">Yes</span><% if (stLink) { %> <a class="small" href="<%= stLink %>" title="Deducted from <%= i.deducted_landlord %> on <%= fmt.ukDate(i.deducted_on) %>">View statement</a><% } %>
        <% } else { %><span class="yes-no no">No</span><% } %>
      </td>
      <td class="num row-actions">
        <% if (i.status === 'unpaid') { %><a class="btn small primary" href="/app/invoices/<%= i.id %>#pay">Pay</a><% } %>
        <form method="post" action="/app/invoices/<%= i.id %>/delete" data-confirm="Delete the invoice from <%= i.supplier %> (<%= fmt.money(i.amount_pence) %>)?<%= i.payment_txn_id ? ' The charge to the landlord will be removed too.' : '' %>">
          <%- include('../partials/csrf') %>
          <input type="hidden" name="back" value="<%= backTo || '/app/invoices' %>">
          <button class="btn small danger" type="submit">Delete</button>
        </form>
      </td>
    </tr>
  <% }) %>
  </tbody>
</table>
</div>
