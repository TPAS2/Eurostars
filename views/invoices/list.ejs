<%- include('../partials/header') %>
<header class="page-head">
  <div>
    <h1>Contractors invoices</h1>
    <p class="muted">Contractor and supplier invoices for maintenance. Click an unpaid invoice to pay it.</p>
  </div>
  <div class="actions"><a class="btn primary" href="/app/invoices/new">+ Upload invoice</a></div>
</header>
<% if (flash) { %><div class="notice ok"><%= flash %></div><% } %>
<%- include('../partials/month-nav', { base: '/app/invoices', keep: status === 'all' ? {} : { status }, allowAll: true }) %>

<section class="tiles centered-tiles">
  <% const plural = (n) => `${n} invoice${n === 1 ? '' : 's'}`; %>
  <% if (monthTotals) { %><a class="tile <%= monthTotals.unpaid_n ? 'warn' : '' %>" href="/app/invoices?month=<%= month %>&status=unpaid"><span class="label">Unpaid · <%= monthLabel %></span><span class="value"><%= fmt.money(monthTotals.unpaid) %></span><span class="sub"><%= plural(monthTotals.unpaid_n) %></span></a><% } %>
  <a class="tile <%= totals.unpaid_n ? 'warn' : '' %>" href="/app/invoices?status=unpaid&month=all"><span class="label">Unpaid · all months</span><span class="value"><%= fmt.money(totals.unpaid) %></span><span class="sub"><%= plural(totals.unpaid_n) %><%= totals.overdue_n ? ` · ${fmt.money(totals.overdue)} past due` : '' %></span></a>
  <% if (monthTotals) { %><a class="tile ok" href="/app/invoices?month=<%= month %>&status=paid"><span class="label">Paid · <%= monthLabel %></span><span class="value"><%= fmt.money(monthTotals.paid) %></span><span class="sub"><%= plural(monthTotals.paid_n) %></span></a><% } %>
</section>

<section class="card">
  <nav class="tabs">
    <% [['all', 'All'], ['unpaid', 'Unpaid'], ['paid', 'Paid']].forEach(([k, label]) => { %>
      <a href="/app/invoices?<%= new URLSearchParams(Object.assign({ month }, k === 'all' ? {} : { status: k })) %>" class="<%= status === k ? 'active' : '' %>"><%= label %></a>
    <% }) %>
  </nav>
  <% if (!invoices.length) { %><p class="muted">No invoices <%= month === 'all' ? 'here' : 'for ' + monthLabel %>.</p><% } else { %>
    <%- include('table', { invoices, showProperty: true, backTo: '/app/invoices' }) %>
  <% } %>
</section>
<%- include('../partials/footer') %>
