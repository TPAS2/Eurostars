<%- include('../partials/header') %>
<header class="page-head">
  <div>
    <h1>Invoices</h1>
    <p class="muted">Contractor and supplier invoices for maintenance. Click an unpaid invoice to pay it.</p>
  </div>
  <div class="actions"><a class="btn primary" href="/app/invoices/new">+ Upload invoice</a></div>
</header>

<section class="tiles">
  <a class="tile <%= totals.unpaid_n ? 'warn' : '' %>" href="/app/invoices?status=unpaid"><span class="label">Unpaid</span><span class="value"><%= fmt.money(totals.unpaid) %></span><span class="sub"><%= totals.unpaid_n %> invoice<%= totals.unpaid_n === 1 ? '' : 's' %></span></a>
  <a class="tile <%= totals.overdue_n ? 'alert' : '' %>" href="/app/invoices?status=overdue"><span class="label">Overdue</span><span class="value"><%= fmt.money(totals.overdue) %></span><span class="sub"><%= totals.overdue_n %> invoice<%= totals.overdue_n === 1 ? '' : 's' %></span></a>
</section>

<section class="card">
  <nav class="tabs">
    <% [['all', 'All'], ['unpaid', 'Unpaid'], ['overdue', 'Overdue'], ['paid', 'Paid']].forEach(([k, label]) => { %>
      <a href="/app/invoices<%= k === 'all' ? '' : '?status=' + k %>" class="<%= status === k ? 'active' : '' %>"><%= label %></a>
    <% }) %>
  </nav>
  <% if (!invoices.length) { %><p class="muted">No invoices here.</p><% } else { %>
    <%- include('table', { invoices, showProperty: true }) %>
  <% } %>
</section>
<%- include('../partials/footer') %>
