<%- include('../partials/header') %>
<header class="page-head">
  <div>
    <a class="crumb" href="<%= invoice ? '/app/invoices/' + invoice.id : '/app/invoices' %>">← <%= invoice ? 'Invoice' : 'Contractors invoices' %></a>
    <h1><%= title %></h1>
  </div>
</header>
<section class="card">
  <% if (Object.keys(errors).length) { %><div class="notice err">Please fix the highlighted fields.</div><% } %>
  <form method="post" action="/app/invoices<%= invoice ? '/' + invoice.id : '' %>" enctype="multipart/form-data" class="form-grid" data-draft="invoice-<%= invoice ? invoice.id : 'new' %>">
    <%- include('../partials/csrf') %>
    <div class="field wide top-trio">
      <div class="field">
        <label for="f-file">Invoice file</label>
        <input id="f-file" type="file" name="file" accept="application/pdf,image/png,image/jpeg,image/webp">
        <div class="help">Optional. PDF, PNG, JPG or WebP, up to 10 MB.<% if (invoice && invoice.file_original) { %> Current file: <%= invoice.file_original %>. Choose a new file to replace it.<% } %></div>
        <% if (errors.file) { %><div class="field-err"><%= errors.file %></div><% } %>
      </div>
      <div class="field">
        <label for="f-supplier">Contractor <span class="req">*</span></label>
        <input id="f-supplier" name="supplier" value="<%= values.supplier || '' %>" list="contractor-list" autocomplete="off" placeholder="Start typing to pick a contractor" required>
        <datalist id="contractor-list"><% contractors.forEach(c => { %><option value="<%= c.name %>"><%= c.trade || '' %></option><% }) %></datalist>
        <div class="help">Pick from your contractors, or type a new name to add one.</div>
        <% if (errors.supplier) { %><div class="field-err"><%= errors.supplier %></div><% } %>
      </div>
      <div class="field">
        <span class="label">Added by</span>
        <div class="locked-value"><%= addedByName %></div>
      </div>
    </div>
    <div class="field price-trio wide" data-profit>
      <div class="field">
        <% const chg = values.charge_landlord === 'no' || values.charge_landlord === 0 ? 'no' : values.charge_landlord === 'yes' || values.charge_landlord === 1 ? 'yes' : ''; %>
        <label for="f-charge_landlord">Charge to landlord <span class="req">*</span></label>
        <select id="f-charge_landlord" name="charge_landlord" data-profit-charge required>
          <option value="" <%= chg ? '' : 'selected' %>>Choose…</option>
          <option value="yes" <%= chg === 'yes' ? 'selected' : '' %>>Yes</option>
          <option value="no" <%= chg === 'no' ? 'selected' : '' %>>No</option>
        </select>
        <% if (errors.charge_landlord) { %><div class="field-err"><%= errors.charge_landlord %></div><% } %>
        <div class="help">No: we pay it, the landlord isn't charged.</div>
      </div>
      <div class="field">
        <label for="f-amount">Price to us (£)</label>
        <input id="f-amount" name="amount" inputmode="decimal" placeholder="0.00" value="<%= values.amount || '' %>" data-profit-cost>
        <div class="help">Optional. What the contractor charges us.</div>
        <% if (errors.amount) { %><div class="field-err"><%= errors.amount %></div><% } %>
      </div>
      <div class="field">
        <label for="f-landlord_amount">Price to landlord (£)</label>
        <input id="f-landlord_amount" name="landlord_amount" inputmode="decimal" placeholder="0.00" value="<%= values.landlord_amount || '' %>" data-profit-price>
        <div class="help">Optional. What the landlord is charged; blank means the same as the price to us.</div>
        <% if (errors.landlord_amount) { %><div class="field-err"><%= errors.landlord_amount %></div><% } %>
      </div>
      <div class="field">
        <label>Profit (£)</label>
        <output class="profit-out" data-profit-out>—</output>
        <div class="help">Price to landlord minus price to us.</div>
      </div>
    </div>
    <div class="field">
      <label for="f-invoice_date">Invoice date <span class="req">*</span></label>
      <input id="f-invoice_date" type="date" name="invoice_date" value="<%= values.invoice_date || '' %>" required>
      <% if (errors.invoice_date) { %><div class="field-err"><%= errors.invoice_date %></div><% } %>
    </div>
    <div class="field">
      <label for="f-job">Maintenance job</label>
      <select id="f-job" name="maintenance_job_id">
        <option value="none" <%= !values.maintenance_job_id || values.maintenance_job_id === 'none' ? 'selected' : '' %>>None – no job</option>
        <% jobs.forEach(j => { %><option value="<%= j.id %>" <%= Number(values.maintenance_job_id) === j.id ? 'selected' : '' %>><%= j.label %></option><% }) %>
      </select>
      <div class="help">Optional. The property is taken from the job. <a href="/app/maintenance/new" target="_blank" rel="noopener">+ New maintenance job</a></div>
      <% if (errors.maintenance_job_id) { %><div class="field-err"><%= errors.maintenance_job_id %></div><% } %>
    </div>
    <div class="field">
      <label for="f-property">Property <span class="req">*</span></label>
      <select id="f-property" name="property_id" required>
        <option value="">Choose…</option>
        <% properties.forEach(p => { %><option value="<%= p.id %>" data-landlord="<%= p.landlord_id || '' %>" <%= Number(values.property_id) === p.id ? 'selected' : '' %>><%= p.label %></option><% }) %>
      </select>
      <% if (errors.property_id) { %><div class="field-err"><%= errors.property_id %></div><% } %>
    </div>
    <div class="field">
      <label for="f-landlord">Landlord</label>
      <select id="f-landlord" name="landlord_id" data-landlord-pick>
        <option value="">Property's landlord</option>
        <% landlords.forEach(l => { %><option value="<%= l.id %>" <%= Number(values.landlord_id) === l.id ? 'selected' : '' %>><%= l.name %></option><% }) %>
      </select>
      <div class="help">Who it's charged to. Filled in from the property; change it if needed.</div>
      <% if (errors.landlord_id) { %><div class="field-err"><%= errors.landlord_id %></div><% } %>
    </div>
    <div class="field wide">
      <label for="f-work_required">What's required</label>
      <textarea id="f-work_required" name="work_required" rows="3" maxlength="5000" placeholder="e.g. Replace leaking kitchen tap and reseal sink"><%= values.work_required || '' %></textarea>
      <% if (errors.work_required) { %><div class="field-err"><%= errors.work_required %></div><% } %>
    </div>
    <div class="field wide">
      <label for="f-description">Notes</label>
      <textarea id="f-description" name="description" rows="3"><%= values.description || '' %></textarea>
      <% if (errors.description) { %><div class="field-err"><%= errors.description %></div><% } %>
    </div>
    <div class="form-actions wide">
      <button class="btn primary" type="submit" name="then" value="save"><%= invoice ? 'Save changes' : 'Upload invoice' %></button>
      <% if (!invoice) { %><button class="btn primary deduct-btn" type="submit" name="then" value="deduct" title="Records it as paid on the invoice date and takes it off the property's landlord's money for that month">Upload &amp; deduct from landlord</button><% } %>
      <a class="btn" href="<%= invoice ? '/app/invoices/' + invoice.id : '/app/invoices' %>">Cancel</a>
      <span class="save-status" aria-live="polite"></span>
    </div>
  </form>
</section>
<%- include('../partials/footer') %>
