<%- include('../partials/header') %>
<header class="page-head">
  <div>
    <a class="crumb" href="<%= invoice ? '/app/invoices/' + invoice.id : '/app/invoices' %>">← <%= invoice ? 'Invoice' : 'Contractors invoices' %></a>
    <h1><%= title %></h1>
  </div>
</header>
<section class="card">
  <% if (Object.keys(errors).length) { %><div class="notice err">Please fix the highlighted fields.</div><% } %>
  <form method="post" action="/app/invoices<%= invoice ? '/' + invoice.id : '' %>" enctype="multipart/form-data" class="form-grid" data-draft="invoice-<%= invoice ? invoice.id : 'new' %>">
    <%- include('../partials/csrf') %>
    <div class="field wide">
      <label for="f-file">Invoice file <% if (!invoice) { %><span class="req">*</span><% } %></label>
      <input id="f-file" type="file" name="file" accept="application/pdf,image/png,image/jpeg,image/webp" <%= invoice ? '' : 'required' %>>
      <div class="help">PDF, PNG, JPG or WebP, up to 10 MB.<% if (invoice && invoice.file_original) { %> Current file: <%= invoice.file_original %>. Choose a new file to replace it.<% } %></div>
      <% if (errors.file) { %><div class="field-err"><%= errors.file %></div><% } %>
    </div>
    <div class="field">
      <label for="f-supplier">Supplier / contractor <span class="req">*</span></label>
      <input id="f-supplier" name="supplier" value="<%= values.supplier || '' %>" list="contractor-list" autocomplete="off" placeholder="Start typing to pick a contractor" required>
      <datalist id="contractor-list"><% contractors.forEach(c => { %><option value="<%= c.name %>"><%= c.trade || '' %></option><% }) %></datalist>
      <div class="help">Pick from your contractors, or type a new name to add one.</div>
      <% if (errors.supplier) { %><div class="field-err"><%= errors.supplier %></div><% } %>
    </div>
    <div class="field">
      <label for="f-amount">Amount (£) <span class="req">*</span></label>
      <input id="f-amount" name="amount" inputmode="decimal" placeholder="0.00" value="<%= values.amount || '' %>" required>
      <% if (errors.amount) { %><div class="field-err"><%= errors.amount %></div><% } %>
    </div>
    <div class="field">
      <label for="f-invoice_date">Invoice date <span class="req">*</span></label>
      <input id="f-invoice_date" type="date" name="invoice_date" value="<%= values.invoice_date || '' %>" required>
      <% if (errors.invoice_date) { %><div class="field-err"><%= errors.invoice_date %></div><% } %>
    </div>
    <div class="field">
      <label for="f-job">Maintenance job <span class="req">*</span></label>
      <select id="f-job" name="maintenance_job_id" required>
        <option value="">Choose…</option>
        <% jobs.forEach(j => { %><option value="<%= j.id %>" <%= Number(values.maintenance_job_id) === j.id ? 'selected' : '' %>><%= j.label %></option><% }) %>
      </select>
      <div class="help">The property is taken from the job. <a href="/app/maintenance/new" target="_blank" rel="noopener">+ New maintenance job</a></div>
      <% if (errors.maintenance_job_id) { %><div class="field-err"><%= errors.maintenance_job_id %></div><% } %>
    </div>
    <div class="field">
      <label for="f-property">Property <span class="req">*</span></label>
      <select id="f-property" name="property_id" required>
        <option value="">Choose…</option>
        <% properties.forEach(p => { %><option value="<%= p.id %>" <%= Number(values.property_id) === p.id ? 'selected' : '' %>><%= p.label %></option><% }) %>
      </select>
      <% if (errors.property_id) { %><div class="field-err"><%= errors.property_id %></div><% } %>
    </div>
    <div class="field">
      <label for="f-added_by">Added by <span class="req">*</span></label>
      <select id="f-added_by" name="added_by" required>
        <% people.forEach(m => { %><option value="<%= m.id %>" <%= Number(values.added_by) === m.id ? 'selected' : '' %>><%= m.name %></option><% }) %>
      </select>
    </div>
    <div class="field wide">
      <label for="f-description">Notes <span class="req">*</span></label>
      <textarea id="f-description" name="description" rows="3" required><%= values.description || '' %></textarea>
      <% if (errors.description) { %><div class="field-err"><%= errors.description %></div><% } %>
    </div>
    <div class="form-actions wide">
      <button class="btn primary" type="submit" name="then" value="save"><%= invoice ? 'Save changes' : 'Upload invoice' %></button>
      <% if (!invoice) { %><button class="btn primary deduct-btn" type="submit" name="then" value="deduct" title="Records it as paid on the invoice date and takes it off the property's landlord's money for that month">Upload &amp; deduct from landlord</button><% } %>
      <a class="btn" href="<%= invoice ? '/app/invoices/' + invoice.id : '/app/invoices' %>">Cancel</a>
      <span class="save-status" aria-live="polite"></span>
    </div>
  </form>
</section>
<%- include('../partials/footer') %>
