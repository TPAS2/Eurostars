<%- include('../partials/header') %>
<header class="page-head">
  <div>
    <a class="crumb" href="/admin">← All users</a>
    <h1><%= u.agency_name %></h1>
    <p class="muted"><%= u.name %> · @<%= u.username %><%= u.email ? ' · ' + u.email : '' %> · <span class="badge s-<%= u.status %>"><%= u.status %></span></p>
  </div>
  <% if (!isSelf) { %>
  <div class="actions">
    <% if (u.status === 'active') { %>
      <form method="post" action="/admin/users/<%= u.id %>/logout"><%- include('../partials/csrf') %><button class="btn" type="submit">Sign out everywhere</button></form>
      <form method="post" action="/admin/users/<%= u.id %>/suspend" data-confirm="Suspend @<%= u.username %>? They will be signed out and unable to log in."><%- include('../partials/csrf') %><button class="btn danger" type="submit">Suspend</button></form>
    <% } else { %>
      <form method="post" action="/admin/users/<%= u.id %>/activate"><%- include('../partials/csrf') %><button class="btn primary" type="submit">Reactivate</button></form>
    <% } %>
  </div>
  <% } %>
</header>

<% if (created) { %><div class="notice ok">Account created. Give <strong><%= u.agency_name %></strong> their username <strong><%= u.username %></strong>, name <strong><%= u.login_name %></strong> and the password you chose. Capitals count. They can sign in straight away.</div><% } %>
<% if (flash) { %><div class="notice ok"><%= flash %></div><% } %>
<% if (error) { %><div class="notice err"><%= error %></div><% } %>

<section class="tiles">
  <div class="tile"><span class="label">Joined</span><span class="value sm"><%= fmt.ukDate(u.created_at) %></span></div>
  <div class="tile"><span class="label">Last login</span><span class="value sm"><%= fmt.ukDateTime(u.last_login_at) %></span><span class="sub"><%= u.login_count %> sign-ins</span></div>
  <div class="tile"><span class="label">Landlords</span><span class="value"><%= u.landlords %></span></div>
  <div class="tile"><span class="label">Properties</span><span class="value"><%= u.properties %></span></div>
  <div class="tile"><span class="label">Tenants</span><span class="value"><%= u.tenants %></span><span class="sub"><%= u.active_tenancies %> active tenancies</span></div>
  <div class="tile"><span class="label">Activity</span><span class="value sm"><%= extra.transactions %> transactions</span><span class="sub"><%= extra.jobs %> jobs · <%= extra.certificates %> certificates</span></div>
</section>

<section class="card" id="people">
  <div class="card-head">
    <h2>People <span class="count"><%= people.length %></span></h2>
  </div>
  <p class="muted small">Everyone who can sign in to <strong><%= u.agency_name %></strong>. They all type the username <code><%= u.username %></code> exactly as shown (capitals count), then their own name and password. They see the same company data.</p>
  <div class="table-wrap"><table>
    <thead><tr><th>Person</th><th>Signs in with</th><th>Last login</th><th>Last active</th><th>Status</th><th></th></tr></thead>
    <tbody>
    <% people.forEach(m => { const main = !m.company_id; %>
      <tr>
        <td><strong><%= m.name %></strong><% if (main) { %> <span class="badge">main login</span><% } %></td>
        <td><code><%= u.username %></code> + <code><%= m.login_name %></code></td>
        <td><%= fmt.ukDateTime(m.last_login_at) %></td>
        <td><% if (m.last_active) { %><a href="/admin/users/<%= u.id %>?person=<%= m.id %>#activity"><%= fmt.ukDateTime(m.last_active) %></a><% } else { %>No activity<% } %></td>
        <td><span class="badge s-<%= m.status %>"><%= m.status %></span></td>
        <td class="num">
          <% if (!main) { %>
          <details class="person-menu">
            <summary class="btn small">Manage</summary>
            <div class="person-actions">
              <form method="post" action="/admin/people/<%= m.id %>/password" class="inline-form">
                <%- include('../partials/csrf') %>
                <input id="pw-<%= m.id %>" name="password" type="text" minlength="<%= minPassword %>" placeholder="New password" autocomplete="off" required>
                <button class="btn small" type="button" data-generate="#pw-<%= m.id %>">Suggest</button>
                <button class="btn small primary" type="submit">Set password</button>
              </form>
              <div class="actions">
                <form method="post" action="/admin/people/<%= m.id %>/<%= m.status === 'active' ? 'suspend' : 'activate' %>"><%- include('../partials/csrf') %><button class="btn small" type="submit"><%= m.status === 'active' ? 'Suspend' : 'Reactivate' %></button></form>
                <form method="post" action="/admin/people/<%= m.id %>/delete" data-confirm="Remove <%= m.name %>? They won't be able to sign in any more. The company's data is kept."><%- include('../partials/csrf') %><button class="btn small danger" type="submit">Remove</button></form>
              </div>
            </div>
          </details>
          <% } else { %><a class="small" href="#reset-password">Reset password below</a><% } %>
        </td>
      </tr>
    <% }) %>
    </tbody>
  </table></div>

  <h3 class="spaced">Add a person</h3>
  <form method="post" action="/admin/users/<%= u.id %>/people" class="form-grid">
    <%- include('../partials/csrf') %>
    <div class="field">
      <label for="p-name">Full name <span class="req">*</span></label>
      <input id="p-name" name="name" required autocomplete="off" placeholder="e.g. John Price">
    </div>
    <div class="field">
      <label for="p-login">Sign-in name <span class="req">*</span></label>
      <input id="p-login" name="login_name" required maxlength="30" autocomplete="off" autocapitalize="none" spellcheck="false" placeholder="e.g. john">
      <div class="help">What they type in "Your name" when signing in. Capitals count.</div>
    </div>
    <div class="field">
      <label for="p-password">Password <span class="req">*</span></label>
      <div class="input-row">
        <input id="p-password" name="password" type="text" required minlength="<%= minPassword %>" autocomplete="off">
        <button class="btn" type="button" data-generate="#p-password">Suggest one</button>
      </div>
    </div>
    <div class="form-actions wide"><button class="btn primary" type="submit">Add person</button></div>
  </form>
</section>

<section class="card" id="activity">
  <div class="card-head">
    <h2>Activity <span class="count"><%= activityRows.length %><%= activityRows.length === 300 ? '+' : '' %></span></h2>
    <nav class="tabs compact">
      <a href="/admin/users/<%= u.id %>#activity" class="<%= activityFilter === 'all' ? 'active' : '' %>">Everything</a>
      <a href="/admin/users/<%= u.id %>?activity=changes<%= personFilter ? '&person=' + personFilter : '' %>#activity" class="<%= activityFilter === 'changes' ? 'active' : '' %>">Changes only</a>
    </nav>
  </div>
  <p class="muted small">Pages <%= isSelf ? 'you' : 'everyone at this company' %> opened and changes made, newest first. Kept for 6 months.
    <% if (personFilter) { %>Showing one person only. <a href="/admin/users/<%= u.id %>#activity">Show everyone</a><% } %></p>
  <% if (!activityRows.length) { %><p class="muted">No activity recorded yet.</p><% } else { %>
  <div class="table-wrap activity-scroll"><table>
    <thead><tr><th>When</th><th>Who</th><th>Activity</th><th>IP</th></tr></thead>
    <tbody>
    <% activityRows.forEach(e => { %>
      <tr><td class="nowrap"><%= fmt.ukDateTime(e.created_at) %></td><td class="nowrap"><%= e.person_name %></td>
      <td><span class="act act-<%= e.action.replace(/\s+/g, '-') %>"><%= e.action %></span> <%= e.summary %></td>
      <td class="muted small"><%= e.ip %></td></tr>
    <% }) %>
    </tbody>
  </table></div><% } %>
</section>

<section class="card">
  <h2>Sign-in history</h2>
  <% if (!logins.length) { %><p class="muted">No sign-ins yet.</p><% } else { %>
  <div class="table-wrap"><table>
    <thead><tr><th>When</th><th>Who</th><th>Result</th><th>IP</th><th>Device</th></tr></thead>
    <tbody>
    <% logins.forEach(e => { %>
      <tr><td><%= fmt.ukDateTime(e.created_at) %></td><td class="nowrap"><%= e.person_name %></td><td><span class="badge <%= e.success ? 's-active' : 'bad' %>"><%= e.success ? 'success' : 'failed' %></span></td><td><%= e.ip %></td><td class="muted small"><%= e.user_agent %></td></tr>
    <% }) %>
    </tbody>
  </table></div><% } %>
</section>

<section class="card" id="details">
  <h2>Account details</h2>
  <p class="muted small">Only you can change these. Use Reset password below to change the password.</p>
  <form method="post" action="/admin/users/<%= u.id %>/details" class="form-grid">
    <%- include('../partials/csrf') %>
    <div class="field">
      <label for="d-agency_name">Company name <span class="req">*</span></label>
      <input id="d-agency_name" name="agency_name" value="<%= u.agency_name %>" required>
    </div>
    <% if (!u.is_admin) { %>
    <div class="field">
      <label for="d-username">Username <span class="req">*</span></label>
      <input id="d-username" name="username" value="<%= u.username %>" required maxlength="30" autocomplete="off" autocapitalize="none" spellcheck="false">
      <div class="help">What everyone at this company types as the username. Capitals count.</div>
    </div>
    <% } %>
    <div class="field">
      <label for="d-login_name">Contact's sign-in name <span class="req">*</span></label>
      <input id="d-login_name" name="login_name" value="<%= u.login_name || '' %>" required maxlength="30" autocomplete="off" autocapitalize="none" spellcheck="false">
    </div>
    <div class="field">
      <label for="d-name">Contact name <span class="req">*</span></label>
      <input id="d-name" name="name" value="<%= u.name %>" required>
    </div>
    <div class="field">
      <label for="d-email">Email</label>
      <input id="d-email" name="email" type="email" value="<%= u.email || '' %>">
    </div>
    <div class="field">
      <label for="d-phone">Phone</label>
      <input id="d-phone" name="phone" type="tel" value="<%= u.phone || '' %>">
    </div>
    <div class="field wide">
      <label for="d-address">Company address</label>
      <textarea id="d-address" name="address" rows="3"><%= u.address || '' %></textarea>
    </div>
    <div class="form-actions wide"><button class="btn primary" type="submit">Save details</button></div>
  </form>
</section>

<section class="card" id="reset-password">
  <h2>Reset password <span class="muted small">(main login)</span></h2>
  <p class="muted small">Passwords are stored scrambled, so nobody (not even you) can look one up. If <%= isSelf ? 'you forget yours' : 'they forget theirs' %>, set a new one here<%= isSelf ? '' : ' and tell them what it is' %>.</p>
  <form method="post" action="/admin/users/<%= u.id %>/password" class="inline-form">
    <%- include('../partials/csrf') %>
    <label>New password <input id="new_password" name="password" type="text" minlength="<%= minPassword %>" autocomplete="off" required></label>
    <button class="btn" type="button" data-generate="#new_password">Suggest one</button>
    <button class="btn primary" type="submit">Set password</button>
  </form>
</section>

<% if (!isSelf) { %>
<section class="card danger-zone">
  <h2>Delete account</h2>
  <p>Permanently deletes this user and <strong>all</strong> of their landlords, properties, tenants and accounts. This can't be undone.</p>
  <form method="post" action="/admin/users/<%= u.id %>/delete" class="inline-form">
    <%- include('../partials/csrf') %>
    <label>Type the username <strong><%= u.username %></strong> to confirm <input id="confirm_username" name="confirm_username" autocomplete="off" autocapitalize="none" required></label>
    <button class="btn danger" type="submit">Delete permanently</button>
  </form>
</section>
<% } %>
<%- include('../partials/footer') %>
