<%- include('../partials/header') %>
<header class="page-head">
  <div>
    <a class="crumb" href="/admin">← All users</a>
    <h1><%= u.agency_name %></h1>
    <p class="muted"><%= u.name %> · @<%= u.username %><%= u.email ? ' · ' + u.email : '' %> · <span class="badge s-<%= u.status %>"><%= u.status %></span></p>
  </div>
  <% if (!isSelf) { %>
  <div class="actions">
    <% if (u.status === 'active') { %>
      <form method="post" action="/admin/users/<%= u.id %>/logout"><%- include('../partials/csrf') %><button class="btn" type="submit">Sign out everywhere</button></form>
      <form method="post" action="/admin/users/<%= u.id %>/suspend" data-confirm="Suspend @<%= u.username %>? They will be signed out and unable to log in."><%- include('../partials/csrf') %><button class="btn danger" type="submit">Suspend</button></form>
    <% } else { %>
      <form method="post" action="/admin/users/<%= u.id %>/activate"><%- include('../partials/csrf') %><button class="btn primary" type="submit">Reactivate</button></form>
    <% } %>
  </div>
  <% } %>
</header>

<% if (created) { %><div class="notice ok">Account created. Give <strong><%= u.agency_name %></strong> their username <strong><%= u.username %></strong> and the password you chose. They can sign in straight away.</div><% } %>
<% if (flash) { %><div class="notice ok"><%= flash %></div><% } %>
<% if (error) { %><div class="notice err"><%= error %></div><% } %>

<section class="tiles">
  <div class="tile"><span class="label">Joined</span><span class="value sm"><%= fmt.ukDate(u.created_at) %></span></div>
  <div class="tile"><span class="label">Last login</span><span class="value sm"><%= fmt.ukDateTime(u.last_login_at) %></span><span class="sub"><%= u.login_count %> sign-ins</span></div>
  <div class="tile"><span class="label">Landlords</span><span class="value"><%= u.landlords %></span></div>
  <div class="tile"><span class="label">Properties</span><span class="value"><%= u.properties %></span></div>
  <div class="tile"><span class="label">Tenants</span><span class="value"><%= u.tenants %></span><span class="sub"><%= u.active_tenancies %> active tenancies</span></div>
  <div class="tile"><span class="label">Activity</span><span class="value sm"><%= extra.transactions %> transactions</span><span class="sub"><%= extra.jobs %> jobs · <%= extra.certificates %> certificates</span></div>
</section>

<section class="card">
  <h2>Sign-in history</h2>
  <% if (!logins.length) { %><p class="muted">No sign-ins yet.</p><% } else { %>
  <div class="table-wrap"><table>
    <thead><tr><th>When</th><th>Result</th><th>IP</th><th>Device</th></tr></thead>
    <tbody>
    <% logins.forEach(e => { %>
      <tr><td><%= fmt.ukDateTime(e.created_at) %></td><td><span class="badge <%= e.success ? 's-active' : 'bad' %>"><%= e.success ? 'success' : 'failed' %></span></td><td><%= e.ip %></td><td class="muted small"><%= e.user_agent %></td></tr>
    <% }) %>
    </tbody>
  </table></div><% } %>
</section>

<section class="card" id="details">
  <h2>Account details</h2>
  <p class="muted small">Only you can change these. The username <code><%= u.username %></code> stays the same; use Reset password below to change the password.</p>
  <form method="post" action="/admin/users/<%= u.id %>/details" class="form-grid">
    <%- include('../partials/csrf') %>
    <div class="field">
      <label for="d-agency_name">Company name <span class="req">*</span></label>
      <input id="d-agency_name" name="agency_name" value="<%= u.agency_name %>" required>
    </div>
    <div class="field">
      <label for="d-name">Contact name <span class="req">*</span></label>
      <input id="d-name" name="name" value="<%= u.name %>" required>
    </div>
    <div class="field">
      <label for="d-email">Email</label>
      <input id="d-email" name="email" type="email" value="<%= u.email || '' %>">
    </div>
    <div class="field">
      <label for="d-phone">Phone</label>
      <input id="d-phone" name="phone" type="tel" value="<%= u.phone || '' %>">
    </div>
    <div class="field wide">
      <label for="d-address">Company address</label>
      <textarea id="d-address" name="address" rows="3"><%= u.address || '' %></textarea>
    </div>
    <div class="form-actions wide"><button class="btn primary" type="submit">Save details</button></div>
  </form>
</section>

<section class="card">
  <h2>Reset password</h2>
  <p class="muted small">Passwords are stored scrambled, so nobody (not even you) can look one up. If <%= isSelf ? 'you forget yours' : 'they forget theirs' %>, set a new one here<%= isSelf ? '' : ' and tell them what it is' %>.</p>
  <form method="post" action="/admin/users/<%= u.id %>/password" class="inline-form">
    <%- include('../partials/csrf') %>
    <label>New password <input id="new_password" name="password" type="text" minlength="<%= minPassword %>" autocomplete="off" required></label>
    <button class="btn" type="button" data-generate="#new_password">Suggest one</button>
    <button class="btn primary" type="submit">Set password</button>
  </form>
</section>

<% if (!isSelf) { %>
<section class="card danger-zone">
  <h2>Delete account</h2>
  <p>Permanently deletes this user and <strong>all</strong> of their landlords, properties, tenants and accounts. This can't be undone.</p>
  <form method="post" action="/admin/users/<%= u.id %>/delete" class="inline-form">
    <%- include('../partials/csrf') %>
    <label>Type the username <strong><%= u.username %></strong> to confirm <input id="confirm_username" name="confirm_username" autocomplete="off" autocapitalize="none" required></label>
    <button class="btn danger" type="submit">Delete permanently</button>
  </form>
</section>
<% } %>
<%- include('../partials/footer') %>
