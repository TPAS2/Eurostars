<%- include('../partials/header') %>
<header class="page-head">
  <div>
    <a class="crumb" href="/admin">← All users</a>
    <h1>Add account</h1>
    <p class="muted">The same three things they type to sign in. A new agency gets its own private workspace; its company name and contact details can be filled in afterwards under Account details.</p>
  </div>
</header>
<section class="card">
  <% if (Object.keys(errors).length) { %><div class="notice err">Please fix the highlighted fields.</div><% } %>
  <form method="post" action="/admin/users" class="form-grid">
    <%- include('../partials/csrf') %>
    <div class="field">
      <label for="username">Agency <span class="req">*</span></label>
      <input id="username" name="username" value="<%= values.username || '' %>" required maxlength="60" autocomplete="off" autocapitalize="none" spellcheck="false">
      <% if (errors.username) { %><div class="field-err"><%= errors.username %></div><% } else { %><div class="help">Capitals count. Use an existing agency to add another person to it.</div><% } %>
    </div>
    <div class="field">
      <label for="login_name">Name <span class="req">*</span></label>
      <input id="login_name" name="login_name" value="<%= values.login_name || '' %>" required maxlength="30" autocomplete="off" autocapitalize="none" spellcheck="false" placeholder="e.g. Sam">
      <% if (errors.login_name) { %><div class="field-err"><%= errors.login_name %></div><% } else { %><div class="help">Capitals count. Must be different from everyone else in the agency.</div><% } %>
    </div>
    <div class="field">
      <label for="password">Password <span class="req">*</span></label>
      <div class="input-row">
        <input id="password" name="password" type="text" required minlength="<%= minPassword %>" maxlength="200" autocomplete="off">
        <button class="btn" type="button" data-generate="#password">Suggest one</button>
      </div>
      <% if (errors.password) { %><div class="field-err"><%= errors.password %></div><% } else { %><div class="help">At least <%= minPassword %> characters. Shown as you type so you can pass it on.</div><% } %>
    </div>
    <div class="form-actions wide">
      <button class="btn primary" type="submit">Create account</button>
      <a class="btn" href="/admin">Cancel</a>
    </div>
  </form>
</section>
<%- include('../partials/footer') %>
