<%- include('partials/header', { bodyClass: 'auth' }) %>
<%- include('partials/auth-open') %>
<div class="card narrow auth-card">
  <a class="brand" href="/"><span class="logo"><%= appName.charAt(0).toUpperCase() %></span><%= appName %></a>
  <h1>Create your account</h1>
  <% if (errors.form) { %><div class="notice err"><%= errors.form %></div><% } %>
  <form method="post" action="/register" class="stack">
    <label>Username
      <input id="username" name="username" value="<%= values.username || '' %>" required maxlength="60" autocomplete="username" autocapitalize="none" spellcheck="false" autofocus>
    </label>
    <% if (errors.username) { %><div class="field-err"><%= errors.username %></div><% } else { %><div class="help">You'll type this in the Agency box to sign in. Capitals count.</div><% } %>
    <label>Password <input id="password" type="password" name="password" required minlength="10" maxlength="200" autocomplete="new-password"></label>
    <% if (errors.password) { %><div class="field-err"><%= errors.password %></div><% } else { %><div class="help">At least 10 characters.</div><% } %>
    <label>Confirm password <input id="password_confirm" type="password" name="password_confirm" required minlength="10" maxlength="200" autocomplete="new-password"></label>
    <% if (errors.password_confirm) { %><div class="field-err"><%= errors.password_confirm %></div><% } %>
    <label>Your name <input id="name" name="name" value="<%= values.name || '' %>" required maxlength="200" autocomplete="name"></label>
    <% if (errors.name) { %><div class="field-err"><%= errors.name %></div><% } %>
    <label>Agency / business name <input id="agency_name" name="agency_name" value="<%= values.agency_name || '' %>" required maxlength="200" autocomplete="organization"></label>
    <% if (errors.agency_name) { %><div class="field-err"><%= errors.agency_name %></div><% } %>
    <label>Email <span class="muted small">(optional)</span> <input id="email" type="email" name="email" value="<%= values.email || '' %>" maxlength="254" autocomplete="email"></label>
    <% if (errors.email) { %><div class="field-err"><%= errors.email %></div><% } %>
    <button class="btn primary" type="submit">Create account</button>
  </form>
  <p class="muted small">Already have an account? <a href="/login">Sign in</a></p>
</div>
<%- include('partials/auth-close') %>
<%- include('partials/footer') %>
