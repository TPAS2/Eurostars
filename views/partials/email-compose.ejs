<%# locals: action, title (HTML), intro, detailsClass, month, monthLabel, emailOut, emailEnabled %>
<details class="<%= detailsClass %>" id="send-email">
  <summary><h2><%- title %></h2></summary>
  <p class="muted"><%= intro %><% if (!emailEnabled) { %> <strong class="warn-text">Email isn’t set up yet.</strong><% } %></p>
<% const presetBase = action.replace(/\/send-email$/, ''); %>
  <div class="presets-bar">
    <label for="email-preset-pick" class="strong">Preset</label>
    <select id="email-preset-pick" data-email-preset-pick>
      <option value="">Choose a preset…</option>
      <% emailOut.presets.forEach(p => { %><option value="<%= p.id %>" data-preset="<%= JSON.stringify(p.data) %>"><%= p.name %></option><% }) %>
    </select>
    <button class="btn small primary" type="button" data-email-preset-fill="#email-compose-form">Fill in</button>
    <button class="btn small" type="button" data-toggle="#email-preset-manage" aria-controls="email-preset-manage" aria-expanded="false">Presets (<%= emailOut.presets.length %>)</button>
  </div>
  <div id="email-preset-manage" class="metro-docs" hidden>
    <h3>Email presets</h3>
    <p class="muted small">Ready-made emails (who it's to, the subject and message) to fill in with one click. Fill in the boxes below, then save them as a preset; saving with the same name replaces it.</p>
    <% if (emailOut.presets.length) { %>
    <div class="table-wrap"><table>
      <thead><tr><th>Name</th><th>To</th><th>Subject</th><th></th></tr></thead>
      <tbody>
      <% emailOut.presets.forEach(p => { %><tr>
        <td><strong><%= p.name %></strong></td><td><%= p.data.to %></td><td><%= p.data.subject %></td>
        <td class="num nowrap"><form method="post" action="<%= presetBase %>/email-presets/<%= p.id %>/delete" class="inline" data-confirm="Remove the email preset <%= p.name %>?"><%- include('csrf') %><input type="hidden" name="month" value="<%= month %>"><button class="btn small link" type="submit">Remove</button></form></td>
      </tr><% }) %>
      </tbody>
    </table></div>
    <% } %>
    <div class="inline-form preset-save">
      <input form="email-compose-form" name="preset_name" placeholder="Preset name, e.g. Metro Bank payments" maxlength="60" aria-label="Email preset name">
      <button form="email-compose-form" class="btn small" type="submit" formaction="<%= presetBase %>/email-presets" formnovalidate>Save boxes as preset</button>
    </div>
  </div>
  <form method="post" action="<%= action %>" enctype="multipart/form-data" class="mail-compose" id="email-compose-form" data-busy="Sending…" data-no-keep>
    <%- include('csrf') %>
    <input type="hidden" name="month" value="<%= month %>">
    <div class="mail-head">
      <label class="mail-row"><span>From</span><input type="email" name="from" value="<%= emailOut.from %>" required maxlength="254" autocomplete="email"></label>
      <label class="mail-row"><span>To</span><input name="to" required maxlength="2000" placeholder="name@example.com" autocomplete="off"></label>
      <label class="mail-row"><span>Cc</span><input name="cc" maxlength="2000" autocomplete="off"></label>
      <label class="mail-row"><span>Bcc</span><input name="bcc" maxlength="2000" autocomplete="off"></label>
      <label class="mail-row"><span>Subject</span><input name="subject" value="<%= emailOut.subject %>" required maxlength="300"></label>
    </div>
    <textarea name="message" rows="10" class="mail-body" placeholder="Write your message…" maxlength="20000"></textarea>
    <div class="mail-foot">
      <button class="btn primary" type="submit" <%= emailEnabled ? '' : 'disabled' %>>Send</button>
      <label class="btn mail-attach"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M21 11.5l-8.5 8.5a5 5 0 0 1-7-7l8.5-8.5a3.5 3.5 0 0 1 5 5L10.5 18a2 2 0 0 1-3-3l7.5-7.5"/></svg> Attach files<input type="file" name="files" multiple hidden data-file-list="#mail-files"></label>
      <span class="muted small" id="mail-files">No files attached</span>
    </div>
  </form>
  <p class="muted small">Separate several addresses with commas. Up to 10 files, 10 MB each. If the From address isn’t on your email service’s domain, the email comes from your usual sending address and replies go to the From address.</p>
  <% if (emailOut.sent.length) { %>
  <h3>Sent for <%= monthLabel %></h3>
  <div class="table-wrap"><table class="centered">
    <thead><tr><th>Sent</th><th>To</th><th>Subject</th><th>Files</th><th>By</th></tr></thead>
    <tbody>
    <% emailOut.sent.forEach(e => { %>
      <tr><td><%= fmt.ukDateTime(e.sent_at) %></td><td><%= e.to_addr %><% if (e.cc) { %><div class="muted small">cc <%= e.cc %></div><% } %></td><td><%= e.subject %></td><td class="small"><%= e.files || '—' %></td><td><%= e.sent_by_name || '' %></td></tr>
    <% }) %>
    </tbody>
  </table></div>
  <% } %>
</details>
