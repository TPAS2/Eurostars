<%# locals: f, value, error, opts %>
<div class="field <%= (f.type === 'textarea' && !f.inline) || f.wide ? 'wide' : '' %> <%= f.startRow ? 'row-start' : '' %>">
  <label for="f-<%= f.name %>"><%= f.label %><% if (f.required) { %> <span class="req">*</span><% } %></label>
  <% const v = value === null || value === undefined ? '' : value; %>
  <% if (f.type === 'textarea') { %>
    <textarea id="f-<%= f.name %>" name="<%= f.name %>" rows="3" <%= f.required ? 'required' : '' %>><%= v %></textarea>
  <% } else if (f.type === 'select') { %>
    <select id="f-<%= f.name %>" name="<%= f.name %>" <%= f.required ? 'required' : '' %><%= f.segment ? ' data-segment' : '' %>>
      <% if (!f.required || v === '') { %><option value="" <%= v === '' ? 'selected' : '' %>><%= f.required ? '— Select —' : '—' %></option><% } %>
      <% f.options.forEach(o => { %><option value="<%= o %>" <%= String(v) === o ? 'selected' : '' %>><%= (f.optionLabels && f.optionLabels[o]) || fmt.humanize(o) %></option><% }) %>
    </select>
  <% } else if (f.type === 'person') { %>
    <select id="f-<%= f.name %>" name="<%= f.name %>" <%= f.required ? 'required' : '' %>>
      <% (opts || []).forEach(o => { %><option value="<%= o.id %>" <%= Number(v) === o.id ? 'selected' : '' %>><%= o.label %></option><% }) %>
    </select>
  <% } else if (f.type === 'ref') { %>
    <select id="f-<%= f.name %>" name="<%= f.name %>" <%= f.required ? 'required' : '' %>>
      <option value="">— Select —</option>
      <% opts.forEach(o => { %><option value="<%= o.id %>" <%= Number(v) === o.id ? 'selected' : '' %>><%= o.label %></option><% }) %>
    </select>
  <% } else if (f.type === 'money') { %>
    <input id="f-<%= f.name %>" name="<%= f.name %>" inputmode="decimal" value="<%= typeof v === 'number' ? fmt.penceToInput(v) : v %>" <%= f.required ? 'required' : '' %> placeholder="0.00">
  <% } else { %>
    <input id="f-<%= f.name %>" name="<%= f.name %>" value="<%= v %>" <%= f.required ? 'required' : '' %><% if (f.suggest && opts) { %> list="list-<%= f.name %>" autocomplete="off"<% } %>
      type="<%= { date: 'date', email: 'email', tel: 'tel', integer: 'number', number: 'number' }[f.type] || 'text' %>"
      <%- f.type === 'number' ? 'step="0.01" min="0" max="100"' : f.type === 'integer' ? 'step="1" min="0"' : '' %>>
  <% } %>
  <% if (f.suggest && opts) { %><datalist id="list-<%= f.name %>"><% opts.forEach(o => { %><option value="<%= o %>"><% }) %></datalist><% } %>
  <% if (f.help) { %><div class="help"><%= f.help %></div><% } %>
  <% if (error) { %><div class="field-err"><%= error %></div><% } %>
</div>
