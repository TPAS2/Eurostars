<!doctype html>
<html lang="en-GB">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %> · <%= appName %></title>
  <link rel="icon" href="/static/favicon.svg" type="image/svg+xml">
  <link rel="icon" href="/static/favicon-32.png" type="image/png" sizes="32x32">
  <link rel="apple-touch-icon" href="/static/apple-touch-icon.png">
  <meta name="theme-color" content="#1f5eff">
  <link rel="stylesheet" href="/static/style.css">
  <script src="/static/app.js" defer></script>
</head>
<body class="<%= typeof bodyClass !== 'undefined' ? bodyClass : '' %>"<% if (user && typeof idleMinutes !== 'undefined' && idleMinutes > 0) { %> data-idle-minutes="<%= idleMinutes %>"<% } %>>
<% if (user) {
  const s = typeof section !== 'undefined' ? section : '';
  const initials = String(user.name || user.username).split(/\s+/).map((w) => w[0]).join('').slice(0, 2).toUpperCase();
  // The admin runs the software rather than letting properties, so only gets the owner pages.
  // The logo button at the top goes to the dashboard (or, for the admin, the admin panel).
  const groups = user.is_admin ? [
    [['accounts', '/admin/accounts', 'Account details'], ['access', '/admin/access', 'Tab access'], ['backups', '/admin/backups', 'Backups'], ['security', '/admin/security', 'Security']],
  ] : [
    [['councils', '/app/councils', 'Councils'], ['councilrec', '/app/council-reconciliation', 'Council reconciliation']],
    [['properties', '/app/properties', 'Properties'], ['landlords', '/app/landlords', 'Landlords'], ['tenants', '/app/tenants', 'Tenants'], ['tenancies', '/app/tenancies', 'Tenancies']],
    [['maintenance', '/app/maintenance', 'Maintenance'], ['invoices', '/app/invoices', 'Invoices'], ['compliance', '/app/compliance', 'Compliance']],
    [['rentrun', '/app/rent-run', 'Rent run'], ['monthly', '/app/monthly', 'Monthly statements'], ['statements', '/app/statements', 'Statement by date range']],
  ];
%>
<div class="shell">
  <aside class="sidebar">
    <% const home = user.is_admin ? { href: '/admin', label: 'Admin panel', tip: 'Admin panel', on: s === 'admin' } : { href: '/app', label: 'Dashboard', tip: `Dashboard · ${user.agency_name}`, on: s === 'dashboard' }; %>
    <a class="rail-btn brand-btn <%= home.on ? 'active' : '' %>" href="<%= home.href %>" data-tip="<%= home.tip %>" aria-label="<%= home.label %>" <%- home.on ? 'aria-current="page"' : '' %>><span class="logo">N</span></a>
    <nav class="rail" aria-label="Main">
      <% groups.filter(g => g.some(([key]) => !(user.hidden_tabs || []).includes(key))).forEach((g, gi) => { %>
        <% if (gi) { %><span class="rail-sep" aria-hidden="true"></span><% } %>
        <% g.filter(([key]) => !(user.hidden_tabs || []).includes(key)).forEach(([key, href, label]) => { %>
          <a class="rail-btn <%= s === key ? 'active' : '' %> <%= key === 'councilrec' || key === 'rentrun' ? 'rail-red' : '' %>" href="<%= href %>" data-tip="<%= label %>" aria-label="<%= label %>" <%- s === key ? 'aria-current="page"' : '' %>><%- include('icon', { name: key }) %></a>
        <% }) %>
      <% }) %>
    </nav>
    <div class="rail rail-me">
      <a class="rail-btn avatar <%= s === 'account' ? 'active' : '' %>" href="/app/account" data-tip="My account · <%= user.name %>" aria-label="My account" <%- s === 'account' ? 'aria-current="page"' : '' %>><span class="avatar-initials"><%= initials %></span></a>
      <form method="post" action="/logout" id="signout-form">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <button class="rail-btn" type="submit" data-tip="Sign out" aria-label="Sign out"><%- include('icon', { name: 'signout' }) %></button>
      </form>
    </div>
  </aside>
  <main class="content">
<% } else { %>
<main class="public">
<% } %>
