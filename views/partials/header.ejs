<!doctype html>
<html lang="en-GB">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %> · <%= appName %></title>
  <link rel="icon" href="/static/favicon.svg" type="image/svg+xml">
  <link rel="icon" href="/static/favicon-32.png" type="image/png" sizes="32x32">
  <link rel="apple-touch-icon" href="/static/apple-touch-icon.png">
  <meta name="theme-color" content="#1f5eff">
  <link rel="stylesheet" href="/static/style.css">
  <script src="/static/app.js" defer></script>
</head>
<body class="<%= typeof bodyClass !== 'undefined' ? bodyClass : '' %>">
<% if (user) {
  const s = typeof section !== 'undefined' ? section : '';
  const initials = String(user.name || user.username).split(/\s+/).map((w) => w[0]).join('').slice(0, 2).toUpperCase();
  // The admin runs the software rather than letting properties, so only gets the owner pages.
  // The logo button at the top is the way to the dashboard.
  const groups = user.is_admin ? [
    [['admin', '/admin', 'Admin panel'], ['backups', '/admin/backups', 'Backups']],
  ] : [
    [['councils', '/app/councils', 'Councils']],
    [['landlords', '/app/landlords', 'Landlords'], ['properties', '/app/properties', 'Properties'], ['tenants', '/app/tenants', 'Tenants'], ['tenancies', '/app/tenancies', 'Tenancies']],
    [['maintenance', '/app/maintenance', 'Maintenance'], ['invoices', '/app/invoices', 'Invoices'], ['compliance', '/app/compliance', 'Compliance']],
    [['transactions', '/app/transactions', 'Transactions'], ['monthly', '/app/monthly', 'Monthly statements'], ['statements', '/app/statements', 'Statement by date range']],
  ];
%>
<div class="shell">
  <aside class="sidebar">
    <a class="rail-btn brand-btn <%= s === 'dashboard' ? 'active' : '' %>" href="/app" data-tip="Dashboard · <%= user.agency_name %>" aria-label="Dashboard" <%- s === 'dashboard' ? 'aria-current="page"' : '' %>><span class="logo">N</span></a>
    <nav class="rail" aria-label="Main">
      <% groups.forEach((g, gi) => { %>
        <% if (gi) { %><span class="rail-sep" aria-hidden="true"></span><% } %>
        <% g.forEach(([key, href, label]) => { %>
          <a class="rail-btn <%= s === key ? 'active' : '' %>" href="<%= href %>" data-tip="<%= label %>" aria-label="<%= label %>" <%- s === key ? 'aria-current="page"' : '' %>><%- include('icon', { name: key }) %></a>
        <% }) %>
      <% }) %>
    </nav>
    <div class="rail rail-me">
      <span class="rail-btn avatar" tabindex="0" data-tip="<%= user.name %> · @<%= user.username %> · <%= user.agency_name %>" aria-label="Signed in as <%= user.name %>"><%= initials %></span>
      <a class="rail-btn" href="/app/export" data-tip="Download my data" aria-label="Download my data"><%- include('icon', { name: 'download' }) %></a>
      <form method="post" action="/logout">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <button class="rail-btn" type="submit" data-tip="Sign out" aria-label="Sign out"><%- include('icon', { name: 'signout' }) %></button>
      </form>
    </div>
  </aside>
  <main class="content">
<% } else { %>
<main class="public">
<% } %>
