<!doctype html>
<html lang="en-GB"<% if (typeof user !== 'undefined' && user && user.theme) { %> data-theme="<%= user.theme %>"<% } %>>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %> · <%= appName %></title>
  <link rel="icon" href="/static/galaxy-favicon.svg" type="image/svg+xml">
  <link rel="icon" href="/static/galaxy-favicon-32.png" type="image/png" sizes="32x32">
  <link rel="apple-touch-icon" href="/static/galaxy-apple-touch-icon.png">
  <meta name="theme-color" content="#1f5eff">
  <link rel="manifest" href="/static/manifest.webmanifest">
  <meta name="mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-title" content="Rift">
  <link rel="stylesheet" href="/static/style.css?v=<%= assetV %>">
  <script src="/static/app.js?v=<%= assetV %>" defer></script>
</head>
<body class="<%= typeof bodyClass !== 'undefined' ? bodyClass : '' %>"<% if (user) { %> data-who="<%= user.person_id || user.id %>"<% } %><% if (user && typeof idleMinutes !== 'undefined' && idleMinutes > 0) { %> data-idle-minutes="<%= idleMinutes %>"<% } %>>
<% if (user && typeof intro !== 'undefined' && intro) { %>
<div class="intro" data-intro role="presentation" aria-hidden="true">
  <span class="intro-half intro-l"><img src="/static/intro-sky.jpg" alt=""></span>
  <span class="intro-half intro-r"><img src="/static/intro-sky.jpg" alt=""></span>
  <span class="intro-seam"></span>
  <div class="intro-center"><img class="intro-logo" src="/static/galaxy-icon-192.png" alt="" width="84" height="84"></div>
</div>
<% } %>
<% if (user) {
  const s = typeof section !== 'undefined' ? section : '';
  const initials = String(user.name || user.username).split(/\s+/).map((w) => w[0]).join('').slice(0, 2).toUpperCase();
  // The admin runs the software rather than letting properties, so only gets the owner pages.
  // The logo button at the top goes to the dashboard (or, for the admin, the admin panel).
  const groups = user.is_admin ? [
    [['accounts', '/admin/accounts', 'Account details'], ['access', '/admin/access', 'Tab access'], ['backups', '/admin/backups', 'Backups'], ['security', '/admin/security', 'Security']],
  ] : [
    [['councils', '/app/councils', 'Councils'], ['councilrec', '/app/council-reconciliation', 'Council Reconciliation']],
    [['landlords', '/app/landlords', 'Landlords'], ['properties', '/app/properties', 'Properties'], ['tenants', '/app/tenants', 'Tenants']],
    [['maintenance', '/app/maintenance', 'Maintenance'], ['contractors', '/app/contractors', 'Contractors'], ['invoices', '/app/invoices', 'Contractors Invoices'], ['landlordinvoices', '/app/landlord-invoices', 'Landlord Invoices']],
    [['rentrun', '/app/rent-run', 'Rent run'], ['monthly', '/app/monthly', 'Landlord statements']],
  ];
%>
<div class="shell">
  <aside class="sidebar">
    <% const home = user.is_admin ? { href: '/admin', label: 'Admin panel', on: s === 'admin' } : { href: '/app', label: 'Dashboard', on: s === 'dashboard' }; %>
    <a class="rail-btn brand-btn <%= home.on ? 'active' : '' %>" href="<%= home.href %>" aria-label="<%= home.label %>" <%- home.on ? 'aria-current="page"' : '' %>><img class="logo logo-img" src="/static/galaxy-icon-192.png" alt="" width="30" height="30"><span class="rail-label"><%= home.label %></span></a>
    <nav class="rail" aria-label="Main">
      <% groups.filter(g => g.some(([key]) => !(user.hidden_tabs || []).includes(key))).forEach((g, gi) => { %>
        <% if (gi) { %><span class="rail-sep" aria-hidden="true"></span><% } %>
        <% g.filter(([key]) => !(user.hidden_tabs || []).includes(key)).forEach(([key, href, label]) => { %>
          <a class="rail-btn <%= s === key ? 'active' : '' %> <%= key === 'councilrec' || key === 'rentrun' ? 'rail-red' : '' %>" href="<%= href %>" aria-label="<%= label %>" <%- s === key ? 'aria-current="page"' : '' %>><%- include('icon', { name: key }) %><span class="rail-label"><%= label %></span></a>
        <% }) %>
      <% }) %>
    </nav>
  </aside>
  <div class="main-col">
  <header class="topbar">
    <span class="topbar-agency"><%= user.is_admin ? appName + ' admin' : user.agency_name %></span>
    <div class="topbar-actions">
      <button type="button" class="theme-toggle" role="switch" aria-checked="false" aria-label="Dark mode" title="Switch between light and dark" data-theme-toggle data-csrf="<%= csrfToken %>">
        <span class="theme-toggle-track" aria-hidden="true">
          <svg class="tt-icon tt-sun" viewBox="0 0 24 24"><circle cx="12" cy="12" r="4.2"/><path d="M12 2.5v2.2M12 19.3v2.2M2.5 12h2.2M19.3 12h2.2M5.3 5.3l1.6 1.6M17.1 17.1l1.6 1.6M5.3 18.7l1.6-1.6M17.1 6.9l1.6-1.6"/></svg>
          <svg class="tt-icon tt-moon" viewBox="0 0 24 24"><path d="M20.5 14.6A8.5 8.5 0 0 1 9.4 3.5a8.5 8.5 0 1 0 11.1 11.1z"/></svg>
          <span class="theme-toggle-thumb"></span>
        </span>
      </button>
      <a class="topbar-btn <%= s === 'account' ? 'active' : '' %>" href="/app/account" <%- s === 'account' ? 'aria-current="page"' : '' %>><span class="avatar-initials"><%= initials %></span><span class="topbar-text">My account<span class="topbar-sub"><%= user.name %></span></span></a>
      <form method="post" action="/logout" id="signout-form">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <button class="topbar-btn" type="submit"><%- include('icon', { name: 'signout' }) %><span class="topbar-text">Sign out</span></button>
      </form>
    </div>
  </header>
  <main class="content">
<% } else { %>
<main class="public">
<% } %>
