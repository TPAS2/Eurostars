<!doctype html>
<html lang="en-GB">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %> · <%= appName %></title>
  <link rel="stylesheet" href="/static/style.css">
  <script src="/static/app.js" defer></script>
</head>
<body class="<%= typeof bodyClass !== 'undefined' ? bodyClass : '' %>">
<% if (user) { const s = typeof section !== 'undefined' ? section : ''; %>
<div class="shell">
  <aside class="sidebar">
    <a class="brand" href="/app"><span class="logo">L</span><%= appName %></a>
    <div class="agency"><%= user.agency_name %></div>
    <nav>
      <a href="/app" class="<%= s === 'dashboard' ? 'active' : '' %>">Dashboard</a>
      <div class="nav-label">Portfolio</div>
      <a href="/app/landlords" class="<%= s === 'landlords' ? 'active' : '' %>">Landlords</a>
      <a href="/app/properties" class="<%= s === 'properties' ? 'active' : '' %>">Properties</a>
      <a href="/app/tenants" class="<%= s === 'tenants' ? 'active' : '' %>">Tenants</a>
      <a href="/app/tenancies" class="<%= s === 'tenancies' ? 'active' : '' %>">Tenancies</a>
      <div class="nav-label">Management</div>
      <a href="/app/maintenance" class="<%= s === 'maintenance' ? 'active' : '' %>">Maintenance</a>
      <a href="/app/invoices" class="<%= s === 'invoices' ? 'active' : '' %>">Invoices</a>
      <a href="/app/compliance" class="<%= s === 'compliance' ? 'active' : '' %>">Compliance</a>
      <div class="nav-label">Accounts</div>
      <a href="/app/transactions" class="<%= s === 'transactions' ? 'active' : '' %>">Transactions</a>
      <a href="/app/monthly" class="<%= s === 'monthly' ? 'active' : '' %>">Monthly statements</a>
      <a href="/app/statements" class="<%= s === 'statements' ? 'active' : '' %>">Statement by date range</a>
      <% if (user.is_admin) { %>
      <div class="nav-label">Owner</div>
      <a href="/admin" class="<%= s === 'admin' ? 'active' : '' %>">Admin panel</a>
      <a href="/admin/backups" class="<%= s === 'backups' ? 'active' : '' %>">Backups</a>
      <% } %>
    </nav>
    <div class="me">
      <div><strong><%= user.name %></strong></div>
      <div class="muted small"><%= user.email %></div>
      <a class="small export-link" href="/app/export">Download my data</a>
      <form method="post" action="/logout">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <button class="link-btn" type="submit">Sign out</button>
      </form>
    </div>
  </aside>
  <main class="content">
<% } else { %>
<main class="public">
<% } %>
