<%# locals: def, rows, maps, display, rowTitle, hideField, endTenancy (show an End tenancy button on tenancy rows) %>
<% const withEnd = typeof endTenancy !== 'undefined' && endTenancy; const withEdit = typeof editRows !== 'undefined' && editRows; %>
<%# Tenants list: an End button for each tenant's current tenancy. %>
<% const withTenantEnd = def.key === 'tenants' && rows.some((r) => r.end_tenancy_id); %>
<%# The record's name (its title column, or else the first column) is the link to it. %>
<% const shown = def.columns.filter(c => c !== hideField); const linkCol = shown.includes(def.titleField) ? def.titleField : shown[0]; %>
<div class="table-wrap">
<table class="list-<%= def.key %>">
  <thead><tr>
  <% def.columns.filter(c => c !== hideField).forEach(c => { const f = def.fieldMap[c]; %>
    <th class="<%= ['money','number','integer'].includes(f.type) || f.num ? 'num' : '' %>"><%= f.label.replace(/ \(£[^)]*\)/, '') %></th>
  <% }) %>
  <% if (withEnd || withEdit || withTenantEnd) { %><th></th><% } %>
  </tr></thead>
  <tbody>
  <% rows.forEach(row => { %>
    <tr>
    <% shown.forEach((c, i) => { const d = display(def, c, row, maps); %>
      <td class="<%= d.num ? 'num' : '' %>">
        <% if (c === linkCol) { %><a href="/app/<%= def.key %>/<%= row.id %>"<%= row.photo_v ? ' class=with-thumb' : '' %>><% if (row.photo_v) { %><img class="thumb" src="/app/<%= def.key %>/<%= row.id %>/photo?v=<%= row.photo_v %>" alt=""><% } %><%= d.text || rowTitle(def, row, maps) %></a>
        <% } else if (d.href) { %><a href="<%= d.href %>"<% if (d.cls) { %> class="<%= d.cls %>"<% } %>><%= d.text %></a>
        <% } else if (d.cls) { %><span class="<%= d.cls %>"><%= d.text %></span>
        <% } else if (d.badge) { %><span class="badge s-<%= String(row[c]).replace(/\W+/g, '-') %>"><%= d.text %></span>
        <% } else if (String(d.text).includes('\n')) { %><span class="cell-text"><%= d.text %></span>
        <% } else { %><%= d.text %><% } %>
      </td>
    <% }) %>
    <% if (withTenantEnd) { %><td class="end-cell"><% if (row.end_tenancy_id) { %>
      <form method="post" action="/app/tenancies/<%= row.end_tenancy_id %>/end" class="inline" data-confirm="End <%= row.name %>’s tenancy today (<%= fmt.ukDate(today) %>)? It will be marked ended and move to Past.">
        <%- include('csrf') %><input type="hidden" name="back" value="tenants">
        <button class="btn small danger" type="submit">End</button>
      </form>
    <% } %></td><% } %>
    <% if (withEdit && !withEnd) { %><td class="num"><a class="btn small" href="/app/<%= def.key %>/<%= row.id %>/edit">Edit</a></td><% } %>
    <% if (withEnd) { %>
      <td class="end-cell"><% if (row.status !== 'ended') { %>
        <form method="post" action="/app/tenancies/<%= row.id %>/end" class="end-tenancy" data-confirm="End this tenancy? Its end date will be set and its status changed to ended.">
          <%- include('csrf') %>
          <input type="date" name="end_date" value="<%= row.end_date && row.end_date < today ? row.end_date : today %>" aria-label="End date">
          <button class="btn small danger" type="submit">End tenancy</button>
        </form>
      <% } %></td>
    <% } %>
    </tr>
  <% }) %>
  <% if (typeof totalsRow !== 'undefined' && totalsRow) { %>
    <tr class="total">
    <% def.columns.filter(c => c !== hideField).forEach((c, i) => { %><td><%= i === 0 ? totalsRow.label : (totalsRow.cells[c] || '') %></td><% }) %>
    </tr>
  <% } %>
  </tbody>
</table>
</div>
