<%- include('../partials/header') %>
<% const pounds = (p) => (p / 100).toLocaleString('en-GB', { minimumFractionDigits: 2, maximumFractionDigits: 2 }); %>
<header class="page-head">
  <div>
    <a class="crumb" href="/app/rent-run?month=<%= month %>#transfer-sheet">← Rent run</a>
    <h1>Bank transfer sheet</h1>
    <p class="muted">Made from the Rift report for <%= file.monthLabel %>: every landlord paid by bank, a row per property where their money splits by property, and "No payment" for anyone with nothing to pay this month.</p>
  </div>
  <div class="actions">
    <a class="btn primary" href="/app/rent-run/transfer.xlsx?month=<%= month %>">Download Excel</a>
  </div>
</header>
<% if (file.problems.length) { %>
<div class="notice warn">
  <strong>Missing or wrong bank details:</strong>
  <ul class="tight"><% file.problems.forEach(p => { %><li><a href="/app/landlords/<%= p.landlord_id %>/edit"><%= p.name %></a>: <%= p.issues.join(', ') %></li><% }) %></ul>
</div>
<% } %>

<section class="card">
  <div class="card-head"><span class="muted small"><%= filename %></span></div>
  <div class="table-wrap">
    <table class="transfer-sheet">
      <thead>
        <tr class="title"><td></td><td colspan="3"><%= heading %></td><td colspan="4"></td></tr>
        <tr class="gap"><td colspan="8"></td></tr>
        <tr class="head"><th>Landlord</th><th>LCODE</th><th>Property Address / Reference</th><th>Sort Code</th><th>Account Number</th><th>Bank Name</th><th>Amount</th><th class="note-col"></th></tr>
      </thead>
      <tbody>
      <% file.rows.forEach(r => { %>
        <tr>
          <td><%= r.landlordName %></td><td><%= r.code %></td><td><%= r.reference %></td>
          <td class="c"><%= r.sortCode %></td><td class="c"><%= r.account %></td><td class="c"><%= r.bankName %></td>
          <% if (r.pence) { %><td class="money"><span>£</span><%= pounds(r.pence) %></td><% } else { %><td class="c">No payment</td><% } %>
          <td class="note-col"><% if (r.note) { %><span class="yellow-note"><%= r.note %></span><% } %></td>
        </tr>
      <% }) %>
      <% if (!file.rows.length) { %><tr><td colspan="7" class="muted">No landlords paid by bank have a statement for <%= file.monthLabel %>. Calculate the rents on the Rent run first.</td><td></td></tr><% } %>
        <tr class="total"><td colspan="5" class="blank"></td><td class="c strong">Total</td><td class="money strong"><span>£</span><%= pounds(file.total) %></td><td class="note-col"></td></tr>
      </tbody>
    </table>
  </div>
  <p class="muted small"><%= file.rows.filter(r => r.pence).length %> payment<%= file.rows.filter(r => r.pence).length === 1 ? '' : 's' %>, total <%= fmt.money(file.total) %>. Bank name and the yellow note come from each landlord's page (Bank name, Bank transfer note).<% if (file.cheques.length) { %> Paid by cheque, so not listed: <%= file.cheques.map(c => c.name).join(', ') %>.<% } %></p>
</section>
<%- include('../partials/footer') %>
