<%- include('../partials/header') %>
<header class="page-head">
  <div>
    <a class="crumb" href="/app/rent-run?month=<%= report.month %>">← Rent run</a>
    <h1><%= report.label %></h1>
    <p class="muted">Preview of the Excel workbook: every property whose landlord is paid for <%= report.monthLabel %> (dated the day the rents were calculated), with the total.</p>
  </div>
  <div class="actions">
    <form method="get" data-autogo class="inline-form">
      <input type="hidden" name="step" value="<%= step %>">
      <input type="month" name="month" value="<%= report.month %>" aria-label="Month">
      <noscript><button class="btn" type="submit">Show</button></noscript>
    </form>
  </div>
</header>
<% if (flash) { %><div class="notice ok"><%= flash %></div><% } %>
<% if (error) { %><div class="notice err"><%= error %></div><% } %>
<% if (missing) { %>
<div class="notice warn"><%= missing %> landlord<%= missing === 1 ? ' has' : 's have' %> no statement for <%= report.monthLabel %> yet. Use <a href="/app/rent-run?month=<%= report.month %>">Calculate all rents</a> on the Rent run to include them.</div>
<% } %>

<section class="card report-actions">
  <% if (step === 4) { %>
  <form method="post" action="/app/monthly/report/email" class="step-email" data-busy="Sending…">
    <%- include('../partials/csrf') %>
    <input type="hidden" name="month" value="<%= report.month %>">
    <input type="hidden" name="back" value="report">
    <label for="report-to" class="strong">Email this report to</label>
    <input id="report-to" type="email" name="to" value="<%= reportTo %>" placeholder="name@example.com" required>
    <button class="btn primary" type="submit" <%= emailEnabled && report.rows.length ? '' : 'disabled' %>>Email report</button>
  </form>
  <% if (!emailEnabled) { %><p class="muted small">Email isn't set up yet, so the report can only be downloaded for now.</p><% } %>
  <% } else { %>
  <div class="step-actions">
    <a class="btn primary <%= report.rows.length ? '' : 'disabled' %>" href="/app/monthly/report.xlsx?month=<%= report.month %>" <%- report.rows.length ? '' : 'aria-disabled="true" tabindex="-1"' %>>Download Excel</a>
    <span class="muted small"><%= report.filename %></span>
  </div>
  <% } %>
</section>

<section class="card">
  <% if (!report.rows.length) { %>
    <p class="muted">Nothing to report for <%= report.monthLabel %> yet. Go back and click <strong>Calculate all rents</strong> first.</p>
  <% } else { %>
  <div class="sheet-preview">
    <p class="sheet-title"><%= report.title %></p>
    <div class="table-wrap"><table class="cfp">
      <thead><tr><th>Date</th><th>Name</th><th class="num">Debit</th><th>LCODE</th></tr></thead>
      <tbody>
      <% report.rows.forEach(r => { %>
        <tr><td><%= fmt.ukDate(r.date) %></td><td><a href="/app/monthly/<%= r.statement_id %>"><%= r.name %></a></td><td class="num"><%= fmt.money(r.debit) %></td><td><%= r.code || '' %></td></tr>
      <% }) %>
      </tbody>
      <tfoot><tr class="total"><td></td><td><%= report.rows.length %> propert<%= report.rows.length === 1 ? 'y' : 'ies' %> · <%= report.landlords %> landlord<%= report.landlords === 1 ? '' : 's' %></td><td class="num"><%= fmt.money(report.total) %></td><td></td></tr></tfoot>
    </table></div>
  </div>
  <% } %>
</section>
<%- include('../partials/footer') %>
