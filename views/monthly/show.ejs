<%- include('../partials/header') %>
<header class="page-head no-print">
  <div>
    <a class="crumb" href="/app/monthly?month=<%= s.month %>">← Landlord statements</a>
    <h1><%= s.landlord_name %></h1>
    <p class="muted"><%= monthLabel %></p>
  </div>
  <div class="actions">
    <button class="btn" type="button" data-print>Print</button>
    <a class="btn icon-btn" href="/app/monthly/<%= s.id %>/statement.pdf?view=1" target="_blank" rel="noopener" title="Preview statement (PDF)" aria-label="Preview statement (PDF)"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7S2 12 2 12z"/><circle cx="12" cy="12" r="3"/></svg></a> <a class="btn icon-btn" href="/app/monthly/<%= s.id %>/statement.pdf" download title="Download statement (PDF)" aria-label="Download statement (PDF)"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 4v11"/><path d="M7 10l5 5 5-5"/><path d="M5 20h14"/></svg></a>
    <form method="post" action="/app/monthly/generate" data-busy="Regenerating…">
      <%- include('../partials/csrf') %>
      <input type="hidden" name="month" value="<%= s.month %>">
      <input type="hidden" name="landlord_id" value="<%= s.landlord_id %>">
      <button class="btn" type="submit">Regenerate</button>
    </form>
    <form method="post" action="/app/monthly/<%= s.id %>/delete" data-confirm="Delete statement <%= s.statement_no %>? This can’t be undone.">
      <%- include('../partials/csrf') %>
      <button class="btn danger" type="submit">Delete</button>
    </form>
    <% if (s.closing_pence > 0) { %>
      <a class="btn primary" href="/app/transactions/new?txn_type=landlord_payment&landlord_id=<%= s.landlord_id %>&amount_pence=<%= fmt.penceToInput(s.closing_pence) %>&description=<%= encodeURIComponent('Payment for ' + monthLabel + ' statement') %>">Pay landlord <%= fmt.money(s.closing_pence) %></a>
    <% } %>
  </div>
</header>

<section class="card statement-paper">
  <header class="sp-band">
    <div class="sp-agency"><%= doc.company.name %></div>
    <% if (doc.company.address) { %><div class="sp-sub"><%= doc.company.address %></div><% } %>
    <% if (doc.company.contact) { %><div class="sp-sub"><%= doc.company.contact %></div><% } %>
  </header>
  <div class="sp-body">
    <div class="sp-top">
      <div class="sp-to"><% doc.to.forEach(l => { %><div><%= l %></div><% }) %></div>
      <dl class="sp-details"><% doc.details.forEach(([k, v]) => { %><dt><%= k %></dt><dd><%= v %></dd><% }) %></dl>
    </div>
    <h2 class="sp-title">STATEMENT OF ACCOUNT AND PAYMENT ADVICE<br>AS AT <%= doc.date %><br>For Account: Default Client Cash Account</h2>
    <table class="sp-table">
      <thead><tr><th></th><th>Net<br>£</th><th>Vat<br>£</th><th>Gross<br>£</th></tr></thead>
      <tbody>
      <% doc.blocks.forEach(b => { %>
        <tr><td colspan="4" class="sp-re">Re: <%= b.re %></td></tr>
        <% [['INCOME', b.income], ['EXPENDITURE', b.expenditure]].forEach(([h, rows]) => { if (!rows.length) return; %>
          <tr><td colspan="4" class="sp-head"><%= h %></td></tr>
          <% rows.forEach(r => { %>
            <tr><td class="sp-item"><strong><%= r.title %></strong><% if (r.sub) { %><div><%= r.sub %></div><% } %></td>
              <td class="num"><%= amount(r.net) %></td><td class="num">0.00</td><td class="num"><%= amount(r.net) %></td></tr>
          <% }) %>
        <% }) %>
      <% }) %>
      <% if (!doc.blocks.length) { %><tr><td colspan="4" class="muted">Nothing in or out this month.</td></tr><% } %>
        <tr class="sp-total"><td>TOTAL INCOME</td><td class="num"><%= amount(doc.income) %></td><td class="num">0.00</td><td class="num"><strong><%= amount(doc.income) %></strong></td></tr>
        <% if (doc.spent) { %><tr class="sp-total2"><td>TOTAL EXPENDITURE</td><td class="num"><%= amount(doc.spent) %></td><td class="num">0.00</td><td class="num"><strong><%= amount(doc.spent) %></strong></td></tr><% } %>
        <tr class="sp-due"><td>NET AMOUNT DUE</td><td></td><td></td><td class="num"><span><%= amount(doc.due) %></span></td></tr>
      </tbody>
    </table>
    <p class="sp-closing"><%= doc.closing %></p>
  </div>
</section>

<section class="card no-print">
  <div class="ai-summary">
    <div class="ai-label"><%= s.summary_source === 'ai' ? '✨ Summary' : 'Summary' %></div>
    <p class="pre"><%= s.summary %></p>
    <% if (s.note) { %><p class="muted small"><%= s.note %></p><% } %>
  </div>
  <h3>Transactions</h3>
  <div class="table-wrap"><table>
    <thead><tr><th>Date</th><th>Property</th><th>Description</th><th class="num">In</th><th class="num">Out</th><th class="num">Balance</th></tr></thead>
    <tbody>
      <tr class="sub"><td colspan="5">Balance held at start of month</td><td class="num"><%= fmt.money(s.opening_pence) %></td></tr>
      <% detail.lines.forEach(l => { %>
      <tr>
        <td><%= fmt.ukDate(l.date) %></td><td><%= l.property %></td><td><%= l.description %></td>
        <td class="num"><%= l.direction === 'in' ? fmt.money(l.amount) : '' %></td>
        <td class="num"><%= l.direction === 'out' ? fmt.money(l.amount) : '' %></td>
        <td class="num"><%= fmt.money(l.balance) %></td>
      </tr>
      <% }) %>
      <% if (!detail.lines.length) { %><tr><td colspan="6" class="muted">No transactions this month.</td></tr><% } %>
      <tr class="total"><td colspan="5">Balance held at end of month<% if (s.payments_pence) { %> (after <%= fmt.money(s.payments_pence) %> paid to you)<% } %></td><td class="num"><%= fmt.money(s.closing_pence) %></td></tr>
    </tbody>
  </table></div>
</section>
<%- include('../partials/footer') %>
