{
  "name": "rift",
  "version": "1.0.0",
  "description": "Lettings, property management and client accounting software for letting agents, with an owner-only admin panel.",
  "private": true,
  "main": "src/server.js",
  "type": "commonjs",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning src/server.js",
    "dev": "node --watch src/server.js",
    "create-admin": "node scripts/create-admin.js",
    "test": "node --test --disable-warning=ExperimentalWarning test/*.test.js",
    "restore-backup": "node --disable-warning=ExperimentalWarning scripts/restore-backup.js",
    "backup": "node --disable-warning=ExperimentalWarning scripts/backup-now.js",
    "build:client": "esbuild client/dashboard.jsx client/segments.jsx --bundle --minify --format=iife --jsx=automatic --define:process.env.NODE_ENV=\\\"production\\\" --outdir=public --legal-comments=none",
    "notices": "node scripts/third-party-notices.js",
    "google-drive-auth": "node scripts/google-drive-auth.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "ejs": "^3.1.10",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "multer": "^2.4.0",
    "nodemailer": "^10.0.13",
    "pdf-lib": "^1.17.1",
    "qrcode": "^1.5.4"
  },
  "overrides": {
    "uuid": "^11.1.1"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "motion": "^13.4.6",
    "ogl": "^1.0.11",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "license": "UNLICENSED"
}
