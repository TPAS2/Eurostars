{
  "name": "letwise",
  "version": "1.0.0",
  "description": "Lettings, property management and client accounting software for letting agents, with an owner-only admin panel.",
  "private": true,
  "main": "src/server.js",
  "type": "commonjs",
  "engines": {
    "node": ">=22.13"
  },
